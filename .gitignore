node_modules/
dist/
.env*
# Templates are the one exception: a fresh clone must be able to see which
# variables exist without inheriting any real value.
!.env.example
.DS_Store
database_export.sql
*.sql
# Exception : les MODES OPÉRATOIRES de migration relus à la main. Ce ne sont
# pas des dumps — aucune donnée d'élève, uniquement du DDL généré par
# `php artisan migrate --pretend`. Le pipeline n'applique jamais les
# migrations (deploy.yml § « Laravel post-deployment »), donc ces fichiers SONT
# la procédure de déploiement du schéma : DZ_FIRST_DEPLOYMENT.md les cite un
# par un, et une copie locale ne servirait à personne d'autre.
!docs/deployment/*.sql

# Generated curriculum export (build artifact of exportCurriculum.mjs)
packages/core/curriculum/.generated/

# ── Outils d'agent (config locale, pas du code du projet) ────────────────
.claude/
.agents/
skills-lock.json

# ── Sorties de tests et de build ─────────────────────────────────────────
coverage/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# Archives de déploiement assemblées à la main à la racine des apps.
# Même nature que build/deploy : reconstruites à la demande, jamais versionnées.
apps/api.zip
apps/web/dist.zip

# ── Brouillons de session ────────────────────────────────────────────────
# Sondes Playwright jetables écrites à la racine pendant une mise au point
# (capture d'écran, vérification d'un parcours), et pages web enregistrées
# servant de référence visuelle : utiles sur le moment, jamais du dépôt.
_probe*.mjs
_shot*.mjs
_*.html
_*_files/
*.log
scripts/__pycache__/
apps/api/database/curriculum-sync/

# PDFs are never versioned (official books, exercise sheets, etc.)
*.pdf
*.PDF
