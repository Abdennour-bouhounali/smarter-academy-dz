{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarter-academy.com/schemas/thinking-lab/challenge.schema.json",
  "title": "Thinking-lab challenge",
  "description": "One challenge of « سُلَّم التحدّيات » (path 1 of « مختبر التفكير »). Contract: docs/architecture/THINKING_LAB.md §3. Checked by scripts/validate-thinking-lab.mjs, which also checks what a schema cannot express: the answer is readable by checkAnswer, each declared mistake is refused, nothing shown before the gate leaks the answer, the band matches the number, forbidden words.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "title", "status", "family", "band", "summit", "licence", "source", "examTag", "rating", "statement", "figure", "params", "answer", "parts", "mistakes", "keys", "example", "replay", "keyMoves", "move", "twin", "ceiling"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "description": "Stable slug: never changes, even when the edition renumbers the ladder.", "$ref": "#/$defs/slug" },
    "number": { "description": "Position in the current edition (« التحدّي 318 »). The file name starts with it on 4 digits.", "type": "integer", "minimum": 1, "maximum": 9999 },
    "title": { "description": "Arabic title, for authors and teachers. Students see the number.", "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "family": { "type": "string", "enum": ["logic", "numbers", "patterns", "algebra", "geometry", "counting", "probability", "functions", "analysis", "invariants", "critical"] },
    "band": { "description": "HIDDEN from students. Must match the number (validator).", "type": "string", "enum": ["primary", "middle", "secondary", "university"] },
    "summit": { "description": "true exactly for multiples of 25.", "type": "boolean" },
    "licence": { "description": "PD | FOLK | TYPE (challenge bank §1).", "type": "string", "enum": ["PD", "FOLK", "TYPE"] },
    "source": { "description": "What inspired it. Never a copied statement.", "type": "string", "minLength": 3 },
    "examTag": { "type": ["string", "null"], "enum": ["bem", "bac", null] },
    "rating": { "description": "Initial author estimate (Elo scale). Then maintained server-side.", "type": "integer", "minimum": 400, "maximum": 3000 },
    "statement": { "description": "Arabic text. {name} placeholders are filled from params.", "type": "string", "minLength": 10 },
    "figure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "component", "props"],
      "properties": {
        "kind": { "type": "string", "enum": ["svg"] },
        "component": { "description": "An SVG component of apps/web/src/features/thinkingLab/figures/ (phase 1). Drawn in code, never a raster image.", "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "props": { "type": "object" }
      }
    },
    "whiteboard": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["seed", "observe"],
      "properties": {
        "seed": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "observe": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "through"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "kind": { "type": "string", "enum": ["segment", "triangle", "angle"] },
              "through": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
              "toleranceDeg": { "type": "number", "minimum": 0 },
              "tolerance": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "params": {
      "description": "Per-student numbers: one tuple per student, chosen by fnv1a32(userId:challengeId:edition).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["vars"],
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": ["number", "string"] } }
        }
      }
    },
    "answer": { "$ref": "#/$defs/answer" },
    "parts": {
      "description": "Summits: follow-up questions, shown once the main answer is solved or the gate is open (the main `answer` alone drives the gate).",
      "type": ["array", "null"],
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "answer"],
        "properties": { "prompt": { "type": "string", "minLength": 3 }, "answer": { "$ref": "#/$defs/answer" } }
      }
    },
    "mistakes": {
      "description": "Frequent wrong answers and the « ليس بعد » reply. `value` is matched by equivalence (× scaleWith); with `outside`, any answer whose value at `at` is ≤ lo or ≥ hi matches, and `value` is an example of it.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "reply"],
        "properties": {
          "value": { "type": ["string", "number"] },
          "scaleWith": { "type": "string" },
          "outside": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "at": { "type": "object", "additionalProperties": { "type": "number" } },
          "reply": { "type": "string", "minLength": 3 }
        }
      }
    },
    "keys": {
      "description": "Key k opens after counted attempt k. Each one is a question, never a calculation that gives the answer.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "text"],
        "properties": { "phase": { "$ref": "#/$defs/phase" }, "text": { "type": "string", "minLength": 3 } }
      }
    },
    "example": {
      "description": "Primary band (example-first): a worked example shown BEFORE trying. Required for the primary band, null otherwise.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["statement", "steps", "answer"],
      "properties": {
        "statement": { "type": "string", "minLength": 3 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "answer": { "type": "string" }
      }
    },
    "replay": {
      "description": "The replay of the thinking, shown after the gate opens.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "think"],
        "properties": {
          "phase": { "$ref": "#/$defs/phase" },
          "think": { "type": "string", "minLength": 3 },
          "layers": { "type": "array", "items": { "type": "string" } },
          "math": { "type": "array", "items": { "type": "string" } },
          "ask": {
            "description": "« اشرح لنفسك »: the replay waits for an answer.",
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "options", "correct", "why"],
            "properties": {
              "q": { "type": "string", "minLength": 3 },
              "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
              "correct": { "type": "integer", "minimum": 0 },
              "why": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "keyMoves": { "description": "The short replay for students who solved alone.", "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 3 } },
    "move": {
      "description": "The thinking move collected as a card (« أدوات الرياضي »).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "type": "string", "minLength": 3 } }
    },
    "twin": { "description": "id of the twin challenge (same idea, other context).", "type": ["string", "null"], "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "ceiling": {
      "description": "« ارفع السقف »: a harder question on the same idea.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["statement", "answer"],
      "properties": { "statement": { "type": "string", "minLength": 10 }, "answer": { "$ref": "#/$defs/answer" } }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "phase": { "description": "SMART phases + O (👁 observation) + B (↩ dead end).", "type": "string", "enum": ["S", "M", "A", "R", "T", "O", "B"] },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "value"],
      "properties": {
        "check": { "type": "string", "enum": ["integer", "number", "rational", "expression", "choice"] },
        "value": { "type": ["string", "number"] },
        "vars": { "description": "expression: one letter each, never « e ».", "type": "array", "items": { "type": "string", "pattern": "^[a-df-zA-Z]$" } },
        "samples": { "type": "integer", "minimum": 1, "maximum": 50 },
        "relTol": { "type": "number", "minimum": 0 },
        "absTol": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 1 },
        "domain": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "exclude": { "type": "array", "items": { "type": "number" } }
            }
          }
        },
        "tolerance": { "description": "rational: exact tolerance written as a rational.", "type": "string" },
        "percent": { "description": "number: the answer is a percentage — « −4 % » is read −4, not −0.04.", "type": "boolean" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": { "id": { "type": "string", "pattern": "^[A-Z]$" }, "text": { "type": "string" } }
          }
        }
      }
    }
  }
}
