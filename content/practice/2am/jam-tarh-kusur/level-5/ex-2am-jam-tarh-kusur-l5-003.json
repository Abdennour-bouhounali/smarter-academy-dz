      "solution": {
        "lines": [
          "$\\dfrac{3}{10} = \\dfrac{3 \\times 2}{10 \\times 2} = \\dfrac{6}{20}$ .",
          "$\\dfrac{1}{5} = \\dfrac{1 \\times 4}{5 \\times 4} = \\dfrac{4}{20}$ .",
          "$\\dfrac{6}{20} + \\dfrac{3}{10} + \\dfrac{1}{5} = \\dfrac{6 + 6 + 4}{20} = \\dfrac{16}{20}$ .",
          "نختزل بالقسمة على $4$ : $\\dfrac{16}{20} = \\dfrac{4}{5}$ ."
        ],
        "result": "\\dfrac{4}{5}"
      },
