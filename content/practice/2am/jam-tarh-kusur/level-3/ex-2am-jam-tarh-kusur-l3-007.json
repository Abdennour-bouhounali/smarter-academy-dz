      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "احسب مجموع الخانتين $\\dfrac{1}{3}$ و $\\dfrac{1}{6}$ ، أي $\\dfrac{1}{3} + \\dfrac{1}{6}$ .",
      "learningPoints": [
        {
          "code": "2am_jam-tarh-kusur_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال (أو عدد طبيعي)",
      "expectedAnswer": "1/2",
