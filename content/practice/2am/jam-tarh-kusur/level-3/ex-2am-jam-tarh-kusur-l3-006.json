  "statement": {
    "content": "في هرم الكسور كلّ خانة تساوي مجموع الخانتين المتواجدتين تحتها . خانات القاعدة :",
    "table": {
      "head": [
        "$\\dfrac{1}{2}$",
        "$\\dfrac{1}{4}$",
        "$\\dfrac{1}{8}$",
        "$\\dfrac{1}{16}$"
      ],
      "rows": []
    }
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "احسب مجموع الخانتين $\\dfrac{1}{2}$ و $\\dfrac{1}{4}$ ، أي $\\dfrac{1}{2} + \\dfrac{1}{4}$ .",
      "learningPoints": [
        {
          "code": "2am_jam-tarh-kusur_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال (أو عدد طبيعي)",
      "expectedAnswer": "3/4",
      "evaluationPolicy": {
        "requiredForm": "irreducible"
      },
      "misconceptionSignatures": [
        {
          "value": "1/3",
          "id": "MISC-JAMKASR-ACROSS"
        },
        {
          "value": "1/2",
          "id": "MISC-JAMKASR-NOSCALE"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما العمليّة المطلوبة؟ وهل المقامان متساويان، أم أنّ أحدهما مضاعف للآخر؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "إذا اختلف المقامان فاكتب الكسر ذا المقام الأصغر بالمقام الأكبر: اضرب حدّيه في العدد نفسه."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع (أو اطرح) البسطين وأبقِ المقام كما هو، ثمّ اختزل الناتج إن أمكن."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{3}{4}$ .",
        "incorrect": "اكتب الكسرين بمقام واحد قبل الجمع أو الطرح، ثمّ اختزل الناتج وأعد المحاولة."
      },
      "solution": {
        "lines": [
          "$\\dfrac{1}{2} = \\dfrac{1 \\times 2}{2 \\times 2} = \\dfrac{2}{4}$ .",
          "$\\dfrac{1}{2} + \\dfrac{1}{4} = \\dfrac{2 + 1}{4} = \\dfrac{3}{4}$ ."
        ],
        "result": "\\dfrac{3}{4}"
      },
      "work": "optional",
      "timeSeconds": 90
    },
