      },
      "solution": {
        "lines": [
          "$1 = \\dfrac{10}{10}$ .",
          "$\\dfrac{2}{5} = \\dfrac{2 \\times 2}{5 \\times 2} = \\dfrac{4}{10}$ .",
          "ما أُخذ : $\\dfrac{2}{5} + \\dfrac{3}{10} = \\dfrac{4 + 3}{10} = \\dfrac{7}{10}$ .",
          "الباقي : $1 - \\dfrac{7}{10} = \\dfrac{10}{10} - \\dfrac{7}{10} = \\dfrac{3}{10}$ ."
        ],
        "result": "\\dfrac{3}{10}"
      },
