      "solution": {
        "lines": [
          "$1 = \\dfrac{6}{6}$ .",
          "$\\dfrac{1}{3} = \\dfrac{1 \\times 2}{3 \\times 2} = \\dfrac{2}{6}$ .",
          "$1 - \\dfrac{1}{3} - \\dfrac{1}{6} = \\dfrac{6 - 2 - 1}{6} = \\dfrac{3}{6}$ .",
          "نختزل بالقسمة على $3$ : $\\dfrac{3}{6} = \\dfrac{1}{2}$ ."
        ],
        "result": "\\dfrac{1}{2}"
