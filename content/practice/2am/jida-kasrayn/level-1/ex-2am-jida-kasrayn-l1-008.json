      "id": "q1",
      "step": "01",
      "statement": "العدد $\\dfrac{5}{9} \\times \\dfrac{2}{7}$ يساوي :",
      "learningPoints": [
        {
          "code": "2am_jida-kasrayn_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "multiChoice",
      "choices": [
        {
          "id": "A",
          "content": "$\\dfrac{2 \\times 5}{9 \\times 7}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$\\dfrac{35}{18}$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAKASR-CROSS"
        },
        {
          "id": "C",
