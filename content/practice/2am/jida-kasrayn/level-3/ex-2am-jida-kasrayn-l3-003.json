  "statement": {
    "content": "إناء على شكل موشور قائم قاعدته مستطيل عرضها $8$ cm وطولها $x$ cm ، وارتفاعه $6$ cm ، وحجمه $480$ $\\mathrm{cm}^3$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "أوجد قيمة $x$ بالسنتيمتر .",
      "learningPoints": [
        {
          "code": "2am_jida-kasrayn_P3",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "10",
      "evaluationPolicy": {
        "requiredForm": "irreducible"
      },
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اقرأ المعطيات ثمّ حدّد العملية المناسبة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب خطوة بخطوة وراجع الوحدة في الناتج."
        }
      ],
      "feedback": {
        "correct": "$10$ .",
        "incorrect": "راجع المعطيات والعمليّة ثمّ أعد الحساب."
      },
      "solution": {
        "lines": [
          "الحجم $= 8 \\times x \\times 6 = 48 \\times x$ ، و $48 \\times x = 480$ إذن $x = 480 \\div 48 = 10$ cm ."
        ],
        "result": "10"
      },
      "work": "optional",
