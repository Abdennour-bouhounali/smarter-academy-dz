      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "قارن بين $\\dfrac{9}{14}$ و $\\dfrac{27}{28}$ :",
      "learningPoints": [
        {
          "code": "2am_muqarana-kasrayn_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\dfrac{9}{14} > \\dfrac{27}{28}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUQKASR-REVERSED"
        },
        {
          "id": "B",
          "content": "$\\dfrac{9}{14} < \\dfrac{27}{28}$",
          "isCorrect": true
        }
      ],
      "answerFormat": "اختر الإجابة الصحيحة",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "قارن بين المقامين : هل أحدهما مضاعف للآخر ؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب الكسرين بالمقام الأكبر ثمّ قارن بين البسطين ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اضرب بسط الكسر الأصغر مقامًا ومقامه في العدد نفسه حتّى يصير مقامه مساويًا للمقام الآخر ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{9}{14} < \\dfrac{27}{28}$ .",
        "incorrect": "اختر طريقة المقارنة المناسبة للحالة ثمّ أعد المحاولة ."
      },
      "solution": {
        "lines": [
          "$28$ مضاعف للعدد $14$ : $28 = 14 \\times 2$ .",
          "$\\dfrac{9}{14} = \\dfrac{9 \\times 2}{14 \\times 2} = \\dfrac{18}{28}$ .",
          "نقارن بين البسطين : $18 < 27$ ، إذن $\\dfrac{9}{14} < \\dfrac{27}{28}$ ."
        ]
      },
      "timeSeconds": 60
    },
