      "answerFormat": "اختر الإجابة الصحيحة",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "قارن كلّ خيار بالكسر المعطى على حدة ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "لكلّ خيار حالته : مقام متساوٍ ، بسط متساوٍ ، مقام مضاعف ، أو كسران على جانبي $1$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{3}{32}$ .",
        "incorrect": "قارن بدقّة كلّ خيار مع الكسر المعطى ثمّ أعد المحاولة ."
      },
      "solution": {
        "lines": [
          "$32$ مضاعف للعدد $16$ : $32 = 16 \\times 2$ .",
          "$\\dfrac{7}{16} = \\dfrac{7 \\times 2}{16 \\times 2} = \\dfrac{14}{32}$ .",
          "نقارن بين البسطين : $3 < 14$ ، إذن $\\dfrac{3}{32} < \\dfrac{7}{16}$ .",
          "أمّا بقيّة الخيارات فهي ليست أصغر من $\\dfrac{7}{16}$ ."
        ]
      },
