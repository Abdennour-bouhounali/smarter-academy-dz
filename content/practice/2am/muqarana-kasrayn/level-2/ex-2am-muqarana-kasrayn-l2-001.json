      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال (أو عدد طبيعي)",
      "expectedAnswer": "5/6",
      "evaluationPolicy": {
        "requiredForm": "irreducible"
      },
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما المطلوب بالضبط ؟ وما الكسور المعطاة ؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب الكسور بمقام واحد قبل الجمع أو الطرح ثمّ اختزل ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{5}{6}$ .",
        "incorrect": "راجع الحساب خطوة خطوة ثمّ أعد المحاولة ."
      },
      "solution": {
        "lines": [
          "$36 = 9 \\times 4$ ، إذن $\\dfrac{4}{9} = \\dfrac{16}{36}$ .",
          "$A = \\dfrac{16}{36} + \\dfrac{14}{36} = \\dfrac{30}{36} = \\dfrac{5}{6}$ ."
        ],
        "result": "\\dfrac{5}{6}"
      },
