      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض الحرف بالقيمة المعطاة في الطرف الأوّل ثمّ في الطرف الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب كلّ طرف على حدة، مع إنجاز الضرب قبل الجمع والطرح."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "قارن الناتجين : إذا تساويا فالمساواة صحيحة، وإلاّ فهي خاطئة."
        }
      ],
      "feedback": {
        "correct": "نعم : المساواة صحيحة .",
        "incorrect": "عوّض الحرف في الطرفين، احسب كلّ طرف ثمّ قارن الناتجين."
      },
      "solution": {
        "lines": [
          "الطرف الأوّل : $3\\times 4-5=7$ .",
          "الطرف الثاني : $4\\times 4-9=7$ .",
          "$7=7$ : الطرفان متساويان، فالمساواة صحيحة ."
        ]
      },
