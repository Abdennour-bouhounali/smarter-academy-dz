      "solution": {
        "lines": [
          "الطرف الأوّل : $4\\times 1-3=1$ .",
          "الطرف الثاني : $5\\times 1-4=1$ .",
          "$1=1$ : الطرفان متساويان، فالمساواة صحيحة ."
        ]
      },
