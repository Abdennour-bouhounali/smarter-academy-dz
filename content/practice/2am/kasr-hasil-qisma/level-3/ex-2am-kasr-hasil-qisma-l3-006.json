          "value": "7/5",
          "id": "MISC-QARIBA-RATIOFLIP"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$M$ بين $A$ و $B$: $AB = AM + MB$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بعد إيجاد $MB$ ضع $MA$ في البسط و $MB$ في المقام."
        }
      ],
      "feedback": {
        "correct": "$MB = 12 - 5 = 7$ ، إذن $\\dfrac{MA}{MB}=\\dfrac{5}{7}$.",
        "incorrect": "أوجد $MB$ بطرح $AM$ من $AB$ ثمّ اكتب النسبة بترتيب الحدّين المطلوب."
      },
      "solution": {
        "lines": [
          "$MB = AB - AM = 12 - 5 = 7$",
          "$\\dfrac{MA}{MB} = \\dfrac{5}{7}$"
        ],
        "result": "\\dfrac{5}{7}"
      },
