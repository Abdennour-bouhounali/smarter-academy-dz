  "statement": {
    "content": "النقطة $M$ تنتمي إلى القطعة $[AB]$ ، حيث $AB = 12$ cm و $AM = 5$ cm ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "عبّر بكسر عن النسبة $\\dfrac{AM}{AB}$ (نسبة $AM$ إلى $AB$).",
      "learningPoints": [
        {
          "code": "2am_kasr-hasil-qisma_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر (مثلًا 3/4)",
      "expectedAnswer": "5/12",
      "misconceptionSignatures": [
        {
          "value": "12/5",
          "id": "MISC-QARIBA-RATIOFLIP"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "«نسبة $AM$ إلى $AB$» : $AM$ في البسط و $AB$ في المقام."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{AM}{AB}=\\dfrac{5}{12}$.",
        "incorrect": "العدد المذكور أوّلًا يُكتب في البسط."
      },
      "solution": {
        "lines": [
          "$AM = 5$ و $AB = 12$",
          "$\\dfrac{AM}{AB} = \\dfrac{5}{12}$"
        ],
        "result": "\\dfrac{5}{12}"
      },
      "work": "optional",
      "timeSeconds": 90
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "احسب $MB$ ثمّ عبّر بكسر عن النسبة $\\dfrac{MA}{MB}$ .",
      "learningPoints": [
        {
          "code": "2am_kasr-hasil-qisma_P1",
