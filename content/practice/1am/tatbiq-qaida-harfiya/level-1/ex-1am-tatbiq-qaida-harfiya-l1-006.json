  "statement": {
    "content": "السرعة المتوسّطة لسيّارة بالكيلومتر في الساعة، حيث $d$ المسافة بالكيلومتر و $t$ الزمن بالساعة، هي:",
    "formulas": [
      "V=d\\div t"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب $V$ من أجل $d=160$ و $t=8$ .",
      "learningPoints": [
        {
          "code": "1am_tatbiq-qaida-harfiya_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد (بالفاصلة عند اللزوم)",
      "expectedAnswer": "20",
      "misconceptionSignatures": [
        {
          "value": "0.05",
          "id": "MISC-TATBIQ-SWAP"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما قيمة كلّ حرف؟ وفي كم موضع يظهر كلّ حرف في العبارة؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ضع القيمة في كلّ موضع يظهر فيه الحرف، وأعد إشارة الضرب بين العددين."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب بالأولويات: ما بين القوسين، ثمّ الضرب والقسمة، ثمّ الجمع والطرح."
        }
      ],
      "feedback": {
        "correct": "نتحقّق: النتيجة $20$ .",
        "incorrect": "لكلّ حرف قيمته: انتبه إلى العدد الذي يوافق كلّ حرف قبل التعويض."
      },
      "solution": {
        "lines": [
          "نكتب القاعدة: $V=d\\div t$ .",
          "نضع قيمة كلّ حرف في كلّ موضع يظهر فيه: $V=160\\div 8$ .",
          "نحسب: $V=20$ .",
          "الجواب: $V=20$ ."
        ]
      },
