      "id": "q1",
      "step": "01",
      "statement": "هل $\\dfrac{12}{20}$ يساوي $\\dfrac{4}{5}$؟",
      "learningPoints": [
        {
          "code": "1am_ikhtizal-kitaba-kasriya_P1",
          "role": "primary"
        }
      ],
