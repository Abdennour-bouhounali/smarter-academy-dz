    {
      "id": "q1",
      "step": "01",
      "statement": "على المستقيم المدرّج النقطة $A$ لا تقع على علامة. ما العدد الصحيح $a$ الذي تقع النقطة $A$ بين العلامتين $a$ و $a+1$ ؟",
      "learningPoints": [
        {
          "code": "1am_talim-mustaqim-mudarraj_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
