    {
      "id": "q1",
      "step": "01",
      "statement": "نعلّم النقطة $A(2{,}3)$ على مستقيم مدرّج طول وحدته $2$ cm . كم تبعد عن المبدإ $O$ بالسنتيمتر؟ نكتب العدد موجبًا إن كانت على يمين $O$ وسالبًا إن كانت على يسارها.",
      "learningPoints": [
        {
          "code": "1am_talim-mustaqim-mudarraj_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
