          "id": "h1",
          "type": "look",
          "content": "ابحث عن المبدإ ثمّ عدّ الوحدات والتدريجات حتى النقطة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "قيمة التدريجة الصغيرة هي قيمة الوحدة مقسومة على عدد الأجزاء."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "عدّ التدريجات من المبدإ نحو النقطة، وانتبه إلى جهة السير."
        }
      ],
      "feedback": {
        "correct": "فاصلة $M$ هي $-40$.",
        "incorrect": "اقرأ الجهة من المبدإ ثمّ احسب البعد، ولا تنسَ قيمة التدريجة."
      },
      "solution": {
        "lines": [
          "كلّ تدريجة صغيرة تمثّل $5$",
          "النقطة $M$ تبعد $8$ تدريجات عن المبدإ نحو اليسار",
          "فاصلتها $-40$"
        ]
      },
      "timeSeconds": 90
