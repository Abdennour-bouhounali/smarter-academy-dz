  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "ما فاصلة النقطة $A$ على المستقيم المدرّج؟",
      "learningPoints": [
        {
          "code": "1am_talim-mustaqim-mudarraj_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد نسبي (بالفاصلة عند اللزوم)",
      "expectedAnswer": "-15",
      "misconceptionSignatures": [
        {
          "value": "15",
          "id": "MISC-TALIM1-SIGNSIDE"
        },
        {
          "value": "-1.5",
          "id": "MISC-TALIM1-UNITIGNORED"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ابحث عن المبدإ ثمّ عدّ الوحدات والتدريجات حتى النقطة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "قيمة التدريجة الصغيرة هي قيمة الوحدة مقسومة على عدد الأجزاء."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "عدّ التدريجات من المبدإ نحو النقطة، وانتبه إلى جهة السير."
        }
      ],
      "feedback": {
        "correct": "فاصلة $A$ هي $-15$.",
        "incorrect": "اقرأ الجهة من المبدإ ثمّ احسب البعد، ولا تنسَ قيمة التدريجة."
      },
      "solution": {
        "lines": [
          "كلّ تدريجة صغيرة تمثّل $5$",
          "النقطة $A$ تبعد $3$ تدريجات عن المبدإ نحو اليسار",
          "فاصلتها $-15$"
        ]
      },
      "timeSeconds": 90
    },
