      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما الذي فعلته العملية بالعدد المجهول؟ وأين مكان □ في المساواة؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "العملية العكسية للضرب هي القسمة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب المساواة ثمّ احسب بالعملية العكسية، وتحقّق بالتعويض في المساواة الأصلية."
        }
      ],
      "feedback": {
        "correct": "نتحقّق: $8\\times 7=56$ ، فالعدد الناقص هو $8$ .",
        "incorrect": "في جداء نقسم الناتج على العدد المعلوم: لا نضربه فيه ولا نقسم المعلوم على الناتج."
      },
      "solution": {
        "lines": [
          "نكتب المساواة: $7\\times \\ldots=56$ .",
          "نُرجع بالعملية العكسية: $\\square=56\\div 7=8$ .",
          "نتحقّق: $8\\times 7=56$ ."
        ]
      },
      "timeSeconds": 90
    },
