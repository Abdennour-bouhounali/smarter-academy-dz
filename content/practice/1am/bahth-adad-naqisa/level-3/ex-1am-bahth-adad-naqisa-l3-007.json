      "solution": {
        "lines": [
          "نكتب المساواة: $\\triangle-4{,}5=6{,}5$ .",
          "نُرجع بالعملية العكسية: $\\square=6{,}5+4{,}5=11$ .",
          "نتحقّق: $11-4{,}5=6{,}5$ ."
        ]
      },
