        }
      ],
      "feedback": {
        "correct": "نتحقّق: $35{,}5+64{,}5=100$ ، فالعدد الناقص هو $35{,}5$ .",
        "incorrect": "في مجموع نطرح العدد المعلوم من الناتج: لا نجمع مرّة أخرى."
      },
      "solution": {
        "lines": [
          "نكتب المساواة: $\\square+64{,}5=100$ .",
          "نُرجع بالعملية العكسية: $\\square=100-64{,}5=35{,}5$ .",
          "نتحقّق: $35{,}5+64{,}5=100$ ."
        ]
      },
