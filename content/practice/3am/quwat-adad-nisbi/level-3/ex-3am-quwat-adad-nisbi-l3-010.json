      },
      "solution": {
        "lines": [
          "$2^{5} \\times 4 = 2^{5} \\times 2^{2} = 2^{7}$ و $2 \\times 2^{3} = 2^{4}$",
          "$A = 2^{7-4} = 2^{3}$"
        ],
        "result": "A = 2^{3}"
