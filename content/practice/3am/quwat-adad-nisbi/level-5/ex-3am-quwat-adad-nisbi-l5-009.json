      "lead": "الجزء الأول.",
      "statement": "احسب حجم العلبة الكبيرة بـ $\\mathrm{cm^3}$ .",
      "learningPoints": [
        {
          "code": "3am_quwat-adad-nisbi_P1",
          "role": "primary"
