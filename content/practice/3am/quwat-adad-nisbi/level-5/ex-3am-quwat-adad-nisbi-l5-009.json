      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$a^n$ جداء $n$ عاملًا كلها مساوية للعدد $a$ ، وليس $a \\times n$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "قوة عدد سالب موجبة إذا كان الأس زوجيًا، وسالبة إذا كان الأس فرديًا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انتبه للأقواس: في $-a^n$ يخصّ الأس العدد $a$ وحده، ثم نأخذ المعاكس."
        }
      ],
      "feedback": {
        "correct": "$6^3 = 216$ .",
        "incorrect": "راجع القاعدة المناسبة، ثم أعد الحساب خطوة خطوة."
      },
      "solution": {
        "lines": [
          "$6^{3} = 6 \\times 6 \\times 6 = 216$"
        ],
        "result": "216\\,\\mathrm{cm^3}"
      },
      "timeSeconds": 90
    },
