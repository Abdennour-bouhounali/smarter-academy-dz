          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "الأس $n$ (عدد صحيح نسبي)",
      "expectedAnswer": "-1",
      "misconceptionSignatures": [
        {
          "value": "1",
          "id": "MISC-QUWA-NEG-EXP-NEGATIVE"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$a^{-n}$ هو مقلوب $a^n$ ، فهو لا يدلّ على عدد سالب."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب $a^n$ أولًا، ثم خذ مقلوبه، وحافظ على إشارة $a$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "من أجل $a \\neq 0$ : $a^0 = 1$ و $a^1 = a$ ."
        }
      ],
      "feedback": {
        "correct": "$2^{-1} = \\dfrac{1}{2}$ .",
        "incorrect": "راجع القاعدة المناسبة، ثم أعد الحساب خطوة خطوة."
      },
      "solution": {
        "lines": [
          "$\\dfrac{1}{2} = \\dfrac{1}{2^{1}} = 2^{-1}$"
        ],
        "result": "n = -1"
      },
      "timeSeconds": 90
    },
