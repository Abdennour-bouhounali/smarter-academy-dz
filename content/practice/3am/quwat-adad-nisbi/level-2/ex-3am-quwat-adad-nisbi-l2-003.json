      "feedback": {
        "correct": "$25^3 = (5^2)^3 = 5^{2 \\times 3}$ .",
        "incorrect": "راجع القاعدة المناسبة، ثم أعد الحساب خطوة خطوة."
      },
      "solution": {
        "lines": [
          "$25 = 5^{2}$",
          "$25^{3} = (5^{2})^{3} = 5^{2 \\times 3} = 5^{6}$"
        ]
