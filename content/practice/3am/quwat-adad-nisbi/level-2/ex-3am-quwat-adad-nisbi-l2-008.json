  "statement": {
    "content": "يصنع نجّار يتقن عمله لوحة إعلانات مربعة لمكتبة المتوسطة مساحتها $7^{8}\\,\\mathrm{cm^2}$ ، وصندوقًا مكعب الشكل حجمه $2^{18}\\,\\mathrm{cm^3}$ لحفظ الكتب."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "طول ضلع اللوحة هو $7^n\\,\\mathrm{cm}$ : ما قيمة $n$ ؟",
      "learningPoints": [
        {
          "code": "3am_quwat-adad-nisbi_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "الأس $n$ (عدد صحيح نسبي)",
      "expectedAnswer": "4",
      "misconceptionSignatures": [
        {
          "value": "6",
          "id": "MISC-QUWA-POWER-ADD-EXP"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "مساحة مربع ضلعه $c$ هي $c^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "إذا كان الضلع $7^n$ فالمساحة $(7^n)^2$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "في قوة القوة نضرب الأسين."
        }
      ],
      "feedback": {
        "correct": "$(7^4)^2 = 7^8$ .",
        "incorrect": "راجع القاعدة المناسبة، ثم أعد الحساب خطوة خطوة."
      },
      "solution": {
        "lines": [
          "$(7^{n})^{2} = 7^{2n} = 7^{8}$",
          "$2n = 8$ ، إذن $n = 4$"
        ],
        "result": "n = 4"
      },
      "timeSeconds": 90
    },
