    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "اكتب $R$ على الشكل $3^{n}$ : $R = 3^{n}$ ، ما قيمة $n$ ؟",
      "answerType": "rational",
      "answerFormat": "الأسّ $n$ (عدد صحيح نسبي)",
