        {
          "id": "h1",
          "type": "look",
          "content": "حدّد القوتين المضروبتين وأسّ كلّ منهما (انتبه إلى إشارته)."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "في جداء قوتين للعدد 10 نجري عملية واحدة على الأسّين: ما هي؟"
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "جرّب القاعدة على مثال صغير: $10^{2}\\times10^{1}$ هو $10\\times10\\times10$ ، فكم عاملًا 10 في الجداء؟"
        }
      ],
      "timeSeconds": 90,
      "choices": [
        {
          "id": "A",
          "content": "$10^{7}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$10^{12}$",
          "isCorrect": false,
          "misconceptionId": "MISC-QAWAID-DARB-ASS"
        },
        {
          "id": "C",
          "content": "$100^{7}$",
          "isCorrect": false,
          "misconceptionId": "MISC-QAWAID-ASAS"
        }
      ],
      "feedback": {
        "correct": "$10^{3}\\times10^{4} = 10^{7}$ .",
        "incorrect": "اختبر كلّ اقتراح بحساب قيمته أو بتطبيق القاعدة المناسبة، ثمّ أعد المحاولة."
      },
      "solution": {
        "lines": [
          "في الجداء نجمع الأسّين: $3 + 4 = 7$ .",
          "$10^{3}\\times10^{4} = 10^{7}$ ."
        ]
      }
