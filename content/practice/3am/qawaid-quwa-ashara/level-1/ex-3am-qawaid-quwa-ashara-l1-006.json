      "statement": "$\\dfrac{10^{8}}{10^{3}}$ يساوي:",
      "answerType": "choice",
      "answerFormat": "اختر الإجابة الصحيحة",
      "learningPoints": [
        {
          "code": "3am_qawaid-quwa-ashara_P2",
