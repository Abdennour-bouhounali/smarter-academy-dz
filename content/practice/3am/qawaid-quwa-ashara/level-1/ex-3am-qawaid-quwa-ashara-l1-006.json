      "cognitiveDemand": "reason",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "حدّد البسط والمقام وأسّ كلّ منهما (انتبه إلى إشارة الأسّ)."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "في حاصل قسمة قوتين للعدد 10 نجري عملية واحدة على الأسّين: ما هي، وبأيّ ترتيب؟"
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "تذكّر أنّ $\\dfrac{10^{2}}{10^{1}}$ هو $\\dfrac{10\\times10}{10}$ ، وأنّ طرح أسّ سالب يعني جمع عدد موجب."
        }
      ],
      "timeSeconds": 90,
      "choices": [
        {
          "id": "A",
          "content": "$10^{5}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$10^{11}$",
          "isCorrect": false,
          "misconceptionId": "MISC-QAWAID-DARB-ASS"
        },
        {
          "id": "C",
          "content": "$10^{24}$",
          "isCorrect": false,
          "misconceptionId": "MISC-QAWAID-DARB-ASS"
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{10^{8}}{10^{3}} = 10^{5}$ .",
        "incorrect": "اختبر كلّ اقتراح بحساب قيمته أو بتطبيق القاعدة المناسبة، ثمّ أعد المحاولة."
      },
      "solution": {
        "lines": [
          "في القسمة نطرح الأسّين: $8 - 3 = 5$ .",
          "$\\dfrac{10^{8}}{10^{3}} = 10^{5}$ ."
        ]
      }
    },
