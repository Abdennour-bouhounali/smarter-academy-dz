      "sub": "ا",
      "lead": "الكراريس.",
      "statement": "بيع $98$ كرّاسًا بالتخفيض. احسب ذهنيًا التغيّر $(−3{,}5) \\times 98$ دج.",
      "learningPoints": [
        {
          "code": "3am_jidaa-ida-nisbiya_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
