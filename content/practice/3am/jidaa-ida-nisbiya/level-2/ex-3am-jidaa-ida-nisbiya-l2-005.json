      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب جداء العوامل المعلومة أولًا، ثم اختبر كل اقتراح بتعويضه."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الإشارة تُحدَّد بعدّ العوامل السالبة، والمسافة تُحدَّد بما يلزم ليصير جداء المسافات مساويًا للطرف الآخر."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "عوّض الاقتراح في الفراغ ثم احسب الجداء كلّه."
        }
      ],
      "feedback": {
        "correct": "العدد المطلوب هو −3 .",
        "incorrect": "راجع الحل النموذجي: الإشارة أولًا بعدّ العوامل السالبة، ثم جداء المسافات إلى الصفر."
      },
      "solution": {
        "lines": [
          "جداء العوامل المعلومة هو $(−3) \\times 4 \\times (−5) \\times 2 = 120$ .",
          "نبحث عن العدد الذي إذا ضربناه في $120$ أعطى $−360$ : إشارته سالبة ومسافته $3$ ، لأنّ $120 \\times 3 = 360$ .",
          "نتحقّق: $(−3) \\times (−3) \\times 4 \\times (−5) \\times 2 = −360$ ."
        ]
      },
