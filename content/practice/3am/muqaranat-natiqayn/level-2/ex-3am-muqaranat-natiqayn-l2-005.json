  "statement": {
    "content": "نقارن في كلّ جزء بين العددين $a$ و $b$ المكتوبين بدلالة $\\pi$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "الجزء الأول: $a = \\dfrac{3\\pi}{8}$ و $b = \\dfrac{\\pi}{3}$ . نكتب $a - b = k\\pi$ ، فما العدد $k$ ؟",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $k$ فقط (كسر غير قابل للاختزال)",
      "learningPoints": [
        {
          "code": "3am_muqaranat-natiqayn_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما المطلوب بالضبط؟ وما العمليات التي تحتاجها؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب خطوة خطوة مع الانتباه إلى الإشارات."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "راجع النتيجة بطريقة ثانية قبل أن تجيب."
        }
      ],
      "timeSeconds": 90,
      "expectedAnswer": "1/24",
      "misconceptionSignatures": [
        {
          "value": "-1/24",
          "id": "MISC-MUQ-ORDER-SUB"
        }
      ],
      "feedback": {
        "correct": "$a - b = \\dfrac{1}{24}\\pi$ .",
        "incorrect": "أعد الحساب بالترتيب مع الانتباه إلى الإشارات."
      },
      "solution": {
        "lines": [
          "$a - b = \\dfrac{3\\pi}{8} - \\dfrac{\\pi}{3} = \\dfrac{9\\pi}{24} - \\dfrac{8\\pi}{24} = \\dfrac{\\pi}{24}$"
        ]
      }
    },
    {
      "id": "q2",
      "step": "01",
      "sub": "ب",
      "statement": "ما المقارنة الصحيحة بين $a$ و $b$ ؟",
      "answerType": "choice",
      "answerFormat": "اختر الإجابة الصحيحة",
      "learningPoints": [
        {
          "code": "3am_muqaranat-natiqayn_P2",
          "role": "primary"
