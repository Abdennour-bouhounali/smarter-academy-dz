        {
          "id": "h1",
          "type": "look",
          "content": "ماذا تعلّمنا إشارة الفرق عن ترتيب العددين؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اربط إشارة الفرق بالمقارنة بين العددين، وانتبه إلى أيّ العددين هو الأول في الفرق."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "إذا انعكس ترتيب الطرح فإنّ إشارة الفرق تنعكس أيضًا."
        }
      ],
      "timeSeconds": 90,
      "choices": [
        {
          "id": "A",
          "content": "$a < b$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUQ-ORDER-SUB"
        },
        {
          "id": "B",
          "content": "$a > b$",
          "isCorrect": true
        }
      ],
      "feedback": {
        "correct": "$a > b$ لأنّ $a - b > 0$ .",
        "incorrect": "اربط إشارة الفرق بالترتيب، وانتبه إلى ترتيب الطرح، ثمّ أعد المحاولة."
      },
      "solution": {
        "lines": [
          "$a - b = \\dfrac{\\pi}{24} > 0$ لأنّ $\\pi > 0$ ، إذن $a > b$ ."
        ]
      }
