  "statement": {
    "content": "$D$ عبارة جبرية حيث:",
    "formulas": [
      "D = (3x - 1)(x + 2) - (2x^2 + 4x - 5)"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "تحقّق بالنشر أن: $(3x - 1)(x + 2) = 3x^2 + 5x - 2$ .",
      "learningPoints": [
        {
          "code": "3am_tabsit-hadhf-aqwas_P3",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر حدًّا حدًّا: اضرب كل حدّ من القوس الأول في كل حدّ من القوس الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجمع الحدود المتشابهة في النتيجة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "قارن بالعبارة المطلوبة."
        }
      ],
      "feedback": {
        "correct": "قارن تبريرك بالحل النموذجي: كل خطوة مكتوبة ومعلّلة.",
        "incorrect": "اطّلع على الحل النموذجي وقارن به تبريرك خطوة خطوة."
      },
      "solution": {
        "lines": [
          "$(3x - 1)(x + 2) = 3x \\times x + 3x \\times 2 - 1 \\times x - 1 \\times 2$",
          "$= 3x^2 + 6x - x - 2$",
          "$= 3x^2 + 5x - 2$"
        ]
      },
      "timeSeconds": 150
    },
    {
      "id": "q2",
