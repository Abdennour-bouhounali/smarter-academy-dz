      "step": "01",
      "sub": "ا",
      "lead": "الجزء الأول.",
      "statement": "عبّر بدلالة $x$ عن محيط القطعة $P$ مع تبسيط الناتج.",
      "learningPoints": [
        {
          "code": "3am_tabsit-hadhf-aqwas_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "answerFormat": "اختر الإجابة الصحيحة",
      "choices": [
