        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $P$ على الشكل $ax + b$ : اكتب العدد $a$ فقط",
      "expectedAnswer": "12",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ما الإشارة التي تسبق القوسين؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "قوسان مسبوقان بالإشارة $+$ (وغير متبوعين بـ $\\times$ أو $\\div$) يُحذفان دون تغيير أي إشارة بينهما."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب العبارة بدون أقواس حدًّا حدًّا، ثم اجمع الحدود المتشابهة."
        }
      ],
      "feedback": {
        "correct": "$P = 12x - 4$ إذن $a = 12$.",
        "incorrect": "اجمع الحدود المتشابهة بإشاراتها بعد حذف الأقواس، ثم اقرأ العدد المطلوب في الشكل المبسّط."
      },
      "solution": {
        "lines": [
          "$P = (5x - 3) + (x + 1) + (5x - 3) + (x + 1)$",
          "$P = 5x - 3 + x + 1 + 5x - 3 + x + 1$",
          "$P = 12x - 4$"
        ],
        "result": "a = 12"
      },
