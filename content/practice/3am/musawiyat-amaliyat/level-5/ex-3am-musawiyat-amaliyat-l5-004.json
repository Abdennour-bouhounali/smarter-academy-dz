  "statement": {
    "content": "الجزء الأول: يعتني العمّ أحمد بأشجار بستانه عنايته بأمانة. في بستانه $N$ شجرة: التفاح $\\dfrac{2}{5}$ من العدد الكلي، والزيتون $\\dfrac{1}{5}$ منه، وعدد أشجار الإجاص $36$ شجرة.\nالجزء الثاني: لسقي الأشجار يستعمل خزانًا سعته $C$ لترًا، وهو مملوء إلى $\\dfrac{3}{4}$ سعته أي $4500\\,\\mathrm{L}$ ، وكلّ شجرة تحتاج $50\\,\\mathrm{L}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "lead": "الجزء الأول.",
      "statement": "ما الكسر من العدد الكلي الذي تمثّله أشجار الإجاص؟",
      "learningPoints": [
        {
          "code": "3am_musawiyat-amaliyat_P3",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر على الشكل a/b",
      "expectedAnswer": "2/5",
