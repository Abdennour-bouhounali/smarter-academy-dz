      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$10^{-n}$ هو مقلوب $10^{n}$ ، أي $\\dfrac{1}{10^{n}}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "في $10^{-n}$ يكون الرقم 1 في الرتبة $n$ بعد الفاصلة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب الفاصلة ثمّ ضع الرقم 1 في الرتبة المطلوبة، وأكمل الباقي بأصفار؛ والعدد موجب دائمًا."
        }
      ],
      "timeSeconds": 90,
      "expectedAnswer": "0.001",
      "misconceptionSignatures": [
