      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $3$ و $4$ : إنّه $12$ .",
          "$\\dfrac{1}{3} = \\dfrac{1 \\times 4}{3 \\times 4} = \\dfrac{4}{12}$ .",
          "$\\dfrac{1}{4} = \\dfrac{1 \\times 3}{4 \\times 3} = \\dfrac{3}{12}$ .",
          "$\\dfrac{4 + 3}{12} = \\dfrac{7}{12}$ ."
        ],
        "result": "\\dfrac{7}{12}"
      },
