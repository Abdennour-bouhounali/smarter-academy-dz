      "feedback": {
        "correct": "$\\dfrac{19}{20}$ .",
        "incorrect": "اكتب الكسرين بمقام مشترك قبل أن تجمع أو تطرح، ثمّ أعد المحاولة."
      },
      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $5$ و $10$ و $4$ : إنّه $20$ .",
          "$\\dfrac{3}{5} = \\dfrac{3 \\times 4}{5 \\times 4} = \\dfrac{12}{20}$ .",
          "$\\dfrac{1}{10} = \\dfrac{1 \\times 2}{10 \\times 2} = \\dfrac{2}{20}$ .",
          "$\\dfrac{1}{4} = \\dfrac{1 \\times 5}{4 \\times 5} = \\dfrac{5}{20}$ .",
          "$\\dfrac{12 + 2 + 5}{20} = \\dfrac{19}{20}$ ."
        ],
        "result": "\\dfrac{19}{20}"
      },
