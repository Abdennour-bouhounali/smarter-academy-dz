      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $4$ و $3$ و $5$ : إنّه $60$ .",
          "$\\dfrac{1}{4} = \\dfrac{1 \\times 15}{4 \\times 15} = \\dfrac{15}{60}$ .",
          "$\\dfrac{1}{3} = \\dfrac{1 \\times 20}{3 \\times 20} = \\dfrac{20}{60}$ .",
          "$\\dfrac{1}{5} = \\dfrac{1 \\times 12}{5 \\times 12} = \\dfrac{12}{60}$ .",
          "$\\dfrac{15 + 20 + 12}{60} = \\dfrac{47}{60}$ ."
        ],
        "result": "\\dfrac{47}{60}"
