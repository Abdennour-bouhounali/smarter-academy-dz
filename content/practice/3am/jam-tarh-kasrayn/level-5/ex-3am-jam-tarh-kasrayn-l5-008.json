      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $8$ و $6$ و $12$ : إنّه $24$ .",
          "$\\dfrac{3}{8} = \\dfrac{3 \\times 3}{8 \\times 3} = \\dfrac{9}{24}$ .",
          "$\\dfrac{1}{6} = \\dfrac{1 \\times 4}{6 \\times 4} = \\dfrac{4}{24}$ .",
          "$\\dfrac{5}{12} = \\dfrac{5 \\times 2}{12 \\times 2} = \\dfrac{10}{24}$ .",
          "$\\dfrac{9 + 4 + 10}{24} = \\dfrac{23}{24}$ ."
        ],
        "result": "\\dfrac{23}{24}"
