      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $15$ و $10$ : إنّه $30$ .",
          "$\\dfrac{7}{15} = \\dfrac{7 \\times 2}{15 \\times 2} = \\dfrac{14}{30}$ .",
          "$\\dfrac{3}{10} = \\dfrac{3 \\times 3}{10 \\times 3} = \\dfrac{9}{30}$ .",
          "$A = \\dfrac{14 + 9}{30} = \\dfrac{23}{30}$ ."
        ],
        "result": "A = \\dfrac{23}{30}"
