      "solution": {
        "lines": [
          "نبحث عن أصغر مضاعف مشترك للمقامات $7$ و $3$ : إنّه $21$ .",
          "$\\dfrac{2}{7} = \\dfrac{2 \\times 3}{7 \\times 3} = \\dfrac{6}{21}$ .",
          "$\\dfrac{1}{3} = \\dfrac{1 \\times 7}{3 \\times 7} = \\dfrac{7}{21}$ .",
          "$\\dfrac{6 + 7}{21} = \\dfrac{13}{21}$ ."
        ],
        "result": "\\dfrac{13}{21}"
