      "statement": "الكتابة العلمية للعدد $d$ هي $a\\times10^{n}$ حيث $1\\le a<10$ : ما قيمة $a$ ؟",
      "answerType": "rational",
      "answerFormat": "العدد $a$ (عدد عشري)",
      "learningPoints": [
