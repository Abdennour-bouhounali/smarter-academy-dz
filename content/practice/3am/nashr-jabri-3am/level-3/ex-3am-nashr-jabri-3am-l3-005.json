    "content": "$E$ عبارة جبرية حيث:",
    "formulas": [
      "E = (3x - 4)(x - 2) - (2x^2 - 10x + 5)"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "انشر ثم بسّط العبارة $E$ ، واكتبها على الشكل $ax^2 + bx + c$ .",
      "statement": "العدد $a$ :",
      "learningPoints": [
        {
          "code": "3am_nashr-jabri-3am_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $E$ على الشكل $ax^2 + bx + c$ : اكتب العدد $a$ فقط",
      "expectedAnswer": "1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر كل جداء على حدة وسجّل كل الحدود الناتجة بإشاراتها."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجمع الحدود المتشابهة فقط (الجزء الحرفي نفسه)، ثم رتّب الحدود: $x^2$ ثم $x$ ثم العدد."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "تحقّق بتعويض $x$ بعدد صغير في العبارة الأصلية وفي المبسّطة: يجب أن تجد القيمة نفسها."
        }
      ],
      "feedback": {
        "correct": "$E = x^2 + 3$ إذن $a = 1$ .",
        "incorrect": "انشر بتوزيع كل حدّ على كل حدّ، وانتبه إلى الإشارات، ثم اجمع الحدود المتشابهة."
      },
      "solution": {
        "lines": [
          "$E = (3x - 4)(x - 2) - (2x^2 - 10x + 5)$",
          "$E = 3x \\times x - 3x \\times 2 - 4 \\times x + 4 \\times 2 - 2x^2 + 10x - 5$",
          "$E = x^2 + 3$"
        ]
      },
      "timeSeconds": 90
