  "statement": {
    "content": "لتكن العبارة الجبرية $E$ حيث:",
    "formulas": [
      "E = (x + 2)(2x - 3) + 3x^2 - 5x"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "انشر ثم بسّط العبارة $E = (x + 2)(2x - 3) + 3x^2 - 5x$ ، واكتبها على الشكل $ax^2 + bx + c$ .",
      "statement": "العدد $b$ :",
      "learningPoints": [
        {
          "code": "3am_nashr-jabri-3am_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $E$ على الشكل $ax^2 + bx + c$ : اكتب العدد $b$ فقط",
      "expectedAnswer": "-4",
