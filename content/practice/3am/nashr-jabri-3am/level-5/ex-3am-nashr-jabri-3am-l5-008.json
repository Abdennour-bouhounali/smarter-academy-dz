  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "ملعب مستطيل طوله $x + 8$ وعرضه $x - 2$ (بالمتر). مساحته $S = (x + 8)(x - 2)$ . اكتبها على الشكل $ax^2 + bx + c$ .",
      "statement": "العدد $b$ :",
