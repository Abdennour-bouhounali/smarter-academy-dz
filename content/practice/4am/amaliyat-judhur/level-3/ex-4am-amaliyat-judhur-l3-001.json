  "statement": {
    "content": "ليكن العدد الحقيقي $A$ حيث:",
    "formulas": [
      "A = \\sqrt{3}(\\sqrt{3} - 1) + \\sqrt{27} + 1"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "بين أن: $A = 4 + 2\\sqrt{3}$ .",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر $\\sqrt{3}(\\sqrt{3} - 1)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب $\\sqrt{27} = \\sqrt{9} \\times \\sqrt{3}$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع الأعداد الناطقة معًا والحدود التي فيها $\\sqrt{3}$ معًا."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الخاصية المستعملة في كل مرحلة."
      },
      "solution": {
        "lines": [
          "$A = \\sqrt{3}(\\sqrt{3} - 1) + \\sqrt{27} + 1$",
          "$= \\sqrt{3} \\times \\sqrt{3} - \\sqrt{3} + \\sqrt{9} \\times \\sqrt{3} + 1$",
          "$= 3 - \\sqrt{3} + 3\\sqrt{3} + 1$"
        ],
        "result": "A = 4 + 2\\sqrt{3}"
      },
      "timeSeconds": 240
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "ليكن العدد الحقيقي $B$ حيث: $B = 4 - 2\\sqrt{3}$ . بين أن $A \\times B$ عدد طبيعي.",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب قيمة الجداء $A \\times B$ (عدد طبيعي)",
      "expectedAnswer": "4",
      "misconceptionSignatures": [
        {
          "value": "-20",
          "id": "MISC-TARBI-JIDHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الجداء $(4 + 2\\sqrt{3})(4 - 2\\sqrt{3})$ من الشكل $(a + b)(a - b)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $(a + b)(a - b) = a^2 - b^2$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب $(2\\sqrt{3})^2 = 2^2 \\times (\\sqrt{3})^2$ ."
        }
      ],
      "feedback": {
        "correct": "$A \\times B = 4^2 - (2\\sqrt{3})^2 = 16 - 12 = 4$ : عدد طبيعي.",
        "incorrect": "انتبه إلى مربع $2\\sqrt{3}$ : نربّع المعامل 2 ونربّع $\\sqrt{3}$ ."
      },
      "solution": {
        "lines": [
          "$A \\times B = (4 + 2\\sqrt{3})(4 - 2\\sqrt{3})$",
          "$= 4^2 - (2\\sqrt{3})^2$",
          "$= 16 - 4 \\times 3$",
          "$= 16 - 12$"
        ],
        "result": "A \\times B = 4"
      },
      "work": "optional",
      "timeSeconds": 240
    }
  ]
}
