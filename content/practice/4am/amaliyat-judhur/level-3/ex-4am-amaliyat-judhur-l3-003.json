  "statement": {
    "content": "ليكن العدد الحقيقي $A$ حيث:",
    "formulas": [
      "A = \\sqrt{5}(\\sqrt{5} - 1) + \\sqrt{45} + 2"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "بين أن: $A = 7 + 2\\sqrt{5}$ .",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر $\\sqrt{5}(\\sqrt{5} - 1)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب $\\sqrt{45} = \\sqrt{9} \\times \\sqrt{5}$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع الأعداد الناطقة معًا والحدود التي فيها $\\sqrt{5}$ معًا."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الخاصية المستعملة في كل مرحلة."
      },
      "solution": {
        "lines": [
          "$A = \\sqrt{5}(\\sqrt{5} - 1) + \\sqrt{45} + 2$",
          "$= \\sqrt{5} \\times \\sqrt{5} - \\sqrt{5} + \\sqrt{9} \\times \\sqrt{5} + 2$",
          "$= 5 - \\sqrt{5} + 3\\sqrt{5} + 2$"
        ],
        "result": "A = 7 + 2\\sqrt{5}"
      },
      "timeSeconds": 240
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "ليكن العدد الحقيقي $B$ حيث: $B = 7 - 2\\sqrt{5}$ . بين أن $A \\times B$ عدد طبيعي.",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب قيمة الجداء $A \\times B$ (عدد طبيعي)",
      "expectedAnswer": "29",
      "misconceptionSignatures": [
        {
          "value": "-51",
          "id": "MISC-TARBI-JIDHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الجداء من الشكل $(a + b)(a - b)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $(a + b)(a - b) = a^2 - b^2$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب $(2\\sqrt{5})^2 = 2^2 \\times (\\sqrt{5})^2$ ."
        }
      ],
      "feedback": {
        "correct": "$A \\times B = 49 - 20 = 29$ : عدد طبيعي.",
        "incorrect": "انتبه إلى مربع $2\\sqrt{5}$ : نربّع المعامل 2 ونربّع $\\sqrt{5}$ ."
      },
      "solution": {
        "lines": [
          "$A \\times B = (7 + 2\\sqrt{5})(7 - 2\\sqrt{5})$",
          "$= 7^2 - (2\\sqrt{5})^2$",
          "$= 49 - 4 \\times 5$",
          "$= 49 - 20$"
        ],
        "result": "A \\times B = 29"
      },
      "work": "optional",
