  "statement": {
    "content": "ليكن العددان الحقيقيان $m$ و $n$ حيث:",
    "formulas": [
      "m = \\sqrt{11} - 4",
      "n = \\sqrt{11} + 4"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "اكتب $m + n$ على الشكل $a\\sqrt{11}$ حيث $a$ عدد طبيعي.",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد طبيعي)",
      "expectedAnswer": "2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اجمع الحدود التي فيها $\\sqrt{11}$ معًا، والأعداد الناطقة معًا."
        }
      ],
      "feedback": {
        "correct": "$m + n = \\sqrt{11} - 4 + \\sqrt{11} + 4 = 2\\sqrt{11}$",
        "incorrect": "اجمع $\\sqrt{11} + \\sqrt{11}$ ثم $-4 + 4$ ."
      },
      "solution": {
        "lines": [
          "$m + n = \\sqrt{11} - 4 + \\sqrt{11} + 4$",
          "$m + n = \\sqrt{11} + \\sqrt{11}$"
        ],
        "result": "m + n = 2\\sqrt{11}"
      },
      "work": "optional",
      "timeSeconds": 90
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "بيّن أن الجداء $m \\times n$ عدد ناطق.",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب قيمة الجداء $m \\times n$ (عدد صحيح)",
      "expectedAnswer": "-5",
      "misconceptionSignatures": [
        {
          "value": "5",
          "id": "MISC-ISHARA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الجداء من الشكل $(a - b)(a + b)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $(a - b)(a + b) = a^2 - b^2$ و $(\\sqrt{11})^2 = 11$ ."
        }
      ],
      "feedback": {
        "correct": "$m \\times n = 11 - 16 = -5$ : عدد ناطق.",
        "incorrect": "انشر $(\\sqrt{11} - 4)(\\sqrt{11} + 4)$ ، وانتبه إلى أن الجداء قد يكون سالبًا."
      },
      "solution": {
        "lines": [
          "$m \\times n = (\\sqrt{11} - 4)(\\sqrt{11} + 4)$",
          "$m \\times n = (\\sqrt{11})^2 - 4^2$",
          "$m \\times n = 11 - 16$"
        ],
        "result": "m \\times n = -5"
      },
      "work": "optional",
      "timeSeconds": 180
    }
