          "content": "$\\dfrac{7}{6}$",
          "isCorrect": false
        },
        {
          "id": "B",
          "content": "$\\dfrac{\\sqrt{7}}{36}$",
          "isCorrect": false
        },
        {
          "id": "C",
          "content": "$\\dfrac{\\sqrt{7}}{6}$",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sqrt{\\dfrac{a}{b}} = \\dfrac{\\sqrt{a}}{\\sqrt{b}}$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "البسط 7 ليس مربّعًا تامًّا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب جذر المقام فقط، واترك $\\sqrt{7}$."
        }
      ],
      "feedback": {
        "correct": "$\\sqrt{\\dfrac{7}{36}} = \\dfrac{\\sqrt{7}}{\\sqrt{36}} = \\dfrac{\\sqrt{7}}{6}$",
