    {
      "id": "q2",
      "statement": "احسب $\\sqrt{\\dfrac{25}{100}}$.",
      "learningPoints": [
        {
          "code": "4am_amaliyat-judhur_P2",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد (بالفاصلة إن لزم)",
      "expectedAnswer": "0.5",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sqrt{\\dfrac{a}{b}} = \\dfrac{\\sqrt{a}}{\\sqrt{b}}$ من أجل $a$ و $b$ موجبين و $b \\neq 0$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب $\\sqrt{25}$ و $\\sqrt{100}$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب حاصل القسمة كسرًا أو عددًا عشريًا."
        }
      ],
      "feedback": {
        "correct": "$\\sqrt{\\dfrac{25}{100}} = \\dfrac{\\sqrt{25}}{\\sqrt{100}} = \\dfrac{5}{10} = 0{,}5$",
        "incorrect": "الجذر التربيعي لـ $0{,}25$ ليس $0{,}25$ ولا $0{,}05$: تحقّق بالتربيع."
      }
