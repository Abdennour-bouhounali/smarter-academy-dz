      "id": "q1",
      "step": "01",
      "statement": "بيّن أن $a$ و $b$ يحققان الجملة: $\\begin{cases} a - 3b = -2 \\\\ a - 4b = 2 \\end{cases}$",
      "learningPoints": [
        {
          "code": "4am_mushkilat-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "النسبة الجديدة بسطها $a + 2$ ومقامها $b$ ."
