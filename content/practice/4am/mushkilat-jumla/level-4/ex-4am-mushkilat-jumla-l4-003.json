  "statement": {
    "content": "من الكتاب (ص 61): في المثلث EBC، A من [EB] و D من [EC] و (AD) يوازي (BC)، حيث EA = 10cm و AB = 4cm و DC = 5cm و AD = $y$ و BC = $x$ . محيط شبه المنحرف ABCD يساوي 13,8cm."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "الجملة التي تترجم المشكلة هي:",
      "learningPoints": [
        {
          "code": "4am_mushkilat-jumla_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\begin{cases} x + y = 4{,}8 \\\\ 14y = 10x \\end{cases}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$\\begin{cases} x + y = 13{,}8 \\\\ 14y = 10x \\end{cases}$",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-TARJAMA"
        },
        {
          "id": "C",
          "content": "$\\begin{cases} x + y = 4{,}8 \\\\ 4y = 10x \\end{cases}$",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-TARJAMA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "محيط ABCD: مجموع أضلاعه الأربعة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "خاصية طالس: $\\dfrac{AD}{BC} = \\dfrac{EA}{EB}$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$EB = 10 + 4$ ."
        }
      ],
      "feedback": {
        "correct": "$4 + x + 5 + y = 13{,}8$ و $\\dfrac{y}{x} = \\dfrac{10}{14}$ .",
        "incorrect": "في المحيط ضلعان معلومان، وفي طالس نأخذ EB كاملا."
      }
    },
    {
      "id": "q2",
      "statement": "الطولان: اكتب الثنائية $(x ; y)$ بالسنتيمتر.",
