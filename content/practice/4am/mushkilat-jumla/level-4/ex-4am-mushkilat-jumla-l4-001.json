  "statement": {
    "content": "من الكتاب (ص 61): حقل مستطيل الشكل محيطه يساوي 220m. عند إنقاص 2m من طوله وزيادة 2m إلى عرضه، تزداد مساحته بـ $16m^2$ . نسمّي $x$ الطول و $y$ العرض (بالمتر)."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "معادلة المساحة $(x - 2)(y + 2) = xy + 16$ تؤول إلى:",
      "learningPoints": [
        {
          "code": "4am_mushkilat-jumla_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$2x - 2y = 16$",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-TARJAMA"
        },
        {
          "id": "B",
          "content": "$2x - 2y = 20$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$2x + 2y = 20$",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-TARJAMA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر $(x - 2)(y + 2)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الحد $xy$ يظهر في الطرفين."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انقل العدد $-4$ إلى الطرف الثاني."
        }
      ],
      "feedback": {
        "correct": "$xy + 2x - 2y - 4 = xy + 16$ ومنه $2x - 2y = 20$ .",
        "incorrect": "بعد النشر يبقى عدد يجب نقله."
      }
    },
    {
