  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "نسمّي $x$ أكبر العددين و $y$ أصغرهما.",
      "statement": "بيّن أن $x$ و $y$ يحققان الجملة: $\\begin{cases} x - y = 24 \\\\ x - 3y = 16 \\end{cases}$",
      "learningPoints": [
        {
          "code": "4am_mushkilat-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "بعد الإضافة يصبح العددان $x + 8$ و $y + 8$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الأكبر = 3 × الأصغر."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك بالحل النموذجي سطرًا سطرًا، ثم أعد كتابته."
      },
      "solution": {
        "lines": [
          "الفرق: $x - y = 24$",
          "بعد إضافة 8: $x + 8 = 3(y + 8)$",
          "$x + 8 = 3y + 24$ أي $x - 3y = 16$",
          "ومنه $x$ و $y$ يحققان الجملة: $\\begin{cases} x - y = 24 \\\\ x - 3y = 16 \\end{cases}$"
        ]
      },
      "timeSeconds": 240
