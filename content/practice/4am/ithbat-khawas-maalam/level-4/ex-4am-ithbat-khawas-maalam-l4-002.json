        "incorrect": "التقايس والتناصف يعطيان المستطيل فقط."
      }
    },
    {
      "id": "q2",
      "statement": "مع $\\overrightarrow{AB}\\begin{pmatrix} 2 \\\\ 2 \\end{pmatrix}$ و $\\overrightarrow{BC}\\begin{pmatrix} 2 \\\\ -2 \\end{pmatrix}$ ، $(BD) \\perp (AC)$ لأن:",
      "learningPoints": [
        {
          "code": "4am_ithbat-khawas-maalam_P2",
          "role": "primary"
        }
      ],
      "difficulty": 4,
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$AC = BD$",
          "isCorrect": false,
          "misconceptionId": "MISC-MAALAM-MUTAWAZI-KAFI"
        },
        {
          "id": "B",
          "content": "AB = BC فالمستطيل ABCD مربّع، وقطرا المربّع متعامدان",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "قطري كل مستطيل متعامدان",
          "isCorrect": false,
          "misconceptionId": "MISC-MAALAM-MUTAWAZI-KAFI"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب AB و BC."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "مستطيل فيه ضلعان متتاليان متقايسان؟"
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "قطرا المعيّن متعامدان."
        }
      ],
      "feedback": {
