        {
          "id": "h2",
          "type": "direction",
          "content": "$4x^2 - 1 = (2x - 1)(2x + 1)$ و $12x^2 - 6x = 6x(2x - 1)$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "استخرج العامل المشترك $(2x - 1)$."
        }
      ],
