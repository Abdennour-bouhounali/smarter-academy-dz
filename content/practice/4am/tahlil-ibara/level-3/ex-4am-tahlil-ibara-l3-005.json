  "statement": {
    "content": "من الكتاب (ص 36): $E = 144x^2 - 24x + 1$ و $F = (4x^2 - 1) + (12x^2 - 6x)$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "حلّل E.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
