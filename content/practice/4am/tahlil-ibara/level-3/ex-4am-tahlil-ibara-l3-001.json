  "statement": {
    "content": "من الكتاب (ص 38): لتحليل $A = (x - 1)(x + 2) + x(x + 2) - (x + 2)$ كتب تلميذ: $A = (x + 2)(x - 1 + x) = (x + 2)(2x - 1)$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "احسب A من أجل $x = 0$ في العبارة المعطاة.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد صحيح (قد يكون سالبًا)",
      "expectedAnswer": "-4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ 0 في كل حدّ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$(0 - 1)(0 + 2) + 0 \\times (0 + 2) - (0 + 2)$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب كل جداء ثم اجمع."
        }
      ],
      "feedback": {
        "correct": "$(-1) \\times 2 + 0 - 2 = -4$.",
        "incorrect": "عوّض في العبارة الأصلية، لا في نتيجة التلميذ."
      }
    },
    {
      "id": "q2",
      "statement": "احسب نتيجة التلميذ $(x + 2)(2x - 1)$ من أجل $x = 0$.",
