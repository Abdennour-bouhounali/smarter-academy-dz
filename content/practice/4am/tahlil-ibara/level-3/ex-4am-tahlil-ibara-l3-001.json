          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد صحيح (قد يكون سالبًا)",
      "expectedAnswer": "-2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ 0."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$(0 + 2)(2 \\times 0 - 1)$."
        },
        {
          "id": "h3",
