  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "lead": "لتحليل العبارة $A$ كتب تلميذ: $A = (x + 2)(x - 1 + x) = (x + 2)(2x - 1)$ .",
      "statement": "احسب $A$ من أجل $x = 0$ انطلاقًا من عبارتها المعطاة.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد صحيح (قد يكون سالبًا)",
      "expectedAnswer": "-4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ $0$ في كل حد من العبارة المعطاة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "لا تنسَ الحد الأخير $-(x + 2)$ ."
        }
      ],
      "feedback": {
        "correct": "$A = -4$ .",
        "incorrect": "عوّض $x$ في كل عامل، واحترم الإشارات وأولويات العمليات."
      },
      "solution": {
        "lines": [
          "$A = (0 - 1)(0 + 2) + 0 \\times (0 + 2) - (0 + 2)$",
          "$A = -2 + 0 - 2$"
