      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $E$ على الشكل $ax^2 + bx + c$ : اكتب العدد $a$ فقط",
      "expectedAnswer": "-1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اضرب كل حد من القوس الأول في كل حد من القوس الثاني، وطبّق المتطابقة الشهيرة على المربع."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "انتبه إلى الإشارة «−» أمام قوس: تغيّر إشارة كل حد داخله."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع الحدود المتشابهة: حدود $x^2$ معًا، ثم حدود $x$، ثم الأعداد."
        }
      ],
      "feedback": {
        "correct": "$E = -x^2 + 3x + 4$ إذن $a = -1$ .",
        "incorrect": "أعد النشر حدًّا حدًّا، ثم اجمع الحدود المتشابهة بإشاراتها."
      },
      "solution": {
        "lines": [
          "$E = (x + 1)^2 - (x + 1)(2x - 3)$",
          "$= x^2 + 1 + 2 \\times x \\times 1 - [2x^2 - 3x + 2x - 3]$",
          "$= x^2 + 1 + 2x - 2x^2 + x + 3$"
        ],
        "result": "E = -x^2 + 3x + 4"
      },
      "work": "optional",
      "timeSeconds": 240
