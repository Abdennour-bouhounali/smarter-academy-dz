      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $R$ على الشكل $(ax + b)^2$ حيث $a$ و $b$ عددان ناطقان موجبان (كسر على الشكل p/q) : اكتب العدد $a$ فقط",
      "expectedAnswer": "1/3",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "تعرّف على الشكل $a^2 + 2ab + b^2$ أو $a^2 - 2ab + b^2$ : عيّن $a$ و $b$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تحقّق من الحد المضاعف $2ab$ قبل أن تكتب المربع."
