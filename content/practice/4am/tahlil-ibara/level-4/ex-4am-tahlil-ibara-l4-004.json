        {
          "id": "h1",
          "type": "look",
          "content": "استعمل $(a - b)^2 = a^2 - 2ab + b^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تذكّر أن $(\\sqrt{3})^2 = 3$ ."
        }
      ],
      "feedback": {
        "correct": "$A = 7 - 4\\sqrt{3}$ إذن $a = 7$ .",
        "incorrect": "طبّق متطابقة مربع فرق، ثم اجمع العددين $2^2$ و $(\\sqrt{3})^2$ ."
      },
      "solution": {
        "lines": [
          "$A = (2 - \\sqrt{3})^2$",
          "$= 2^2 + (\\sqrt{3})^2 - 2 \\times 2 \\times \\sqrt{3}$",
          "$= 4 + 3 - 4\\sqrt{3}$"
        ],
        "result": "A = 7 - 4\\sqrt{3}"
      },
      "work": "optional",
      "timeSeconds": 180
