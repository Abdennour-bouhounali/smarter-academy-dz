      "solution": {
        "lines": [
          "$E = x^2 - (7 - 4\\sqrt{3})$",
          "$= (\\sqrt{7})^2 - 7 + 4\\sqrt{3}$",
          "$= 4\\sqrt{3}$"
        ],
        "result": "E = 4\\sqrt{3}"
      },
