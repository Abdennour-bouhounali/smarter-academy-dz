        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $E$ على الشكل $(3x + 1)(mx + n)$ : اكتب العدد $m$ فقط",
      "expectedAnswer": "4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "استعمل نتيجة السؤال 01: اكتب $3x^2 - 11x - 4$ على شكل جداء."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "العامل $(3x + 1)$ يصبح مشتركًا بين الحدّين."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "بسّط ما بين القوسين الكبيرين بإشاراته، ثم قارن بالشكل المطلوب."
        }
      ],
      "feedback": {
        "correct": "$E = (3x + 1)(4x - 3)$ إذن $m = 4$ .",
        "incorrect": "أخرج العامل المشترك من كل حد، ثم بسّط ما بين القوسين الكبيرين بإشاراته (حدّ وحده يعني $1$)."
      },
      "solution": {
        "lines": [
          "$E = 3x^2 - 11x - 4 + (3x + 1)^2$",
          "$= (3x + 1)(x - 4) + (3x + 1)^2$",
          "$= (3x + 1)(x - 4 + 3x + 1)$"
        ],
        "result": "E = (3x + 1)(4x - 3)"
      },
