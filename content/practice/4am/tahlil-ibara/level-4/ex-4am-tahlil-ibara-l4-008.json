    {
      "id": "q1",
      "step": "01",
      "statement": "تحقّق من المساواة الآتية: $(3x + 1)(x - 4) = 3x^2 - 11x - 4$ .",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اضرب كل حد من القوس الأول في كل حد من القوس الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجمع الحدّين $-12x$ و $x$ ."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات."
      },
      "solution": {
        "lines": [
          "$(3x + 1)(x - 4) = 3x \\times x - 3x \\times 4 + 1 \\times x - 1 \\times 4$",
          "$= 3x^2 - 12x + x - 4$"
        ],
        "result": "(3x + 1)(x - 4) = 3x^2 - 11x - 4"
      },
      "timeSeconds": 180
    },
    {
      "id": "q2",
      "step": "02",
      "lead": "حلّل إلى جداء عاملين من الدرجة الأولى العبارة: $E = 3x^2 - 11x - 4 + (3x + 1)^2$ .",
      "statement": "العدد $m$ :",
