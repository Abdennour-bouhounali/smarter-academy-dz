    {
      "id": "q4",
      "step": "03",
      "statement": "حل المتراجحة: $(3x + 1)(x - 4) \\leqslant 3x^2 + 7$ .",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "حلول المتراجحة هي الأعداد $x$ حيث $x \\leq k$ أو $x \\geq k$ (أو بمتباينة تامة) : اكتب العدد الحدّي $k$ فقط",
      "expectedAnswer": "-1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر ثم اجمع حدود $x$ في طرف والأعداد في الطرف الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل نتيجة السؤال 01 للطرف الأيسر؛ والقسمة على عدد سالب تعكس اتجاه المتباينة."
        }
      ],
      "feedback": {
        "correct": "$x \\geqslant -1$ .",
        "incorrect": "انقل الحدود بإشاراتها، وعند القسمة على عدد سالب اعكس اتجاه المتباينة."
      },
      "solution": {
        "lines": [
          "$3x^2 - 11x - 4 \\leqslant 3x^2 + 7$",
          "$-11x \\leqslant 7 + 4$",
          "$\\dfrac{-11x}{-11} \\geqslant \\dfrac{11}{-11}$",
          "إذا حلول المتراجحة هي كل قيم $x$ الأكبر أو تساوي $-1$ ."
        ],
        "result": "x \\geqslant -1"
      },
