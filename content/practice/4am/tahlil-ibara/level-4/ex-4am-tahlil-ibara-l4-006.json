      "step": "01",
      "sub": "ب",
      "statement": "حلّ المتراجحة: $A \\geqslant 0$ ثم مثل مجموعة حلولها بيانيّا.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
