  "statement": {
    "content": "من الكتاب (ص 39): $A = (2 - x)^2 - 4x^2$ و $B = (2x + 3)^2 - (x + 1)^2$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "حلّل A.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
