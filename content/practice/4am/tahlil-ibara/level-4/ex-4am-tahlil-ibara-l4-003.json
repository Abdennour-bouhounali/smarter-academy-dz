      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$4x^2 = (2x)^2$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$a = 2 - x$ و $b = 2x$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب $(a - b)(a + b)$."
        }
      ],
      "feedback": {
        "correct": "$A = (2 - x - 2x)(2 - x + 2x) = (2 - 3x)(2 + x)$.",
        "incorrect": "$b$ جذر $4x^2$ ، أي $2x$."
      }
    },
    {
