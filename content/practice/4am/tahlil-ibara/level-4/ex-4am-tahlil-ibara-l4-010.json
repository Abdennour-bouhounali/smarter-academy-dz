    {
      "id": "q4",
      "step": "03",
      "statement": "حل المتراجحة: $5x^2 - 9x + 2 \\geqslant 5(x^2 - 1)$ . مثل حلولها بيانيا.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
