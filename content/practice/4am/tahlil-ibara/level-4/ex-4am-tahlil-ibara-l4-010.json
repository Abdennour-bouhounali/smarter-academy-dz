      "step": "01",
      "statement": "تحقق من صحة المساواة التالية: $3(x + 2)(x - 2) = 3x^2 - 12$ .",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "استعمل $(a + b)(a - b) = a^2 - b^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ثم وزّع العدد $3$ ."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات."
      },
      "solution": {
        "lines": [
          "$3(x + 2)(x - 2) = 3(x^2 - 2^2)$",
          "$= 3(x^2 - 4)$",
          "$= 3x^2 - 12$"
        ],
        "result": "3(x + 2)(x - 2) = 3x^2 - 12"
      },
      "timeSeconds": 180
    },
    {
