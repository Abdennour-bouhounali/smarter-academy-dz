      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "حلول المتراجحة هي الأعداد $x$ حيث $x \\leq k$ أو $x \\geq k$ (أو بمتباينة تامة) : اكتب العدد الحدّي $k$ فقط",
      "expectedAnswer": "7/9",
      "hints": [
        {
          "id": "h1",
