          "id": "h1",
          "type": "look",
          "content": "تعرّف على الشكل $a^2 + 2ab + b^2$ أو $a^2 - 2ab + b^2$ : عيّن $a$ و $b$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تحقّق من الحد المضاعف $2ab$ قبل أن تكتب المربع."
        },
        {
