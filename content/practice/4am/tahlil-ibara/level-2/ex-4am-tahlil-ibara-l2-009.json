      "solution": {
        "lines": [
          "$E = 2x - 10 - (x - 5)^2$",
          "$= 2x - 10 - [x^2 + 5^2 - 2 \\times x \\times 5]$",
          "$= 2x - 10 - x^2 - 25 + 10x$"
        ],
        "result": "E = -x^2 + 12x - 35"
