          "content": "$x(x^2 - 5)$",
          "isCorrect": false,
          "misconceptionId": "MISC-TABSIT-X-MARRATAYN"
        },
        {
          "id": "C",
          "content": "$5x(x - 1)$",
          "isCorrect": false,
          "misconceptionId": "MISC-TAHLIL-AMIL-NAQIS"
        }
      ],
      "hints": [
