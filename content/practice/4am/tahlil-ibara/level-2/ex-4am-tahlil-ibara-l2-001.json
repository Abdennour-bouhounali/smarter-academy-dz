          "id": "h1",
          "type": "look",
          "content": "العامل المشترك بين $x^2$ و $5x$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$x^2 = x \\times x$ و $5x = 5 \\times x$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "استخرج $x$."
        }
      ],
      "feedback": {
        "correct": "$x^2 - 5x = x(x - 5)$.",
        "incorrect": "بعد استخراج $x$ من $x^2$ يبقى $x$."
      }
    },
