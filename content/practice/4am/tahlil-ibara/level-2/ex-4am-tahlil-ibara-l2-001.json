  "statement": {
    "content": "من الكتاب (ص 38): $A = x^2 - 5x$ ، $B = (x + 3)(1 - 2x) + 5(1 - 2x)$ ، $C = (1 + x)(x - 5) - (1 + 2x)(1 + x)$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "بملاحظة أنّ $x^2 = x \\times x$ ، حلّل A.",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
