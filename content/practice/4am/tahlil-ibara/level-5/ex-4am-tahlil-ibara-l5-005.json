  "statement": {
    "content": "في مدخل متحف بمدينة تيبازة لوحة فسيفساء مربعة الشكل طول ضلعها $x$ cm ، يحيط بها من كل الجهات إطار من الرخام عرضه $20$ cm ، فيصبح الكل مربعًا طول ضلعه $(x + 40)$ cm ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "بيّن أن مساحة الإطار هي $M = (x + 40)^2 - x^2$ ، ثم حلّل $M$ .",
      "statement": "العدد $k$ :",
      "learningPoints": [
