  "statement": {
    "content": "أرضية موقف للسيارات بمحطة نقل المسافرين بمدينة باتنة مربعة الشكل طول ضلعها $(x + 7)$ m ، حيث $x$ عدد موجب. يُقتطع من أحد أركانها مربع طول ضلعه $3$ m لبناء كشك الحارس، والجزء الباقي مخصّص لركن السيارات."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "بيّن أن مساحة الجزء المخصّص للسيارات هي $S = (x + 7)^2 - 9$ ، ثم انشرها وبسّطها.",
      "statement": "العدد $a$ :",
      "learningPoints": [
        {
          "code": "4am_tahlil-ibara_P1",
          "role": "primary"
        }
      ],
      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $S$ على الشكل $ax^2 + bx + c$ : اكتب العدد $a$ فقط",
      "expectedAnswer": "1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اضرب كل حد من القوس الأول في كل حد من القوس الثاني، وطبّق المتطابقة الشهيرة على المربع."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "انتبه إلى الإشارة «−» أمام قوس: تغيّر إشارة كل حد داخله."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع الحدود المتشابهة: حدود $x^2$ معًا، ثم حدود $x$، ثم الأعداد."
        }
      ],
      "feedback": {
        "correct": "$S = x^2 + 14x + 40$ إذن $a = 1$ .",
        "incorrect": "أعد النشر حدًّا حدًّا، ثم اجمع الحدود المتشابهة بإشاراتها."
      },
      "solution": {
        "lines": [
          "مساحة الجزء المخصّص للسيارات = مساحة المربع الكبير − مساحة الكشك",
          "$S = (x + 7)^2 - 3^2$",
          "$S = x^2 + 2 \\times x \\times 7 + 49 - 9$"
        ],
        "result": "S = x^2 + 14x + 40"
      },
      "work": "optional",
      "timeSeconds": 240
