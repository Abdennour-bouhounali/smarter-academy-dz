          "content": "انظر إلى إشارة الحدّ الأوسط."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$16 = 4^2$ و $8x = 2 \\times x \\times 4$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حدّ أوسط موجب يدلّ على مربع مجموع."
