        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$x^2 = x \\times x$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "العامل المشترك بين $x^2$ و $3x$ هو $x$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب $x \\times x - 3 \\times x$ ثم استخرج $x$."
        }
      ],
      "feedback": {
        "correct": "$x^2 - 3x = x \\times x - 3 \\times x = x(x - 3)$.",
        "incorrect": "بعد استخراج $x$ من $x^2$ يبقى $x$ واحد فقط داخل القوس."
      }
