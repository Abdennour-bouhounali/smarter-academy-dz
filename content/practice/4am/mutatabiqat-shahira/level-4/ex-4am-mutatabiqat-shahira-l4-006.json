      ],
      "counted": false,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انطلق من الشكل $E = (x - 7)^2 - 81$ واكتب $81$ على شكل مربع."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $a^2 - b^2 = (a + b)(a - b)$ مع $a = x - 7$ ."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات عند النشر."
      },
      "solution": {
        "lines": [
          "$E = (x - 7)^2 - 81$",
          "$E = (x - 7)^2 - 9^2$",
          "$E = ((x - 7) - 9)((x - 7) + 9)$",
          "$E = (x - 7 - 9)(x - 7 + 9)$"
        ],
        "result": "E = (x - 16)(x + 2)"
      },
      "timeSeconds": 180
    },
