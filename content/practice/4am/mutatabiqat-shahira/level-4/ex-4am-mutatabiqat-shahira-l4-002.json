      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر $(x - 1)(x + 1)$ بالمتطابقة $(a - b)(a + b) = a^2 - b^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ضع النشر بين قوسين لأنه مسبوق بإشارة $-$ ، ثم احذف القوسين بتغيير الإشارات."
        }
      ],
      "feedback": {
        "correct": "$A = x^2 - (x^2 - 1) = 1$ : $A$ يساوي 1 مهما كان $x$ .",
        "incorrect": "الإشارة $-$ أمام الجداء تغيّر إشارة كل حدود نشره."
      },
      "solution": {
        "lines": [
          "$A = x^2 - (x - 1)(x + 1)$",
          "$A = x^2 - \\left[x^2 - 1^2\\right]$",
          "$A = x^2 - (x^2 - 1)$",
          "$A = x^2 - x^2 + 1$"
        ],
        "result": "A = 1"
      },
      "work": "optional",
      "timeSeconds": 150
    },
    {
