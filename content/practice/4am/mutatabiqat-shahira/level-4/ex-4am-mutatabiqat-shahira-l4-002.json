        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تعرّف في $B$ على العبارة $A$ ."
        }
      ],
      "feedback": {
        "correct": "$B$ هو $A$ من أجل $x = 978654321$ ، إذن $B = 1$ .",
        "incorrect": "لاحظ أن $978654320 = x - 1$ و $978654322 = x + 1$ مع $x = 978654321$ ."
