      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "400",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ابحث عن قيمة $x$ التي يكون من أجلها $x + 1 = 101$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب القوى أولًا، ثم الجداءات، ثم الجمع والطرح."
        }
      ],
      "feedback": {
        "correct": "$101 \\times 109 - 103^2 = 4 \\times 100 = 400$ .",
        "incorrect": "عوّض $x$ في كل حد، واحترم أولويات العمليات والإشارات."
      },
      "solution": {
        "lines": [
          "من أجل $x = 100$ : $x + 1 = 101$ ، $x + 9 = 109$ ، $x + 3 = 103$",
          "إذن $101 \\times 109 - 103^2 = E = 4 \\times 100$"
        ],
        "result": "101 \\times 109 - 103^2 = 400"
      },
      "timeSeconds": 90
