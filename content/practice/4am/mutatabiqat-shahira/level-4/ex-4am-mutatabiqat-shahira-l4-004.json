      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد الذي تساويه $E_2$ بعد التبسيط",
      "expectedAnswer": "1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر بالمتطابقة الشهيرة المناسبة، وضع النشر بين قوسين إذا سبقته إشارة $-$ ."
        }
      ],
      "feedback": {
        "correct": "$E_2 = 1$ مهما كان $x$ .",
        "incorrect": "انشر حدًّا حدًّا، ثم احذف القوسين المسبوقين بإشارة $-$ بتغيير إشارات حدودهما."
      },
      "solution": {
        "lines": [
          "$E_2 = (x - 1)^2 - x(x - 2)$",
          "$E_2 = x^2 - 2 \\times x \\times 1 + 1^2 - \\left[x \\times x - x \\times 2\\right]$",
          "$E_2 = x^2 - 2x + 1 - (x^2 - 2x)$",
          "$E_2 = x^2 - 2x + 1 - x^2 + 2x$"
        ],
        "result": "E_2 = 1"
      },
      "work": "optional",
      "timeSeconds": 120
