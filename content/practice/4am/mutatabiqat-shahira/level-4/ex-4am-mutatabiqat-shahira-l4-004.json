          "content": "خمّن النتيجة انطلاقًا من السؤال (ا)، ثم تحقّق."
        }
      ],
      "feedback": {
        "correct": "$2019 \\times 2017 = 2018^2 - 1$ ، إذن النتيجة $1$ .",
        "incorrect": "اكتب $2019 \\times 2017$ على الشكل $(2018 + 1)(2018 - 1)$ ."
      },
      "solution": {
        "lines": [
          "$2019 \\times 2017 = (2018 + 1)(2018 - 1) = 2018^2 - 1$",
          "$2018^2 - 2019 \\times 2017 = 2018^2 - (2018^2 - 1)$"
        ],
        "result": "2018^2 - 2019 \\times 2017 = 1"
      },
      "timeSeconds": 90
