  "statement": {
    "content": "تنجز مؤسسة محطة للطاقة الشمسية بولاية أدرار على قطعة أرض مربعة الشكل طول ضلعها $x$ m ، حيث $x > 10$ . تُترك داخل القطعة، على طول حوافها الأربع، ممرات عرضها $5$ m ، وتُركَّب الألواح الشمسية على المربع الباقي في الوسط."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "عبّر بدلالة $x$ عن المساحة $S$ للمربع المخصّص للألواح على شكل مجموع مبسّط.",
      "statement": "العدد $m$ :",
      "learningPoints": [
        {
          "code": "4am_mutatabiqat-shahira_P2",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
