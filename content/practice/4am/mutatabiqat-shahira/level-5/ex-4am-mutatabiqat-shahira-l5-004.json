        {
          "value": "10001",
          "id": "MISC-HISAB-DHIHNI-MURABBA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اكتب العدد على شكل فرق عدد مدوّر وعدد صغير."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "طبّق $(a - b)^2 = a^2 - 2ab + b^2$ ، ولا تنسَ الحد المضاعف $2ab$ ."
        }
      ],
      "feedback": {
        "correct": "$99^2 = 9801$ .",
        "incorrect": "اكتب العدد بدلالة عدد مدوّر، ثم طبّق المتطابقة الشهيرة المناسبة حدًّا حدًّا."
      },
      "solution": {
        "lines": [
          "$99^2 = (100 - 1)^2$",
          "$= 100^2 - 2 \\times 100 \\times 1 + 1^2$",
          "$= 10000 - 200 + 1$"
        ],
        "result": "99^2 = 9801"
      },
