  "statement": {
    "content": "طلب صاحب مكتبة بالبليدة، يشجّع التلاميذ على القراءة، من مورّد $99$ علبة من الأقلام، في كل علبة $99$ قلمًا، ثمن القلم الواحد 25DA . اقترح عليه المورّد طلبية ثانية: $101$ علبة في كل منها $99$ قلمًا، بنفس ثمن القلم."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب ذهنيا (دون وضع العملية) عدد أقلام الطلبية الأولى $99^2$ .",
      "learningPoints": [
        {
          "code": "4am_mutatabiqat-shahira_P4",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
