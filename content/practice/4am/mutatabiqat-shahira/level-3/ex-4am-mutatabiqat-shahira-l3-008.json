        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $S$ على الشكل $mx^2 + nx + p$ : اكتب العدد $m$ فقط",
      "expectedAnswer": "4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "في كل خانة جداء حدّين: $x \\times x = x^2$ و $x \\times 1 = x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عُدّ الخانات التي فيها $x^2$ ، ثم التي فيها $x$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع الحدود المتشابهة."
        }
      ],
      "feedback": {
        "correct": "$S = 4x^2 + 4x + 1$ إذن $m = 4$ .",
        "incorrect": "طبّق المتطابقة الشهيرة حدًّا حدًّا (مربع كل حد والحد المضاعف)، ثم اجمع الحدود المتشابهة بإشاراتها."
      },
      "solution": {
        "lines": [
          "الخانات: $x^2$ ، $x^2$ ، $x$ ، $x^2$ ، $x^2$ ، $x$ ، $x$ ، $x$ ، $1$",
          "$S = x^2 + x^2 + x^2 + x^2 + x + x + x + x + 1$"
        ],
        "result": "S = 4x^2 + 4x + 1"
      },
      "work": "optional",
