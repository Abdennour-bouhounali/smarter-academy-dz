  "statement": {
    "content": "انقل المساويات الآتية وأتممها باستعمال المتطابقة $a^2 + 2ab + b^2 = (a + b)^2$ :",
    "formulas": [
      "x^2 + \\ldots x + \\ldots = (\\ldots + 3)^2",
      "9x^2 + \\ldots + 1 = (\\ldots + 1)^2",
      "\\ldots + 10x + 25 = (\\ldots + \\ldots)^2"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "أتمم المساواة الأولى: $x^2 + \\ldots x + \\ldots = (\\ldots + 3)^2$ .",
      "statement": "العدد الناقص أمام $x$ :",
      "learningPoints": [
        {
          "code": "4am_mutatabiqat-shahira_P1",
          "role": "primary"
