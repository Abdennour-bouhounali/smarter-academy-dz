      "counted": false,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$E$ فرق مربعين: $a^2 - b^2$ مع $a = 3x + 1$ و $b = x - 2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $a^2 - b^2 = (a + b)(a - b)$ ، وانتبه إلى القوسين عند الطرح."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات عند النشر."
      },
      "solution": {
        "lines": [
          "$E = (3x + 1)^2 - (x - 2)^2$",
          "$E = [(3x + 1) + (x - 2)][(3x + 1) - (x - 2)]$",
          "$E = (3x + 1 + x - 2)(3x + 1 - x + 2)$"
        ],
        "result": "E = (4x - 1)(2x + 3)"
      },
      "timeSeconds": 180
    },
