          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد",
      "expectedAnswer": "399",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العددان يحيطان بالعدد $20$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$21 = 20 + 1$ و $19 = 20 - 1$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "استعمل $(a + b)(a - b) = a^2 - b^2$."
        }
      ],
      "feedback": {
        "correct": "$(20 + 1)(20 - 1) = 400 - 1 = 399$",
        "incorrect": "اطرح مربع $1$ من مربع $20$."
      }
