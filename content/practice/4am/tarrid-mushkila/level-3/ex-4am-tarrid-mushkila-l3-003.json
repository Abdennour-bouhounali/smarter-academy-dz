          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد طبيعي: المدة بالسنوات",
      "expectedAnswer": "60",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "المدة المقرّرة كلها = المدة المنقضية + 4 سنوات + المدة المتبقية."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "75% من $D$ تُكتب $0{,}75D$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع حدود $D$ في طرف واحد ثم حلّ."
        }
      ],
      "feedback": {
        "correct": "$0{,}75D + 4 + 11 = D$ تعطي $D = 60$ سنة.",
        "incorrect": "الأجزاء الثلاثة (المنقضي، 4 سنوات، المتبقي) مجموعها المدة المقرّرة كلها."
      },
      "solution": {
        "lines": [
          "المعادلة: $0{,}75D + 4 + 11 = D$",
          "$15 = D - 0{,}75D$",
          "$15 = 0{,}25D$",
          "$D = \\dfrac{15}{0{,}25}$",
          "$D = 60$",
          "إذن المدة المقرّرة لبناء السدّ 60 سنة."
        ],
        "result": "D = 60"
      },
