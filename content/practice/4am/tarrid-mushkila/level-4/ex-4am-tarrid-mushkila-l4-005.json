          "type": "look",
          "content": "انشر $1500(800 - x)$ : ما هو الحد الثابت؟"
        }
      ],
      "feedback": {
        "correct": "$C = -600x + 1200000$ .",
        "incorrect": "الحد الثابت يأتي من نشر $1500(800 - x)$ ."
