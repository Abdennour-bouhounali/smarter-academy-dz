  "statement": {
    "content": "خصّصت بلدية بولاية سكيكدة، حفاظًا على البيئة ونظافتها، مبلغ 960000DA لتهيئة حديقة عمومية مساحتها $800m^2$ : جزء منها يُزرع عشبًا طبيعيًا تكلفة المتر المربع منه 900DA ، و الجزء الباقي يُبلّط تكلفة المتر المربع منه 1500DA .\nنسمّي $x$ مساحة الجزء المزروع عشبًا (بـ $m^2$)."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "عبّر بدلالة $x$ عن التكلفة الإجمالية $C$ للتهيئة على الشكل $C = ax + b$ .",
      "statement": "أعط العدد $a$ .",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (قد يكون سالبًا)",
      "expectedAnswer": "-600",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عبّر بدلالة $x$ عن مساحة الجزء المبلّط."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "التكلفة = $900x + 1500 \\times$ (مساحة الجزء المبلّط)، ثم انشر وبسّط."
        }
      ],
      "feedback": {
        "correct": "$a = -600$ .",
        "incorrect": "مساحة الجزء المبلّط هي $800 - x$ ؛ انشر ثم اجمع حدود $x$ ."
      },
      "solution": {
        "lines": [
          "مساحة الجزء المبلّط: $800 - x$",
          "$C = 900x + 1500(800 - x)$",
          "$C = 900x + 1200000 - 1500x$",
          "$C = -600x + 1200000$"
        ],
        "result": "C = -600x + 1200000"
      },
      "timeSeconds": 240
    },
