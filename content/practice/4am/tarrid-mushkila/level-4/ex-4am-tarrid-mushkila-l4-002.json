  "statement": {
    "content": "من الكتاب (ص 53): ABCD مربع ضلعه 8cm ، والنقاط E ، F ، G ، H على أضلاعه بحيث $AH = BE = CF = DG = x$ ، و EFGH مربع. نريد أن تكون مساحة EFGH تساوي $34cm^2$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "مساحة المربع EFGH بدلالة $x$ هي:",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$2x^2 - 16x + 64$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$4x^2 - 32x + 64$",
          "isCorrect": false
        },
        {
          "id": "C",
          "content": "$64 - x^2$",
          "isCorrect": false
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "مساحة EFGH = مساحة ABCD − مساحة المثلثات الأربعة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "كل مثلث قائم ضلعاه $x$ و $8 - x$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "مساحة المثلث القائم نصف جداء ضلعي القائمة."
        }
      ],
      "feedback": {
        "correct": "$64 - 4 \\times \\dfrac{x(8 - x)}{2} = 2x^2 - 16x + 64$ .",
        "incorrect": "لا تنسَ القسمة على 2 في مساحة المثلث."
      }
    },
    {
      "id": "q2",
      "statement": "قيم $x$ التي تجعل المساحة $34cm^2$ :",
