      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "مساحة $EFGH$ = مساحة $ABCD$ ناقص مساحات المثلثات الأربعة في الأركان."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "كل مثلث قائم ضلعاه القائمان $x$ و $8 - x$ ."
