      "id": "q1",
      "step": "01",
      "statement": "بيّن أن مساحة المستطيل $AEFG$ تُكتب: $x^2 - 5x - 24$ .",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عبّر بدلالة $x$ عن الطولين $AE$ و $AG$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "مساحة المستطيل = $AE \\times AG$ ، ثم انشر."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك بالحل النموذجي سطرًا سطرًا، ثم أعد كتابته."
      },
      "solution": {
        "lines": [
          "$AE = AB + BE = x + 3$ و $AG = AD - GD = x - 8$ .",
          "مساحة $AEFG$ : $(x + 3)(x - 8)$",
          "$= x^2 - 8x + 3x - 24$",
          "$= x^2 - 5x - 24$"
        ],
        "result": "x^2 - 5x - 24"
      },
      "timeSeconds": 300
    },
