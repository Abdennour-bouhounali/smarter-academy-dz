      "answerFormat": "عدد طبيعي: عدد السنوات (اكتب معادلتك في «مراحل الحساب»)",
      "expectedAnswer": "9",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "سمِّ $x$ عدد السنوات: كل شخص من الأربعة يكبر بـ $x$ سنة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بعد $x$ سنة: عمر الأب $36 + x$ ، وعمر كل ابن يزيد بـ $x$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "مجموع أعمار الأبناء يزيد إذن بـ $3x$ : اكتب المعادلة ثم حلّها."
        }
      ],
      "feedback": {
        "correct": "$36 + x = (4 + x) + (6 + x) + (8 + x)$ تعطي $x = 9$ .",
        "incorrect": "كل ابن يكبر بـ $x$ سنة، فمجموع أعمار الأبناء الثلاثة يزيد بـ $3x$ لا بـ $x$ ."
      },
      "solution": {
        "lines": [
          "نسمّي $x$ عدد السنوات.",
          "بعد $x$ سنة: عمر الأب $36 + x$ ، ومجموع أعمار الأبناء $(4 + x) + (6 + x) + (8 + x)$ .",
          "المعادلة: $36 + x = (4 + x) + (6 + x) + (8 + x)$",
          "$36 + x = 18 + 3x$",
          "$36 - 18 = 3x - x$",
          "$18 = 2x$",
          "$x = 9$",
          "إذن بعد 9 سنوات."
        ],
        "result": "x = 9"
      },
      "work": "required",
      "timeSeconds": 300
    },
