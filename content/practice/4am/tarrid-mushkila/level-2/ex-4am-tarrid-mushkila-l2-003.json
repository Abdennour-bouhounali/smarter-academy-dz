          "id": "h1",
          "type": "look",
          "content": "سمِّ $x$ عدد السنوات: الأب والابنان يكبرون معًا."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بعد $x$ سنة: مجموع عمري الابنين $(4 + x) + (7 + x)$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "«ضعف المجموع»: ضع المجموع كله بين قوسين ثم اضربه في 2 ."
        }
      ],
      "feedback": {
        "correct": "$43 + x = 2[(4 + x) + (7 + x)]$ تعطي $x = 7$ .",
        "incorrect": "كل ابن يكبر بـ $x$ سنة، والضعف يشمل المجموع كله."
      },
      "solution": {
        "lines": [
          "نسمّي $x$ عدد السنوات.",
          "المعادلة: $43 + x = 2[(4 + x) + (7 + x)]$",
          "$43 + x = 2(11 + 2x)$",
          "$43 + x = 22 + 4x$",
          "$43 - 22 = 4x - x$",
          "$21 = 3x$",
          "$x = 7$"
        ],
        "result": "x = 7"
      },
      "work": "optional",
      "timeSeconds": 240
