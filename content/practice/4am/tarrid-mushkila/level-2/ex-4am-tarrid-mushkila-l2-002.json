  "statement": {
    "content": "من الكتاب (ص 53): إليك برنامج حساب. • اختر عددا. • اضربه في 3 • أضف له 5. نسمّي $x$ العدد المختار."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "ما العدد الذي ينبغي اختياره للحصول في النتيجة على 32؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P2",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "9",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "نتيجة البرنامج هي $3x + 5$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "حلّ $3x + 5 = 32$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "تحقّق بتطبيق البرنامج."
        }
      ],
      "feedback": {
        "correct": "$3x = 27$ أي $x = 9$ ، و $3 \\times 9 + 5 = 32$ .",
        "incorrect": "اطرح 5 ثم اقسم على 3."
      }
    },
    {
