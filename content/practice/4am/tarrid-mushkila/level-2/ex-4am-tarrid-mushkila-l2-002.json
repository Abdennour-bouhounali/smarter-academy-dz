  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "ما هو العدد الذي ينبغي اختياره للحصول في النتيجة على 32 ؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد: العدد المختار",
      "expectedAnswer": "9",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "سمِّ $x$ العدد المختار وعبّر عن النتيجة بدلالة $x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "النتيجة هي $3x + 5$ : اجعلها تساوي العدد المطلوب."
        }
      ],
      "feedback": {
        "correct": "$3x + 5 = 32$ تعطي $x = 9$ .",
        "incorrect": "طبّق خطوات البرنامج بالترتيب على $x$ ، ثم حلّ المعادلة."
      },
      "solution": {
        "lines": [
          "نسمّي $x$ العدد المختار، فتكون النتيجة $3x + 5$ .",
          "$3x + 5 = 32$",
          "$3x = 27$",
          "$x = 9$"
        ],
        "result": "x = 9"
      },
      "work": "optional",
      "timeSeconds": 150
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "ما هو العدد الذي ينبغي اختياره لتكون النتيجة ضعف العدد المختار؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد صحيح (قد يكون سالبًا)",
      "expectedAnswer": "-5",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ضعف العدد المختار هو $2x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب «النتيجة = ضعف العدد المختار» ثم حلّ."
        }
      ],
      "feedback": {
        "correct": "$3x + 5 = 2x$ تعطي $x = -5$ ، والتحقق: $3 \\times (-5) + 5 = -10 = 2 \\times (-5)$ .",
        "incorrect": "الطرف الثاني هو ضعف العدد المختار، لا ضعف النتيجة."
      },
      "solution": {
        "lines": [
          "$3x + 5 = 2x$",
          "$3x - 2x = -5$",
          "$x = -5$",
          "التحقق: $3 \\times (-5) + 5 = -10$ و $2 \\times (-5) = -10$ ."
        ],
        "result": "x = -5"
      },
