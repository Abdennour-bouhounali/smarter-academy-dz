      "feedback": {
        "correct": "المعادلة $6x + 7 = 31$ ، وحلها $x = 4$ : العدد المطلوب هو 4 .",
        "incorrect": "تتبّع ترتيب العمليات في النص: الضرب أولًا، ثم الإضافة."
      },
      "solution": {
        "lines": [
          "نسمّي $x$ العدد المطلوب.",
          "ضربه في 6 يعطي $6x$ ، ثم إضافة 7 إلى الناتج تعطي $6x + 7$ .",
          "المعادلة: $6x + 7 = 31$",
          "$6x = 31 - 7$",
          "$6x = 24$",
          "$x = \\dfrac{24}{6}$",
          "$x = 4$",
          "التحقق: $6 \\times 4 + 7 = 24 + 7 = 31$ .",
          "إذن العدد المطلوب هو 4 ."
        ],
