  "statement": {
    "content": "من الكتاب (ص 51): ABCD مستطيل عرضه $BC = 3cm$ وطوله $DC = x$ (بالسنتيمتر). نريد أن يكون محيطه أكبر من أو يساوي 40cm."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "عبّر عن محيطه P بدلالة $x$ .",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$P = x + 3$",
          "isCorrect": false
        },
        {
          "id": "B",
          "content": "$P = 2x + 6$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$P = 2x + 3$",
          "isCorrect": false
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "للمستطيل طولان وعرضان."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "المحيط هو ضعف مجموع الطول والعرض."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انشر $2(x + 3)$ ."
        }
      ],
      "feedback": {
        "correct": "$P = 2(x + 3) = 2x + 6$ .",
        "incorrect": "لا تنسَ أنّ للمستطيل طولين وعرضين."
      }
    },
    {
      "id": "q2",
      "statement": "ما القيم التي يمكن أن يأخذها $x$ ؟",
