  "statement": {
    "content": "يُحسب المعدّل الفصلي $m$ لتلميذ في مادة الرياضيات، علامة فرضه $f$ و علامة اختباره $e$ ، بالعلاقة:",
    "formulas": [
      "m = \\dfrac{f + 2e}{3}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "تحصّل سليم على 11 في الفرض. ما هي العلامة التي يجب أن يتحصّل عليها في الاختبار ليكون معدّله الفصلي 13 ؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد: علامة الاختبار (من 20)",
      "expectedAnswer": "14",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $m$ و $f$ بقيمتيهما في العلاقة: يبقى مجهول واحد $e$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب الطرفين في 3 للتخلّص من المقام."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "ثم اطرح علامة الفرض من الطرفين واقسم على 2 ."
        }
