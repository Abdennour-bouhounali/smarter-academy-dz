  "statement": {
    "content": "من الكتاب (ص 53، بعد تصحيح الوحدة في الشكل): ABCD مربع ضلعه $x$ (الوحدة 1cm)، E على امتداد [AB] بحيث $BE = 3cm$ ، و G على [AD] بحيث $GD = 8cm$ . المستطيل الملوّن AEFG مساحته $60cm^2$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "مساحة المستطيل الملوّن بدلالة $x$ :",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(x + 3)(x + 8)$",
          "isCorrect": false
        },
        {
          "id": "B",
          "content": "$(x + 3)(x - 8)$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$x(x - 8) + 3$",
          "isCorrect": false
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "بعدا المستطيل؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$AE = x + 3$ و $AG = x - 8$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "المساحة جداء البعدين."
        }
      ],
      "feedback": {
        "correct": "$(x + 3)(x - 8) = x^2 - 5x - 24$ .",
        "incorrect": "$AG = AD - GD = x - 8$ ."
      }
    },
    {
      "id": "q2",
      "statement": "عيّن قيمة $x$ (بالسنتيمتر).",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P2",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "12",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اكتب $x^2 - 5x - 24 = 60$ أي $(x - 12)(x + 7) = 0$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "جداء معدوم: حلّان."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "أيّهما يلائم طول ضلع؟"
        }
      ],
      "feedback": {
        "correct": "$x = 12$ ($-7$ مرفوض)، و $15 \\times 4 = 60$ .",
        "incorrect": "احتفظ بالحل الذي يجعل البعدين موجبين."
      }
    },
    {
      "id": "q3",
      "statement": "لماذا نرفض $x = -7$ ؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-mushkila_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "لأن $-7$ لا يحقّق المعادلة.",
          "isCorrect": false,
          "misconceptionId": "MISC-TARRID-TAHAQQUQ"
        },
        {
          "id": "B",
          "content": "لأن معادلة الجداء المعدوم لها حلّ واحد فقط.",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-HAL-WAHID"
        },
        {
          "id": "C",
          "content": "لأن $x$ طول ضلع، فيجب أن يكون موجبًا وأن يكون $x - 8 > 0$ .",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $-7$ في المعادلة: هل تتحقّق؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الحل صحيح رياضيًا، لكن ماذا يمثّل $x$ ؟"
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "طول ضلع لا يكون سالبًا."
        }
      ],
      "feedback": {
        "correct": "$-7$ يحقّق المعادلة، لكنه لا يلائم الشكل: الطول موجب و $x > 8$ .",
        "incorrect": "$(-7 + 3)(-7 - 8) = 60$ صحيحة: السبب هو الواقع لا الحساب."
      }
    }
  ]
