      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "قارن النسبة $k = \\dfrac{3}{5}$ بالعدد 1."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "إذا كان $k > 1$ فهو تكبير، وإذا كان $0 < k < 1$ فهو تصغير."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اضرب طولا، مثلا $AB = 5$ ، في $\\dfrac{3}{5}$ : هل يكبر أم يصغر؟"
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{3}{5} < 1$ : $AB = 5$ يصير $A'B' = 3$ ، فالمجسّم يصغر.",
