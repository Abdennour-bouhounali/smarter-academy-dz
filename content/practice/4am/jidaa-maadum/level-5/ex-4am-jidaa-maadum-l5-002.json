  "statement": {
    "content": "من الكتاب (ص 43): جاء في كتاب الخوارزمي: «مال وواحد وعشرون من العدد يعدل 10 أجذاره»، وبالرموز الحالية: $x^2 + 21 = 10x$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "هذه المعادلة تكافئ:",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(x - 3)(x - 7) = 0$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$(x + 3)(x + 7) = 0$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        },
        {
          "id": "C",
          "content": "$(x - 1)(x - 21) = 0$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اجعل الطرف الثاني $0$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ابحث عن جداء ينشر على الشكل $x^2 - 10x + 21$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انشر كل اقتراح وقارن."
        }
      ],
      "feedback": {
        "correct": "$x^2 - 10x + 21 = 0$ و $(x - 3)(x - 7) = x^2 - 10x + 21$ .",
        "incorrect": "لا تقسم الطرفين على عبارة قد تكون معدومة: انقل ثم حلّل."
      }
    },
