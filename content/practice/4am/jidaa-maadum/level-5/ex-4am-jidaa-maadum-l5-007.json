  "questions": [
    {
      "id": "q1",
      "statement": "لحلّ $x^2 = 5x$ قسم التلميذ الأول الطرفين على $x$ فوجد $x = 5$ فقط. ما الصحيح؟",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "ضيّع الحل 0: $x(x - 5) = 0$ يعطي $0$ و $5$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "لا خطأ: الحل الوحيد 5",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-QISMA-ALA-X"
        },
        {
          "id": "C",
          "content": "الحل الصحيح $-5$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x = 0$ في المعادلة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "القسمة على $x$ ممنوعة إذا كان $x$ قد يساوي 0."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انقل ثم حلّل."
        }
      ],
      "feedback": {
        "correct": "$x^2 - 5x = x(x - 5) = 0$ : الحلّان 0 و 5، و $0^2 = 5 \\times 0$ .",
        "incorrect": "لا تقسم الطرفين على عبارة قد تكون معدومة: انقل ثم حلّل."
      }
    },
    {
      "id": "q2",
      "statement": "كتب التلميذ الثاني: $(x + 1)(x - 2) = 10$ يعني $x + 1 = 10$ أو $x - 2 = 10$ . هل استنتاجه صحيح؟",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "لا: خاصية الجداء المعدوم تخصّ جداءً يساوي 0",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "نعم: هي خاصية الجداء المعدوم",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-GHAYR-SIFR"
        }
      ],
      "hints": [
