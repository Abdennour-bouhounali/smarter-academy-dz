      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $(x - 8)^2 - 144$ على الشكل $(x - 20)(x + m)$ : اكتب العدد $m$ فقط",
      "expectedAnswer": "4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اقسم طرفي المعادلة على $4$ ، ثم اكتب $144$ على شكل مربع عدد."
