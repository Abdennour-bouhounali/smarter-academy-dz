        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل المتطابقة $a^2 - b^2 = (a - b)(a + b)$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "بسّط ما داخل كل قوس، ثم قارن بالشكل المطلوب."
        }
      ],
      "feedback": {
        "correct": "$(x - 8)^2 - 144 = (x - 20)(x + 4)$ إذن $m = 4$ .",
