  "statement": {
    "content": "من الكتاب (ص 43): $x$ يُمثل طول ضلع المربع AEGF، والمربع ABCD ضلعه $x + 6$ (المستطيلان EBHG و FGKD بعدا كل منهما $x$ و 6، والمربع GHCK ضلعه 6). عيّن قيمة $x$ علمًا أنّ $x^2 + 12x = 85$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "بما أنّ $(x + 6)^2 = x^2 + 12x + 36$ ، ما قيمة $(x + 6)^2$ ؟",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "121",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "مساحة ABCD = المربع AEGF + المستطيلان + المربع GHCK."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$x^2 + 12x$ معلومة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "أضف مساحة الركن $6 \\times 6$."
        }
      ],
      "feedback": {
        "correct": "$(x + 6)^2 = 85 + 36 = 121$ : مساحة المربع ABCD.",
        "incorrect": "تعرّف على المتطابقة ثم طبّق الخاصية، وعوّض كل حلّ لتتحقّق."
      }
