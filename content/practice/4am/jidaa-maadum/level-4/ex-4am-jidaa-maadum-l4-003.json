  "statement": {
    "content": "من الكتاب (ص 51): $p = (x^2 + 10x + 25) - (x^2 - 25)$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "تحليل p:",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$-10(x + 5)$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        },
        {
          "id": "B",
          "content": "$10(x + 5)$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$2x(x + 5)$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$x^2 + 10x + 25 = (x + 5)^2$ و $x^2 - 25 = (x - 5)(x + 5)$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "العامل المشترك هو $(x + 5)$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب $(x + 5) - (x - 5)$ بعناية."
        }
      ],
      "feedback": {
        "correct": "$p = (x + 5)^2 - (x - 5)(x + 5) = (x + 5)[(x + 5) - (x - 5)] = 10(x + 5)$ .",
        "incorrect": "تعرّف على المتطابقة ثم طبّق الخاصية، وعوّض كل حلّ لتتحقّق."
      }
    },
    {
      "id": "q2",
      "statement": "حلول المعادلة $p = 0$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
