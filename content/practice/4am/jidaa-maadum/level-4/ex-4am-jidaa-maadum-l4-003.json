        },
        {
          "id": "B",
          "content": "$-5$ فقط",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$-5$ و $5$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-HAL-WAHID"
        },
        {
          "id": "D",
          "content": "$-5$ و $10$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-AMIL-THABIT"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "أحد العاملين عدد ثابت."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عامل ثابت غير معدوم لا ينعدم أبدًا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "يكفي أن تحلّ المعادلة: العامل الآخر يساوي $0$."
        }
      ],
      "feedback": {
        "correct": "$10(x + 5) = 0$ و $10 \\neq 0$ ، إذن $x = -5$ : حلّ واحد.",
        "incorrect": "العامل الثابت لا يعطي حلًّا: عوّض اقتراحك وتحقّق أنّ الجداء يساوي $0$."
      }
    }
