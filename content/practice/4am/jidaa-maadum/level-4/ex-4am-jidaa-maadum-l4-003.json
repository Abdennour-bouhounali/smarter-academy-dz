      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $p$ على الشكل $k(x + 5)$ : اكتب العدد $k$ فقط",
      "expectedAnswer": "10",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "حلّل $x^2 - 25$ أيضًا: يظهر العامل $(x + 5)$ في الحدّين."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "أخرج العامل المشترك، ثم بسّط ما بقي: تتلاشى حدود $x$ ."
        }
      ],
      "feedback": {
        "correct": "$p = 10(x + 5)$ إذن $k = 10$ .",
        "incorrect": "أخرج العامل المشترك أو طبّق المتطابقة الشهيرة، ثم بسّط ما بقي بين القوسين بإشاراته."
      },
      "solution": {
        "lines": [
          "$x^2 - 25 = (x - 5)(x + 5)$",
          "$p = (x + 5)^2 - (x - 5)(x + 5)$",
          "$= (x + 5)[(x + 5) - (x - 5)]$",
          "$= (x + 5)(x + 5 - x + 5)$"
        ],
        "result": "p = 10(x + 5)"
      },
      "work": "optional",
      "timeSeconds": 180
    },
