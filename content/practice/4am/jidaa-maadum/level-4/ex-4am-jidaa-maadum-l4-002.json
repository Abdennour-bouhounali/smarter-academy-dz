  "statement": {
    "content": "من الكتاب (ص 50): $p = (9x^2 - 1) + 6x^2 + 7x - 3$ ، و $(3x - 1)(2x + 3) = 6x^2 + 7x - 3$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "تحليل $9x^2 - 1$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(9x - 1)(9x + 1)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        },
        {
          "id": "B",
          "content": "$(3x - 1)(3x + 1)$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$(3x - 1)^2$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$9x^2 = (3x)^2$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "العبارة من الشكل $a^2 - b^2$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "عيّن $a$ و $b$ ثم استعمل $(a - b)(a + b)$."
        }
      ],
      "feedback": {
        "correct": "$9x^2 - 1 = (3x)^2 - 1^2 = (3x - 1)(3x + 1)$ .",
        "incorrect": "تعرّف على المتطابقة ثم طبّق الخاصية، وعوّض كل حلّ لتتحقّق."
      }
    },
    {
      "id": "q2",
      "statement": "تحليل p إلى جداء عاملين من الدرجة الأولى:",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(3x - 1)(5x + 4)$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$(3x - 1)(x - 2)$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        },
        {
          "id": "C",
          "content": "$(3x + 1)(5x + 4)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض كل جزء من p بتحليله."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "يظهر العامل المشترك $(3x - 1)$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع ما بقي: $(3x + 1) + (2x + 3)$."
        }
      ],
      "feedback": {
        "correct": "$p = (3x - 1)(3x + 1) + (3x - 1)(2x + 3) = (3x - 1)(5x + 4)$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    },
    {
      "id": "q3",
      "statement": "حلول المعادلة $p = 0$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\dfrac{4}{5}$ و $-\\dfrac{1}{3}$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        },
        {
          "id": "B",
          "content": "$\\dfrac{1}{3}$ فقط",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-HAL-WAHID"
        },
        {
          "id": "C",
          "content": "$-\\dfrac{5}{4}$ و $3$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-QISMA-MAQLUBA"
        },
        {
          "id": "D",
          "content": "$-\\dfrac{4}{5}$ و $\\dfrac{1}{3}$",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الطرف الثاني $0$ ، لكن الطرف الأول ليس جداءً بعد."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ابحث عن عامل مشترك بين الحدود."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّل الطرف الأول، ثم طبّق خاصية الجداء المعدوم."
        }
      ],
      "feedback": {
        "correct": "$3x - 1 = 0$ أو $5x + 4 = 0$ ، أي $x = \\dfrac{1}{3}$ أو $x = -\\dfrac{4}{5}$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    }
  ]
}
