  "statement": {
    "content": "من الكتاب (ص 51): $(2x - 1)^2 - 81 = 4x^2 - 4x - 80$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "تحليل $A = 4x^2 - 4x - 80$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(2x - 82)(2x + 80)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        },
        {
          "id": "B",
          "content": "$(2x - 10)(2x + 8)$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$(2x - 9)(2x + 9)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اكتب $A = (2x - 1)^2 - 81$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$81 = 9^2$ : العبارة من الشكل $a^2 - b^2$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$a = 2x - 1$ و $b = 9$."
        }
      ],
      "feedback": {
        "correct": "$A = (2x - 1)^2 - 9^2 = (2x - 1 - 9)(2x - 1 + 9) = (2x - 10)(2x + 8)$ .",
        "incorrect": "تعرّف على المتطابقة ثم طبّق الخاصية، وعوّض كل حلّ لتتحقّق."
      }
    },
    {
      "id": "q2",
      "statement": "حلول المعادلة $4x^2 - 4x - 80 = 0$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$5$ فقط",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-HAL-WAHID"
        },
        {
          "id": "B",
          "content": "$-8$ و $10$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-TARH-MUAMIL"
        },
        {
          "id": "C",
          "content": "$-4$ و $5$",
          "isCorrect": true
        },
        {
          "id": "D",
          "content": "$4$ و $-5$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الطرف الأول يشبه أحد أطراف متطابقة شهيرة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تذكّر: $a^2 - b^2 = (a - b)(a + b)$ و $a^2 \\pm 2ab + b^2 = (a \\pm b)^2$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّل بالمتطابقة، ثم طبّق خاصية الجداء المعدوم."
        }
      ],
      "feedback": {
        "correct": "$2x - 10 = 0$ أو $2x + 8 = 0$ ، أي $x = 5$ أو $x = -4$ .",
        "incorrect": "تعرّف على المتطابقة ثم طبّق الخاصية، وعوّض كل حلّ لتتحقّق."
      }
    }
  ]
}
