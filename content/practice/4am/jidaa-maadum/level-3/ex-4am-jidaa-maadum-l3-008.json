  "statement": {
    "content": "من الكتاب (ص 47): $F = (1 - 2x)(4x - 3) - 3(4x - 3)$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "تحليل F إلى جداء عاملين من الدرجة الأولى:",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$(4x - 3)(4 - 2x)$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        },
        {
          "id": "B",
          "content": "$(4x - 3)(-6x)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        },
        {
          "id": "C",
          "content": "$(4x - 3)(-2x - 2)$",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العامل المشترك للجداءين قوس."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "هو $(4x - 3)$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "داخل القوس الكبير: $(1 - 2x) - 3$."
        }
      ],
      "feedback": {
        "correct": "$F = (4x - 3)[(1 - 2x) - 3] = (4x - 3)(-2x - 2)$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    },
    {
      "id": "q2",
      "statement": "حلول المعادلة $F = 0$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$-1$ و $\\dfrac{4}{3}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-QISMA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$-1$ و $\\dfrac{3}{4}$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$1$ و $-\\dfrac{3}{4}$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        },
        {
          "id": "D",
          "content": "$\\dfrac{3}{4}$ فقط",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-HAL-WAHID"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الطرف الثاني $0$ ، لكن الطرف الأول ليس جداءً بعد."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ابحث عن عامل مشترك بين الحدود."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّل الطرف الأول، ثم طبّق خاصية الجداء المعدوم."
        }
      ],
      "feedback": {
        "correct": "$4x - 3 = 0$ أو $-2x - 2 = 0$ ، أي $x = \\dfrac{3}{4}$ أو $x = -1$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    }
  ]
