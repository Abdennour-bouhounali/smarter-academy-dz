      "counted": false,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "يُكتب $6x^2 - 3x$ على الشكل $3x(2x - m)$ : اكتب العدد $m$ فقط",
      "expectedAnswer": "1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ابحث عن عامل مشترك، أو عن متطابقة شهيرة من الشكل $a^2 - b^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "أخرج العامل المشترك (أو طبّق $a^2 - b^2 = (a - b)(a + b)$ )، واكتب ما بقي بين قوسين."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "بسّط ما بين القوسين بإشاراته، ثم قارن بالشكل المطلوب."
        }
      ],
      "feedback": {
        "correct": "$6x^2 - 3x = 3x(2x - 1)$ إذن $m = 1$ .",
        "incorrect": "أخرج العامل المشترك أو طبّق المتطابقة الشهيرة، ثم بسّط ما بقي بين القوسين بإشاراته."
      },
      "solution": {
        "lines": [
          "$6x^2 - 3x = 3x \\times 2x - 3x \\times 1$"
        ],
        "result": "6x^2 - 3x = 3x(2x - 1)"
      },
