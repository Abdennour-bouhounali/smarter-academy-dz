  "statement": {
    "content": "من الكتاب (ص 50): 1) حلّل إلى جداء عاملين العبارة $6x^2 - 3x$ . 2) حل المعادلة $6x^2 - 3x = 0$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "تحليل $6x^2 - 3x$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$3x(2x - 3)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        },
        {
          "id": "B",
          "content": "$3x(x - 1)$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-NASHR-AWWALAN"
        },
        {
          "id": "C",
          "content": "$3x(2x - 1)$",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$6x^2 = 3x \\times 2x$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$3x = 3x \\times 1$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "استخرج العامل المشترك $3x$."
        }
      ],
      "feedback": {
        "correct": "$6x^2 - 3x = 3x \\times 2x - 3x \\times 1 = 3x(2x - 1)$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    },
    {
      "id": "q2",
      "statement": "حلول المعادلة $6x^2 - 3x = 0$ :",
      "learningPoints": [
        {
          "code": "4am_jidaa-maadum_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$0$ و $2$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-QISMA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$-\\dfrac{1}{2}$ و $0$",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-ISHARA-JADHR"
        },
        {
          "id": "C",
          "content": "$0$ و $\\dfrac{1}{2}$",
          "isCorrect": true
        },
        {
          "id": "D",
          "content": "$\\dfrac{1}{2}$ فقط",
          "isCorrect": false,
          "misconceptionId": "MISC-JIDAA-QISMA-ALA-X"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الطرف الثاني $0$ ، لكن الطرف الأول ليس جداءً بعد."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ابحث عن عامل مشترك بين الحدود."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّل الطرف الأول، ثم طبّق خاصية الجداء المعدوم."
        }
      ],
      "feedback": {
        "correct": "$3x(2x - 1) = 0$ يعني $x = 0$ أو $x = \\dfrac{1}{2}$ .",
        "incorrect": "حلّل أولًا ثم طبّق الخاصية، وعوّض كل حلّ في المعادلة لتتحقّق."
      }
    }
  ]
