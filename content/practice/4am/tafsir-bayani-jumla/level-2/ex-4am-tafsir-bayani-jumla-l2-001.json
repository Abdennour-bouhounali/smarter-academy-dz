  "statement": {
    "content": "في صندوق القسم قطع نقدية من فئتي 100DA و 200DA مبلغها 5000DA. نسمّي $x$ عدد قطع 100DA و $y$ عدد قطع 200DA، فيُترجم المبلغ بالمعادلة:",
    "formulas": [
      "100x + 200y = 5000"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "اكتب هذه المعادلة على الشكل $y = ax + b$ .",
      "statement": "أعط العدد $a$ :",
      "learningPoints": [
        {
          "code": "4am_tafsir-bayani-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد صحيح، أو عشري بالفاصلة، أو كسر a/b)",
      "expectedAnswer": "-0,5",
      "misconceptionSignatures": [
        {
          "value": "0,5",
          "id": "MISC-JUMLA-ISHARA-Y"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "المعادلة من الشكل $ax + by = c$ : نريد أن يبقى $y$ وحده في طرف."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "انقل حدّ $x$ إلى الطرف الثاني مع تغيير إشارته."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "ثم اقسم كل الحدود على معامل $y$ ."
        }
      ],
      "feedback": {
        "correct": "$a = -0{,}5$ : معامل $x$ بعد عزل $y$ .",
        "incorrect": "انقل حدّ $x$ بتغيير إشارته، ثم اقسم الطرفين على معامل $y$ (بإشارته)."
      },
      "solution": {
        "lines": [
          "$100x + 200y = 5000$",
          "$200y = -100x + 5000$",
          "نقسم كل الحدود على $200$ :",
          "$y = -0{,}5x + 25$",
          "إذن: $a = -0{,}5$ و $b = 25$ ."
        ],
        "result": "y = -0{,}5x + 25"
      },
