      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد صحيح، أو عشري بالفاصلة، أو كسر a/b)",
      "expectedAnswer": "2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$f(x) = ax + b$ مع $f(-1) = -3$ و $f(1) = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "معامل التوجيه هو تغيّر الترتيب مقسوما على تغيّر الفاصلة."
        }
      ],
      "feedback": {
        "correct": "$a = \\dfrac{1 - (-3)}{1 - (-1)}$ .",
