      "id": "q1",
      "statement": "حلّ المتراجحة $-7x + 1 < x - 3$ .",
      "learningPoints": [
        {
          "code": "4am_mutarajiha-ula_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$x > \\dfrac{1}{2}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$x < \\dfrac{1}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTARAJIHA-SALIB-BILA-QALB"
        },
        {
          "id": "C",
          "content": "$x > -\\dfrac{1}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ننقل حدود $x$ إلى طرف والأعداد إلى الطرف الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الإضافة أو الطرح من الطرفين لا تغيّر الاتجاه."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "في الأخير نقسم على معامل $x$ : انظر إلى إشارته قبل أن تكتب الاتجاه."
        }
      ],
      "feedback": {
        "correct": "$-7x + 1 < x - 3$ تؤول إلى $-8x < -4$، ثم نقسم على $-8$ (عدد سالب، فنغيّر الاتجاه): $x > \\dfrac{1}{2}$.",
        "incorrect": "راجع كل خطوة: هل أجريت العملية نفسها على الطرفين؟ وهل غيّرت الاتجاه عند الضرب أو القسمة على عدد سالب فقط؟"
      }
    },
