  "questions": [
    {
      "id": "q1",
      "statement": "حلّ المتراجحة $\\dfrac{5}{2}x - \\dfrac{1}{3} > 0$ .",
      "learningPoints": [
        {
          "code": "4am_mutarajiha-ula_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$x > \\dfrac{5}{6}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-QISMA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$x > \\dfrac{2}{15}$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$x < \\dfrac{2}{15}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTARAJIHA-QALB-ZAID"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ننقل حدود $x$ إلى طرف والأعداد إلى الطرف الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الإضافة أو الطرح من الطرفين لا تغيّر الاتجاه."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "في الأخير نقسم على معامل $x$ : انظر إلى إشارته قبل أن تكتب الاتجاه."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{5}{2}x - \\dfrac{1}{3} > 0$ تؤول إلى $\\dfrac{5}{2}x > \\dfrac{1}{3}$، ثم نقسم على $\\dfrac{5}{2}$ (عدد موجب، فالاتجاه لا يتغيّر): $x > \\dfrac{2}{15}$.",
        "incorrect": "راجع كل خطوة: هل أجريت العملية نفسها على الطرفين؟ وهل غيّرت الاتجاه عند الضرب أو القسمة على عدد سالب فقط؟"
      }
    },
