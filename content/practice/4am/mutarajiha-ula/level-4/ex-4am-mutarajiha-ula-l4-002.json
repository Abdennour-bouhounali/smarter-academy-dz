  "questions": [
    {
      "id": "q1",
      "statement": "حلّ المتراجحة $\\dfrac{x}{2} - \\dfrac{3}{4} \\geq 1$ .",
      "learningPoints": [
        {
          "code": "4am_mutarajiha-ula_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$x \\geq \\dfrac{7}{2}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$x \\geq \\dfrac{1}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-NAQL-ISHARA"
        },
        {
          "id": "C",
          "content": "$x \\geq \\dfrac{7}{4}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-TARAF-WAHID"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ننقل حدود $x$ إلى طرف والأعداد إلى الطرف الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الإضافة أو الطرح من الطرفين لا تغيّر الاتجاه."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "في الأخير نقسم على معامل $x$ : انظر إلى إشارته قبل أن تكتب الاتجاه."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{x}{2} - \\dfrac{3}{4} \\geq 1$ تؤول إلى $\\dfrac{1}{2}x \\geq \\dfrac{7}{4}$، ثم نقسم على $\\dfrac{1}{2}$ (عدد موجب، فالاتجاه لا يتغيّر): $x \\geq \\dfrac{7}{2}$.",
        "incorrect": "راجع كل خطوة: هل أجريت العملية نفسها على الطرفين؟ وهل غيّرت الاتجاه عند الضرب أو القسمة على عدد سالب فقط؟"
      }
    },
    {
