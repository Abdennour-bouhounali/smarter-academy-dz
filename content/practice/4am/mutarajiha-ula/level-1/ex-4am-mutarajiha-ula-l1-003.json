      "statement": "هل العدد $0$ حلّ للمتراجحة $3x - 2 < 6$ ؟",
      "learningPoints": [
        {
          "code": "4am_mutarajiha-ula_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
