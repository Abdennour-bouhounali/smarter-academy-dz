      "learningPoints": [
        {
          "code": "4am_mutarajiha-ula_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$x \\geq -\\dfrac{3}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUADALA-QISMA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$x \\leq -\\dfrac{2}{3}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTARAJIHA-QALB-ZAID"
