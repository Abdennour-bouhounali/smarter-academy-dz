    {
      "id": "q3",
      "step": "02",
      "statement": "لتكن النقطتان $C(1 ; 2)$ ، $D(-1 ; -2)$ ، بين أن النقط $D$ ، $O$ ، $C$ في استقامية.",
      "learningPoints": [
