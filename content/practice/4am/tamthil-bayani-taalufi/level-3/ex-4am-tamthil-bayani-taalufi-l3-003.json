      "answerFormat": "عدد (عشري بفاصلة أو كسر مثل 7/9)",
      "expectedAnswer": "3/4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "معامل التوجيه $a$ هو ما يصعده المستقيم (أو ينزله) عندما نتقدّم وحدة واحدة إلى اليمين."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "خذ نقطتين من المستقيم: كم تغيّر الترتيب؟ وكم تغيّرت الفاصلة؟"
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اقسم تغيّر الترتيب على تغيّر الفاصلة، بالإشارة: ينزل ⇒ $a < 0$ ."
        }
      ],
      "feedback": {
        "correct": "من $(0 ; -2)$ إلى $(4 ; 1)$ : $a = \\dfrac{1 - (-2)}{4 - (0)} = 0{,}75$ .",
        "incorrect": "اقسم تغيّر الترتيب على تغيّر الفاصلة، لا العكس، وانتبه إلى الإشارة."
      }
    },
    {
      "id": "q2",
      "statement": "بقراءة بيانية، عبارة الدالة هي:",
