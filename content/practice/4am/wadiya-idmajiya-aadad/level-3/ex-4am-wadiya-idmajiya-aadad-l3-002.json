    },
    {
      "id": "q2",
      "statement": "سُمك المصحف برواية ورش 3 cm وسُمك المصحف برواية حفص 2,5 cm، والمصاحف توضع جنبًا إلى جنب. ما هو طول كل رفّ (بالسنتيمتر)؟",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-aadad_P1",
          "role": "primary"
        }
      ],
      "answerType": "rational",
