      "feedback": {
        "correct": "PGCD(30 ; 45) = 15 و 15 يقسم 60، إذن d = 15cm.",
        "incorrect": "d قاسم مشترك للأبعاد الثلاثة، وهو أكبر ما يمكن."
      },
      "solution": {
        "lines": [
          "d قاسم مشترك للأعداد 30 و 45 و 60.",
          "$45 = 30 \\times 1 + 15$ ، $30 = 15 \\times 2 + 0$ : $PGCD(30 ; 45) = 15$",
          "$60 = 15 \\times 4$ : 15 يقسم 60 أيضًا، وهو أكبر قاسم مشترك للأعداد الثلاثة."
        ],
        "result": "d = 15\\,cm"
