        {
          "id": "h2",
          "type": "direction",
          "content": "إذا كان $x$ سالبا فإن $\\sqrt{x^2} = -x$."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
