      },
      "solution": {
        "lines": [
          "$3 - \\pi$ سالب، إذن $A = -(3 - \\pi) = \\pi - 3$",
          "$\\pi - 5$ سالب، إذن $B = -(\\pi - 5) = 5 - \\pi$"
        ],
        "result": "A = \\pi - 3 \\quad ; \\quad B = 5 - \\pi"
      },
