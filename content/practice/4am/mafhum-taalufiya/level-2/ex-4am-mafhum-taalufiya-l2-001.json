  "statement": {
    "content": "من الكتاب (ص 78): أجرة عامل: أجرة قاعدية شهرية قدرها 35000DA، يضاف إليها 185DA لكل ساعة إضافية. نسمّي $x$ عدد الساعات الإضافية و $S(x)$ الأجرة."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "احسب $S(12)$ .",
      "learningPoints": [
        {
          "code": "4am_mafhum-taalufiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "answerType": "rational",
      "answerFormat": "عدد صحيح أو عشري بالفاصلة أو كسر مثل -3/4",
      "expectedAnswer": "37220",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "صورة عدد بدالة تآلفية: نعوّض $x$ بهذا العدد في العبارة $ax + b$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب العدد في المعامل $a$ أولا، وانتبه إلى الإشارات."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "لا تنسَ أن تضيف الحدّ الثابت $b$ في النهاية."
        }
      ],
