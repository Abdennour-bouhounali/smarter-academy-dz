      "difficulty": 3,
      "answerType": "rational",
      "answerFormat": "عدد (صحيح أو عشري بالفاصلة، أو كسر)",
      "expectedAnswer": "2000",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "المقدار المعطى هو المقدار بعد التغيّر، والمطلوب المقدار قبله."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب العلاقة $y = kx$ بالمضاعف $k$ ، ثم عوّض $y$ بقيمته."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّ المعادلة $kx = y$ : $x = \\dfrac{y}{k}$ ، ثم تحقّق بالضرب."
        }
      ],
      "feedback": {
        "correct": "$0{,}95x = 1900$ ، ومنه $x = 2000$ . للتحقق: $2000 \\times 0{,}95 = 1900$ .",
        "incorrect": "أعد الحساب بالمضاعف أو بالعلاقة بين المقادير، وتحقّق من الوحدة."
