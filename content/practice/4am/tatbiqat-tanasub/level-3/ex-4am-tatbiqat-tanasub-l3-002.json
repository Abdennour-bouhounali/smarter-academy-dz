      "feedback": {
        "correct": "$50 + 38 + 54 + 63 = 205$ بنتا.",
        "incorrect": "أخذ $t\\%$ من عدد هو ضربه في $\\dfrac{t}{100}$ ، ثم اجمع."
      },
      "solution": {
        "lines": [
          "السنة الأولى: $100 \\times \\dfrac{50}{100} = 50$",
          "السنة الثانية: $95 \\times \\dfrac{40}{100} = 38$",
          "السنة الثالثة: $90 \\times \\dfrac{60}{100} = 54$",
          "السنة الرابعة: $90 \\times \\dfrac{70}{100} = 63$",
          "$50 + 38 + 54 + 63 = 205$"
        ]
      },
