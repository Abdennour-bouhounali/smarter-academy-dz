      },
      "solution": {
        "lines": [
          "$B = 8x + 8\\sqrt{7} - 3x^2 - 3\\sqrt{7}x + 8x - 8\\sqrt{7} + 3x^2 - 3\\sqrt{7}x$",
          "$B = (8 + 8)x + (-3 - 3)\\sqrt{7}x$",
          "$B = 16x - 6\\sqrt{7}x$"
        ],
        "result": "B = (16 - 6\\sqrt{7})x"
