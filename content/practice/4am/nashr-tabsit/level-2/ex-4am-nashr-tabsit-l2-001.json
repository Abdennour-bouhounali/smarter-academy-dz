  "questions": [
    {
      "id": "q1",
      "statement": "نشر $x(3x + 1)$ هو:",
      "learningPoints": [
        {
          "code": "4am_nashr-tabsit_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$3x^2 + x$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$3x^2 + 1$",
          "isCorrect": false,
          "misconceptionId": "MISC-NASHR-HAD-WAHID"
        },
        {
          "id": "C",
          "content": "$4x^2$",
          "isCorrect": false,
          "misconceptionId": "MISC-TABSIT-GHAYR-MUTASHABIH"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$x$ أمام القوسين."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب $x$ في $3x$ ثم في 1."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$x \\times 3x$ يحتوي على $x \\times x$."
        }
      ],
      "feedback": {
        "correct": "$x \\times 3x + x \\times 1 = 3x^2 + x$ — الخاصية $k(a + b) = ka + kb$.",
        "incorrect": "العامل $x$ يُضرب في الحدّين."
      }
    },
    {
      "id": "q2",
      "statement": "نشر $5x(1 - x)$ هو:",
      "learningPoints": [
        {
          "code": "4am_nashr-tabsit_P2",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$5x + 5x^2$",
          "isCorrect": false,
          "misconceptionId": "MISC-NASHR-ISHARA-SALIBA"
        },
        {
          "id": "B",
          "content": "$5x - 5x^2$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$4x$",
          "isCorrect": false,
          "misconceptionId": "MISC-TABSIT-X-MARRATAYN"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$5x$ أمام القوسين."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب $5x$ في 1 ثم في $-x$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "الخاصية $k(a - b) = ka - kb$."
        }
      ],
      "feedback": {
        "correct": "$5x \\times 1 - 5x \\times x = 5x - 5x^2$.",
        "incorrect": "الفرق يبقى فرقًا، و $5x \\times x$ فيه $x^2$."
      }
    },
