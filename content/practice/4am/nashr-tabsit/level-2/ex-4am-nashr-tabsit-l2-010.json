      "id": "q1",
      "step": "01",
      "statement": "تحقق بالنشر من أن: $(3x + 2)(x - 1) = 3x^2 - x - 2$ .",
      "learningPoints": [
        {
          "code": "4am_nashr-tabsit_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر الطرف الأيسر: اضرب كل حد من القوس الأول في كل حد من القوس الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجمع الحدّين $-3x$ و $2x$ ."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات عند النشر."
      },
      "solution": {
        "lines": [
          "$(3x + 2)(x - 1) = 3x \\times x - 3x \\times 1 + 2 \\times x - 2 \\times 1$",
          "$= 3x^2 - 3x + 2x - 2$",
          "$= 3x^2 - x - 2$",
          "ومنه المساواة صحيحة."
        ],
        "result": "(3x + 2)(x - 1) = 3x^2 - x - 2"
      },
      "timeSeconds": 180
    },
    {
