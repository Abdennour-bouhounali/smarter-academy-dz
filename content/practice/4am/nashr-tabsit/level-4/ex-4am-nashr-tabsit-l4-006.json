      "step": "01",
      "statement": "تحقّق من صحة المساواة الآتية: $(2x + 1)(x - 3) = 2x^2 - 5x - 3$ .",
      "learningPoints": [
        {
          "code": "4am_nashr-tabsit_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انشر الطرف الأيسر: كل حد من القوس الأول في كل حد من القوس الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجمع الحدّين $-6x$ و $x$ ."
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى الإشارات عند النشر."
      },
      "solution": {
        "lines": [
          "$(2x + 1)(x - 3) = 2x \\times x - 2x \\times 3 + 1 \\times x - 1 \\times 3$",
          "$= 2x^2 - 6x + x - 3$",
          "$= 2x^2 - 5x - 3$",
          "ومنه المساواة صحيحة."
        ],
        "result": "(2x + 1)(x - 3) = 2x^2 - 5x - 3"
      },
      "timeSeconds": 180
    },
