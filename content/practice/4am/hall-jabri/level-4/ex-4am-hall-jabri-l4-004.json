          "role": "primary"
        },
        {
          "code": "4am_hall-jabri_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "point",
      "answerFormat": "اكتب الثنائية $(x ; y)$ : قيمة $x$ ثم قيمة $y$ (عدد صحيح أو كسر مثل 7/3)",
      "expectedAnswer": {
        "x": "13/10",
        "y": "-1/10"
      },
      "misconceptionSignatures": [
        {
          "value": {
            "x": "-1/10",
            "y": "13/10"
          },
          "id": "MISC-JUMLA-TARTIB"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انظر إلى معاملات المجهولين: هل يوجد معامل يساوي $1$ أو $-1$ ؟ هل يوجد معاملان متعاكسان أو متساويان؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "مجهول معامله $1$ أو مجهول معبّر عنه بدلالة الآخر: التعويض. معاملان متعاكسان أو يصيران كذلك بضرب بسيط: الجمع."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "بعد إيجاد المجهول الأول عوّض قيمته لتجد الثاني، ثم تحقق في المعادلتين."
        }
      ],
      "feedback": {
        "correct": "الثنائية $\\left(\\dfrac{13}{10} ; -\\dfrac{1}{10}\\right)$ تحقق المعادلتين معا: هي حل الجملة.",
        "incorrect": "عوّض الثنائية التي وجدتها في المعادلتين: الحل يحققهما معا، والترتيب $(x ; y)$ مهم."
      },
      "solution": {
        "lines": [
          "معامل $x$ في المعادلة (2) يساوي $1$ : نستعمل طريقة التعويض.",
          "من المعادلة (2) نجد: $x = 1 - 3y$",
          "نعوّض في المعادلة (1): $6(1 - 3y) - 2y = 8$",
          "$-20y = 2$",
          "ومنه $y = -\\dfrac{1}{10}$",
          "نعوّض قيمة $y$ في عبارة $x$: $x = 1 - 3 \\times \\left(-\\dfrac{1}{10}\\right) = \\dfrac{13}{10}$",
          "إذن حل الجملة هو الثنائية:"
        ],
        "result": "\\left(\\dfrac{13}{10} ; -\\dfrac{1}{10}\\right)"
      },
      "work": "required",
