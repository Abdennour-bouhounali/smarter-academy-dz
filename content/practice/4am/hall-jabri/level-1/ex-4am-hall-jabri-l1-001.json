        {
          "code": "4am_hall-jabri_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "point",
      "answerFormat": "اكتب الثنائية $(x ; y)$ : قيمة $x$ ثم قيمة $y$ (عدد صحيح أو كسر مثل 7/3)",
      "expectedAnswer": {
        "x": "1",
        "y": "3"
      },
      "misconceptionSignatures": [
        {
          "value": {
            "x": "3",
            "y": "1"
          },
          "id": "MISC-JUMLA-TARTIB"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "في المعادلة (1) يمكن التعبير بسهولة عن $x$ بدلالة المجهول الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عبّر عن $x$ بدلالة المجهول الآخر، ثم عوّض العبارة في المعادلة الأخرى (لا في المعادلة نفسها)."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حل المعادلة ذات المجهول الواحد، ثم عوّض القيمة لتجد المجهول الثاني."
        }
      ],
      "feedback": {
        "correct": "الثنائية $(1 ; 3)$ تحقق المعادلتين معا: هي حل الجملة.",
        "incorrect": "عوّض الثنائية التي وجدتها في المعادلتين: الحل يحققهما معا، والترتيب $(x ; y)$ مهم."
      },
      "solution": {
        "lines": [
          "من المعادلة (1) نجد: $x = 10 - 3y$",
          "نعوّض في المعادلة (2): $3(10 - 3y) + 5y = 18$",
          "$-4y = -12$",
          "ومنه $y = 3$",
          "نعوّض قيمة $y$ في عبارة $x$: $x = 10 - 3 \\times 3 = 1$",
          "إذن حل الجملة هو الثنائية:"
        ],
        "result": "(1 ; 3)"
      },
      "work": "required",
      "timeSeconds": 300
    },
