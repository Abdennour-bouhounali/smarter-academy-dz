  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "اكتب $y$ بدلالة $x$ على الشكل $y = ax + b$ ، ثم أعط العددين $a$ و $b$ .",
      "statement": "العدد $a$ :",
