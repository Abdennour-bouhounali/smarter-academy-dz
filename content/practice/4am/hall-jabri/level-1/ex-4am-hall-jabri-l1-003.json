          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد صحيح)",
      "expectedAnswer": "3",
      "misconceptionSignatures": [
        {
          "value": "-3",
          "id": "MISC-TAWID-ISHARA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اعزل الحد الذي فيه $y$ في طرف، وانقل الحد الآخر إلى الطرف الثاني."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عند نقل حد نغيّر إشارته، ثم نغيّر إشارات الطرفين ليصير معامل $y$ موجبا."
        }
      ],
      "feedback": {
        "correct": "معامل $x$ في العبارة $y = ax + b$ هو $a = 3$ .",
        "incorrect": "انتبه لإشارة كل حد عند النقل، ثم عند تغيير إشارات الطرفين."
      },
      "solution": {
        "lines": [
          "$3x - y = 1$",
          "ننقل $3x$ إلى الطرف الثاني بتغيير إشارته: $-y = -3x + 1$",
          "نضرب الطرفين في $-1$ : $y = 3x - 1$",
          "ومنه $a = 3$ و $b = -1$ ."
        ],
        "result": "y = 3x - 1"
      },
