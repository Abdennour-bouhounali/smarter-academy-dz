      "solution": {
        "lines": [
          "$D$ نظيرة $B$ بالنسبة إلى $C$ : $BC = CD$ ، و $E$ نظيرة $C$ بالنسبة إلى $D$ : $CD = DE$ .",
          "$BD = 2BC$ و $BE = 3BC$",
          "$\\dfrac{BD}{BE} = \\dfrac{2BC}{3BC}$"
        ],
        "result": "\\dfrac{BD}{BE} = \\dfrac{2}{3}"
