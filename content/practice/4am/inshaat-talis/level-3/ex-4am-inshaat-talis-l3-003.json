  "statement": {
    "content": "$[AB]$ قطعة مستقيم و $[Ax)$ نصف مستقيم لا يحمل $[AB]$ . عيّنّا على $[Ax)$ النقط $P_1$ ، $P_2$ ، $P_3$ حيث $AP_1 = P_1P_2 = P_2P_3$ ، ثم رسمنا الموازيين للمستقيم $(P_3B)$ المارّين بـ $P_1$ و $P_2$ فقطعا $[AB]$ في $M_1$ و $M_2$ على الترتيب."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "statement": "احسب النسبة $\\dfrac{AP_1}{AP_3}$ .",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "1/3",
      "misconceptionSignatures": [
        {
          "value": "0,5",
          "id": "MISC-TALIS-ADAD-AL-ALAMAT"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عبّر عن $AP_3$ بدلالة $AP_1$ ."
        }
      ],
      "feedback": {
        "correct": "$AP_3 = 3AP_1$ ، فـ $\\dfrac{AP_1}{AP_3} = \\dfrac{1}{3}$ .",
        "incorrect": "$[AP_3]$ تتكوّن من ثلاث قطع متقايسة طول كل منها $AP_1$ ."
      },
      "solution": {
        "lines": [
          "$AP_3 = AP_1 + P_1P_2 + P_2P_3 = 3AP_1$"
        ],
        "result": "\\dfrac{AP_1}{AP_3} = \\dfrac{1}{3}"
      },
