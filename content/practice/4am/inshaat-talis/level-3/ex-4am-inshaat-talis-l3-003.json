          "content": "$AP_2 = 2AP_1$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{AP_2}{AP_3} = \\dfrac{2AP_1}{3AP_1} = \\dfrac{2}{3}$ .",
        "incorrect": "عدّ القطع المتقايسة في $[AP_2]$ ثم في $[AP_3]$ ."
      },
      "solution": {
        "lines": [
          "$\\dfrac{AP_2}{AP_3} = \\dfrac{2AP_1}{3AP_1}$"
        ],
        "result": "\\dfrac{AP_2}{AP_3} = \\dfrac{2}{3}"
      },
      "timeSeconds": 60
    },
    {
      "id": "q3",
      "step": "02",
      "statement": "بيّن أن $AM_1 = M_1M_2 = M_2B$ .",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "طبّق خاصية طالس مرتين: في المثلثين $AP_1M_1$ و $AP_3B$ ، ثم في $AP_2M_2$ و $AP_3B$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عبّر عن $AM_1$ و $AM_2$ بدلالة $AB$ ، ثم احسب $M_1M_2$ و $M_2B$ ."
        }
      ],
      "feedback": {
        "correct": "$AM_1 = \\dfrac{1}{3}AB$ و $AM_2 = \\dfrac{2}{3}AB$ ، ومنه $M_1M_2 = M_2B = \\dfrac{1}{3}AB$ .",
        "incorrect": "قارن برهانك بالحل النموذجي: المعطيات، ثم التوازي، ثم النسب المتساوية وذكر الخاصية المستعملة."
      },
      "solution": {
        "lines": [
          "$(P_1M_1) \\parallel (P_3B)$ : حسب خاصية طالس في المثلثين $AP_1M_1$ و $AP_3B$ : $\\dfrac{AM_1}{AB} = \\dfrac{AP_1}{AP_3} = \\dfrac{1}{3}$ ومنه $AM_1 = \\dfrac{1}{3}AB$ .",
          "$(P_2M_2) \\parallel (P_3B)$ : حسب خاصية طالس في المثلثين $AP_2M_2$ و $AP_3B$ : $\\dfrac{AM_2}{AB} = \\dfrac{AP_2}{AP_3} = \\dfrac{2}{3}$ ومنه $AM_2 = \\dfrac{2}{3}AB$ .",
          "$M_1M_2 = AM_2 - AM_1 = \\dfrac{1}{3}AB$ و $M_2B = AB - AM_2 = \\dfrac{1}{3}AB$ .",
          "إذن $AM_1 = M_1M_2 = M_2B = \\dfrac{1}{3}AB$ : قسمنا $[AB]$ إلى ثلاث قطع متقايسة."
        ]
      },
      "timeSeconds": 300
    },
    {
