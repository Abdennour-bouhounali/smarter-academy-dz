    {
      "id": "q4",
      "step": "03",
      "sub": "ب",
      "statement": "احسب المسافة $MN$ بين النقطتين.",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد: الطول بـ cm",
      "expectedAnswer": "12",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب أولا $AM$ : $M \\in [AB]$ و $\\dfrac{MA}{MB} = \\dfrac{3}{2}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$M$ بين $A$ و $N$ ."
        }
      ],
      "feedback": {
        "correct": "$AM = \\dfrac{3}{5} \\times 5 = 3$ ومنه $MN = AN - AM = 15 - 3 = 12\\,\\mathrm{cm}$ .",
        "incorrect": "احسب $AM$ (نسبة الجزء إلى الكل $\\dfrac{3}{5}$ ) ثم اطرحه من $AN$ ."
      },
      "solution": {
        "lines": [
          "$\\dfrac{MA}{MB} = \\dfrac{AF}{BE} = \\dfrac{3}{2}$ و $M \\in [AB]$ ومنه $AM = \\dfrac{3}{5}AB = 3$",
          "$MN = AN - AM = 15 - 3$"
        ],
        "result": "MN = 12\\,\\mathrm{cm}"
      },
      "timeSeconds": 150
    }
