      "id": "q1",
      "step": "01",
      "statement": "احسب النسبة $\\dfrac{NA}{NB}$ .",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "1,5",
      "misconceptionSignatures": [
        {
          "value": "2/3",
          "id": "MISC-TALIS-NISBA-MAQLUBA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$(AK) \\parallel (BE)$ ، والنقط $N$ ، $A$ ، $B$ في استقامية والنقط $N$ ، $K$ ، $E$ في استقامية."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "طبّق خاصية طالس في المثلثين $NAK$ و $NBE$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{NA}{NB} = \\dfrac{AK}{BE} = \\dfrac{3}{2}$ : النقطة $N$ تحقّق النسبة نفسها التي تحقّقها $M$ .",
        "incorrect": "$NA$ يقابل $AK$ و $NB$ يقابل $BE$ في المثلثين $NAK$ و $NBE$ ."
      },
      "solution": {
        "lines": [
          "$(AK) \\parallel (BE)$ ، حسب خاصية طالس في المثلثين $NAK$ و $NBE$ : $\\dfrac{NA}{NB} = \\dfrac{NK}{NE} = \\dfrac{AK}{BE}$"
        ],
        "result": "\\dfrac{NA}{NB} = \\dfrac{3}{2}"
      },
      "timeSeconds": 150
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "احسب النسبة $\\dfrac{AN}{AB}$ .",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "3",
      "misconceptionSignatures": [
        {
          "value": "0,6",
          "id": "MISC-TALIS-JIHA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$N$ بعد $B$ : $NA = NB + AB$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "إذا كان $NA = 3u$ و $NB = 2u$ ، فكم يساوي $AB$ ؟"
        }
      ],
      "feedback": {
        "correct": "$AB = NA - NB = u$ و $AN = 3u$ : $\\dfrac{AN}{AB} = \\dfrac{3}{3 - 2} = 3$ .",
        "incorrect": "$N$ خارج $[AB]$ : $AB$ هو الفرق بين $NA$ و $NB$ ، لا مجموعهما."
      },
      "solution": {
        "lines": [
          "$NA = 3u$ و $NB = 2u$ ، و $B \\in [AN]$ ومنه $AB = NA - NB = u$",
          "$\\dfrac{AN}{AB} = \\dfrac{3u}{u}$"
        ],
        "result": "\\dfrac{AN}{AB} = 3"
      },
      "timeSeconds": 150
    },
    {
      "id": "q3",
      "step": "03",
      "sub": "ا",
      "statement": "احسب الطول $AN$ .",
      "learningPoints": [
