      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$MA$ ثلاثة أجزاء و $MB$ جزآن: كم جزءا في $AB$ ؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب $\\dfrac{AM}{AB}$ ثم $AM$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{AM}{AB} = \\dfrac{3}{5}$ ومنه $AM = \\dfrac{3}{5} \\times 6 = 3{,}6\\,\\mathrm{cm}$ .",
        "incorrect": "لا تضرب $AB$ في $\\dfrac{MA}{MB}$ : $AM$ جزء من $AB$ ."
      },
      "solution": {
        "lines": [
          "$M \\in [AB]$ و $\\dfrac{MA}{MB} = \\dfrac{3}{2}$ ومنه $\\dfrac{AM}{AB} = \\dfrac{3}{3 + 2} = \\dfrac{3}{5}$",
          "$AM = \\dfrac{3}{5} \\times 6$"
        ],
        "result": "AM = 3{,}6\\,\\mathrm{cm}"
      },
