          "id": "h1",
          "type": "look",
          "content": "النقط $M$ ، $A$ ، $B$ في استقامية والنقط $M$ ، $F$ ، $E$ في استقامية، و $(AF) \\parallel (BE)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "طبّق خاصية طالس في المثلثين $MAF$ و $MBE$ (وضعية الفراشة)."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{MA}{MB} = \\dfrac{AF}{BE} = \\dfrac{3}{2}$ .",
        "incorrect": "في وضعية الفراشة، $MA$ يقابل $MB$ و $AF$ يقابل $BE$ ."
      },
      "solution": {
        "lines": [
          "$(AF) \\parallel (BE)$ و $M$ نقطة تقاطع $(AB)$ و $(EF)$ ،",
          "حسب خاصية طالس في المثلثين $MAF$ و $MBE$ : $\\dfrac{MA}{MB} = \\dfrac{MF}{ME} = \\dfrac{AF}{BE}$"
        ],
        "result": "\\dfrac{MA}{MB} = \\dfrac{3}{2}"
      },
      "timeSeconds": 150
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "إذا كان $AB = 6\\,\\mathrm{cm}$ ، احسب الطول $AM$ .",
      "learningPoints": [
        {
          "code": "4am_inshaat-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
