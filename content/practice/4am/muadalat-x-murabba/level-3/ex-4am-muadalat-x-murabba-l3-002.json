    {
      "id": "q2",
      "statement": "ما هو الحل الموجب للمعادلة $x^2 = \\dfrac{1}{4}$؟",
      "learningPoints": [
        {
          "code": "4am_muadalat-x-murabba_P1",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "كسر على الشكل a/b",
      "expectedAnswer": "1/2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ابحث عن كسر موجب مربعه $\\dfrac{1}{4}$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$4 = 2^2$ و $1 = 1^2$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$x^2 = \\left(\\sqrt{\\dfrac{1}{4}}\\right)^2$."
        }
      ],
      "feedback": {
        "correct": "$\\left(\\dfrac{1}{2}\\right)^2 = \\dfrac{1}{4}$: الحلان $\\dfrac{1}{2}$ و $-\\dfrac{1}{2}$.",
        "incorrect": "المطلوب جذر $\\dfrac{1}{4}$، لا نصفه."
      }
