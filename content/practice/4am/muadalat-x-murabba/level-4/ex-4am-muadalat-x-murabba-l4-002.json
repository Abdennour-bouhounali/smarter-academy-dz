          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "كسر على الشكل a/b",
      "expectedAnswer": "1/3",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اعزل $x^2$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$9x^2 = 1$ ثم اقسم على 9."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "ابحث عن كسر موجب مربعه $\\dfrac{1}{9}$."
        }
      ],
      "feedback": {
        "correct": "$x^2 = \\dfrac{1}{9}$، و $\\left(\\dfrac{1}{3}\\right)^2 = \\dfrac{1}{9}$: الحلان $\\dfrac{1}{3}$ و $-\\dfrac{1}{3}$.",
        "incorrect": "بعد عزل $x^2$ لا تتوقف: المطلوب $x$."
      }
    },
    {
