          "code": "4am_dala-khattiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 3,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب المبلغ بـ DA (عدد فقط)",
      "expectedAnswer": "96",
      "misconceptionSignatures": [
        {
          "value": "150",
