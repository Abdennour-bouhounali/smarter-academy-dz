        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "صورة العدد $x$ بالدالة الخطية $f$ هي $f(x) = 0{,}8 \\times x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عوّض $x$ بالعدد $120$ ثم احسب الجداء، وانتبه إلى الإشارة."
        }
      ],
      "feedback": {
        "correct": "$f(120) = 0{,}8 \\times 120 = 96$ .",
        "incorrect": "الصورة جداء المعامل في العدد: $f(x) = 0{,}8 \\times x$ ."
      },
      "solution": {
        "lines": [
          "$f(120) = 0{,}8 \\times 120$",
          "$f(120) = 96$"
        ],
        "result": "f(120) = 96DA"
      },
      "timeSeconds": 60
    },
