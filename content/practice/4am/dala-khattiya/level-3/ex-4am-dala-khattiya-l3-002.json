  "statement": {
    "content": "قرّر تاجر تخفيض أسعار سلعه بـ 20% بمناسبة عيد الفطر. نسمّي $x$ سعر سلعة قبل التخفيض و $f(x)$ سعرها بعد التخفيض (بـ DA)."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "بيّن أن $f$ دالة خطية، ثم عيّن معاملها.",
      "learningPoints": [
        {
          "code": "4am_dala-khattiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 3,
      "cognitiveDemand": "reason",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد صحيح، أو عشري بالفاصلة، أو كسر a/b)",
      "expectedAnswer": "0,8",
      "misconceptionSignatures": [
        {
          "value": "0,2",
          "id": "MISC-TAKHFID-NISBA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "بعد تخفيض 20% يدفع الزبون $100\\% - 20\\%$ من السعر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اكتب $f(x)$ على الشكل $ax$ ."
        }
      ],
      "feedback": {
        "correct": "$f(x) = 0{,}8x$ : $f$ دالة خطية معاملها $0{,}8$ .",
        "incorrect": "المعامل هو النسبة التي يدفعها الزبون، لا نسبة التخفيض."
      },
      "solution": {
        "lines": [
          "$f(x) = x - \\dfrac{20}{100}x = \\left(1 - 0{,}2\\right)x$",
          "$f(x) = 0{,}8x$ من الشكل $ax$ : $f$ دالة خطية معاملها $0{,}8$ ."
        ],
        "result": "f(x) = 0{,}8x"
      },
      "timeSeconds": 90
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "احسب $f(120)$ .",
      "learningPoints": [
