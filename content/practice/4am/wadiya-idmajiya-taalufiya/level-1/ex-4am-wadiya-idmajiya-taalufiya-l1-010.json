      "answerFormat": "عدد: الفرق بـ DA",
      "expectedAnswer": "60",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب $f(4)$ ثم $g(4)$ ."
        }
      ],
      "feedback": {
        "correct": "$g(4) = 260$ و $f(4) = 200$ .",
        "incorrect": "احسب كل صورة على حدة ثم اطرح."
