  "statement": {
    "content": "لرحلة فوج كشافة إلى غابة لغرس الأشجار حبًّا للوطن، اتصل القائد بناقلين:\n- الناقل الأول يطلب 4000DA مبلغا ثابتا و 100DA عن كل مشارك.\n- ثمن الناقل الثاني دالة تآلفية $g$ لعدد المشاركين $x$ : 3500DA من أجل 10 مشاركين، و 6500DA من أجل 30 مشاركا.\nنسمّي $f(x)$ ثمن الناقل الأول بـ DA."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "lead": "أوجد العبارة الجبرية للدالة $g$ .",
      "statement": "أعط العدد $a$ :",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-taalufiya_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد صحيح، أو عشري بالفاصلة، أو كسر a/b)",
      "expectedAnswer": "150",
      "misconceptionSignatures": [
