  "statement": {
    "content": "من الكتاب (ص 75): سعر منتوج $x$ دينار، بعد زيادة بـ $t\\%$ متبوعة بتخفيض بالنسبة نفسها أصبح $y$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "عبارة $y$ بدلالة $x$ و $t$ :",
      "learningPoints": [
        {
          "code": "4am_tarrid-khatti_P1",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$y = x$",
          "isCorrect": false,
          "misconceptionId": "MISC-NISBA-TATABU-JAM"
        },
        {
          "id": "B",
          "content": "$y = \\left(1 - \\dfrac{t^2}{10000}\\right)x$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$y = \\left(1 + \\dfrac{2t}{100}\\right)x$",
          "isCorrect": false,
          "misconceptionId": "MISC-NISBA-TATABU-JAM"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "زيادة: نضرب في $1 + \\dfrac{t}{100}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "تخفيض: نضرب في $1 - \\dfrac{t}{100}$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "انشر الجداء."
        }
      ],
      "feedback": {
        "correct": "$\\left(1 + \\dfrac{t}{100}\\right)\\left(1 - \\dfrac{t}{100}\\right) = 1 - \\dfrac{t^2}{10000}$ .",
        "incorrect": "التخفيض على السعر بعد الزيادة: لا يلغيها."
      }
    },
    {
      "id": "q2",
      "statement": "من أجل $x = 5000$ و $t = 10$ ، ما قيمة $y$ ؟",
      "learningPoints": [
        {
          "code": "4am_tarrid-khatti_P1",
          "role": "primary"
        }
      ],
