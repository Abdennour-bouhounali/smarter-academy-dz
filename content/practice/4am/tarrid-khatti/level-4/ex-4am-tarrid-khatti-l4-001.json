      "id": "q1",
      "step": "01",
      "statement": "عبّر عن $y$ بدلالة $x$ و $t$ ، ثم بيّن أن: $y = \\left(1 - \\dfrac{t^2}{10000}\\right)x$ .",
      "learningPoints": [
        {
          "code": "4am_tarrid-khatti_P1",
          "role": "primary"
        }
      ],
      "difficulty": 4,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الزيادة بـ $t\\%$ : نضرب في $1 + \\dfrac{t}{100}$ ."
