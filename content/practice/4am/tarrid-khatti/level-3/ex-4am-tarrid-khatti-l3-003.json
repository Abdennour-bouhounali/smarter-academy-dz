          "type": "strategy",
          "content": "التغيّران المتتابعان: نضرب في جداء المعاملين."
        }
      ],
      "feedback": {
        "correct": "$f(x) = 1{,}1 \\times 0{,}92 \\times x = 1{,}012x$ .",
        "incorrect": "تغيّران متتابعان يُترجمان بجداء المضاعفين، لا بجمع النسبتين."
      },
      "solution": {
        "lines": [
          "بعد 2016: $x \\times 1{,}1$",
          "بعد 2017: $x \\times 1{,}1 \\times 0{,}92 = 1{,}012x$",
          "إذن $f(x) = 1{,}012x$ : $f$ دالة خطية معاملها $1{,}012$ ."
        ],
        "result": "f(x) = 1{,}012x"
