      "feedback": {
        "correct": "$PGCD(60 ; 32) = 4$ و 4 يقسم 68، إذن أكبر مسافة 4 m.",
        "incorrect": "المسافة أكبر قاسم مشترك لأطوال الأضلاع الثلاثة."
      },
      "solution": {
        "lines": [
          "المسافة قاسم مشترك للأعداد 32 و 60 و 68، وهي أكبر ما يمكن.",
          "بطريقة الفروق المتتالية:",
          "$60 - 32 = 28$",
          "$32 - 28 = 4$",
          "$28 - 4 = 24$",
          "$24 - 4 = 20$",
          "$20 - 4 = 16$",
          "$16 - 4 = 12$",
          "$12 - 4 = 8$",
          "$8 - 4 = 4$",
          "$4 - 4 = 0$",
          "$PGCD(60 ; 32) = 4$، و $68 = 4 \\times 17$ إذن 4 يقسم 68 أيضًا."
        ],
        "result": "4\\,m"
      },
