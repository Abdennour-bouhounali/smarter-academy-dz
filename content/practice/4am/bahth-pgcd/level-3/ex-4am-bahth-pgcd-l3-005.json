        "incorrect": "أجرِ القسمات المتتابعة إلى أن تجد باقيًا معدومًا؛ القاسم المشترك الأكبر هو آخر باقٍ غير معدوم."
      },
      "solution": {
        "lines": [
          "باستعمال خوارزمية إقليدس:",
          "$1053 = 832 \\times 1 + 221$",
          "$832 = 221 \\times 3 + 169$",
          "$221 = 169 \\times 1 + 52$",
          "$169 = 52 \\times 3 + 13$",
          "$52 = 13 \\times 4 + 0$",
          "آخر باقٍ غير معدوم هو 13، إذن:"
        ],
        "result": "PGCD(1053 ; 832) = 13"
      },
