      },
      "solution": {
        "lines": [
          "باستعمال طريقة الفروق المتتالية:",
          "$84 - 48 = 36$",
          "$48 - 36 = 12$",
          "$36 - 12 = 24$",
          "$24 - 12 = 12$",
          "$12 - 12 = 0$",
          "آخر فرق غير معدوم هو 12، إذن:"
        ],
        "result": "PGCD(84 ; 48) = 12"
