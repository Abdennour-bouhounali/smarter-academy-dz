  "statement": {
    "content": "المبلغ الشهري لباقة أنترنت هو $f(x) = 80x + 1000$ (بـ DA)، حيث $x$ عدد الجيغا الإضافية المستهلكة في الشهر."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب $f(1) - f(0)$ ، ثم فسّر النتيجة.",
      "learningPoints": [
        {
          "code": "4am_tarrid-taalufi_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد: المبلغ بـ DA",
      "expectedAnswer": "80",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب $f(1)$ ثم $f(0)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الفرق هو ما يُضاف إلى المبلغ عند استهلاك جيغا إضافية واحدة."
        }
      ],
      "feedback": {
        "correct": "هو معامل $x$ : ثمن الجيغا الإضافية الواحدة.",
        "incorrect": "احسب الصورتين ثم اطرح."
      },
      "solution": {
        "lines": [
          "$f(1) = 80 + 1000 = 1080$ و $f(0) = 1000$",
          "$f(1) - f(0) = 1080 - 1000 = 80$",
          "التفسير: 80DA هو ثمن الجيغا الإضافية الواحدة (معامل $x$)."
        ],
        "result": "80DA"
