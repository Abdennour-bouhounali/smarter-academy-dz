      "lead": "عبّر عن $f(x)$ و $g(x)$ بدلالة $x$ .",
      "statement": "أعط العدد $a$ حيث: $f(x) = ax$ .",
      "learningPoints": [
        {
          "code": "4am_tarrid-taalufi_P1",
          "role": "primary"
