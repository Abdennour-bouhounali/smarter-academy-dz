  "statement": {
    "content": "نعتبر الجملة التالية والثنائية $\\left(\\dfrac{1}{2} ; -\\dfrac{1}{2}\\right)$ :",
    "formulas": [
      "\\begin{cases} x + y = 0 \\\\ 2x - \\dfrac{1}{2}y = 0 \\end{cases}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب $2x - \\dfrac{1}{2}y$ من أجل $x = \\dfrac{1}{2}$ و $y = -\\dfrac{1}{2}$ .",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-jumal_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب النتيجة على شكل كسر أو عدد عشري",
      "expectedAnswer": "5/4",
      "misconceptionSignatures": [
        {
          "value": "3/4",
          "id": "MISC-TAWID-ISHARA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ و $y$ بقيمتيهما في العبارة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "انتبه إلى إشارة $y$ : طرح عدد سالب يعني إضافة مقابله."
        }
      ],
      "feedback": {
        "correct": "النتيجة $\\dfrac{5}{4}$ .",
        "incorrect": "احسب $2 \\times \\dfrac{1}{2}$ ثم $\\dfrac{1}{2} \\times \\left(-\\dfrac{1}{2}\\right)$ وانتبه إلى الإشارات."
      },
      "solution": {
        "lines": [
          "$2 \\times \\dfrac{1}{2} - \\dfrac{1}{2} \\times \\left(-\\dfrac{1}{2}\\right) = 1 + \\dfrac{1}{4}$",
          "$= \\dfrac{5}{4}$"
        ],
        "result": "\\dfrac{5}{4}"
      },
      "work": "optional",
      "timeSeconds": 150
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "هل الثنائية $\\left(\\dfrac{1}{2} ; -\\dfrac{1}{2}\\right)$ حل لهذه الجملة؟ برّر.",
