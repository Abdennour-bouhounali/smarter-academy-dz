      },
      "solution": {
        "lines": [
          "$\\begin{cases} x + y = 24 & ...(1) \\\\ x + 4y = 45 & ...(2) \\end{cases}$",
          "من المعادلة (1) نجد: $y = 24 - x$",
          "بالتعويض في المعادلة (2) نجد: $x + 4(24 - x) = 45$",
          "$-3x + 96 = 45$",
          "$-3x = -51$",
          "$x = 17$",
          "ومنه: $y = 24 - 17 = 7$",
          "إذن حل الجملة هو الثنائية:"
        ],
        "result": "(17 ; 7)"
      },
