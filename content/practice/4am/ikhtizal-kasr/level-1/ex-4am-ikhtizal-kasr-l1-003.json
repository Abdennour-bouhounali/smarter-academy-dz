      "solution": {
        "lines": [
          "باستعمال خوارزمية إقليدس:",
          "$528 = 360 \\times 1 + 168$",
          "$360 = 168 \\times 2 + 24$",
          "$168 = 24 \\times 7 + 0$",
          "آخر باقٍ غير معدوم هو 24، إذن PGCD(528 ; 360) = 24 .",
          "$A = \\dfrac{528}{360} = \\dfrac{528 \\div 24}{360 \\div 24}$"
        ],
        "result": "A = \\dfrac{528}{360} = \\dfrac{22}{15}"
