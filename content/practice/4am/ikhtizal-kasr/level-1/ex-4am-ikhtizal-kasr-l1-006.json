      "solution": {
        "lines": [
          "باستعمال خوارزمية إقليدس:",
          "$1890 = 1350 \\times 1 + 540$",
          "$1350 = 540 \\times 2 + 270$",
          "$540 = 270 \\times 2 + 0$",
          "آخر باقٍ غير معدوم هو 270، إذن PGCD(1350 ; 1890) = 270 .",
          "$B = \\dfrac{1350}{1890} = \\dfrac{1350 \\div 270}{1890 \\div 270}$"
        ],
        "result": "B = \\dfrac{1350}{1890} = \\dfrac{5}{7}"
