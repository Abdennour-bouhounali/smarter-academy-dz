      },
      "solution": {
        "lines": [
          "باستعمال خوارزمية إقليدس:",
          "$84 = 48 \\times 1 + 36$",
          "$48 = 36 \\times 1 + 12$",
          "$36 = 12 \\times 3 + 0$",
          "آخر باقٍ غير معدوم هو 12، إذن:"
        ],
        "result": "PGCD(84 ; 48) = 12"
      },
