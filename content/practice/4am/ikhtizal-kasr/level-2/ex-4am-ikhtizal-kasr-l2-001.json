      "solution": {
        "lines": [
          "باستعمال خوارزمية إقليدس:",
          "$42 = 28 \\times 1 + 14$",
          "$28 = 14 \\times 2 + 0$",
          "آخر باقٍ غير معدوم هو 14، إذن PGCD(28 ; 42) = 14 .",
          "$\\dfrac{28}{42} = \\dfrac{28 \\div 14}{42 \\div 14}$"
        ],
        "result": "\\dfrac{28}{42} = \\dfrac{2}{3}"
