      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "سمِّ N عدد التلاميذ: مجموع العلامات قبل الحذف = المعدّل × N ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بعد الحذف ينقص المجموع بـ 23 وينقص عدد التلاميذ بـ 2 ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "قارن 23 بضعف المعدّل."
        }
      ],
      "feedback": {
        "correct": "$4 + 19 = 23 = 2 \\times 11{,}5$ : المعدّل لا يتغيّر.",
        "incorrect": "اكتب المجموع بعد الحذف بدلالة N ، ثم اقسمه على العدد الجديد للتلاميذ وبسّط."
      },
      "solution": {
        "lines": [
          "مجموع العلامات قبل الحذف: $11{,}5N$",
          "بعد الحذف: $11{,}5N - 4 - 19 = 11{,}5N - 23 = 11{,}5(N - 2)$ لأن $23 = 2 \\times 11{,}5$",
          "المعدّل الجديد: $\\dfrac{11{,}5(N - 2)}{N - 2} = 11{,}5$"
        ],
        "result": "11{,}5"
      },
