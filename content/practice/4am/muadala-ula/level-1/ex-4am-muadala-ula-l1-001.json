      "statement": "حلّ المعادلة $2x = 11$ .",
      "learningPoints": [
        {
          "code": "4am_muadala-ula_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "answerType": "rational",
      "answerFormat": "عدد صحيح أو كسر مثل -3/4 (أو عدد عشري)",
      "expectedAnswer": "11/2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "المعادلة من الشكل $ax = b$ : حدّد العدد المضروب في $x$ والعدد الذي في الطرف الآخر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "نقسم الطرفين على معامل $x$ ، مع إشارته."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "الحل هو العدد الذي في الطرف الآخر مقسومًا على معامل $x$ ، لا العكس."
        }
      ],
      "feedback": {
        "correct": "$2x = 11$ : نصل إلى $2x = 11$ ، ومنه $x = \\dfrac{11}{2}$.",
        "incorrect": "أجرِ كل عملية على الطرفين معًا، ثم تحقّق بتعويض $x$ في المعادلة."
      }
    },
