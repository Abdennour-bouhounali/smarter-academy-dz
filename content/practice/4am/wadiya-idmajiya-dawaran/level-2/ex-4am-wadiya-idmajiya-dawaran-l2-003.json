  "statement": {
    "content": "حيّز دائريّ نصف قطره 3m لغرس الأزهار تحيط به 6 أعمدة كهربائية متباعدة بنفس المسافة. كل عمود صورة الذي قبله بدوران مركزه مركز الحيّز."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "زاوية هذا الدوران (بالدرجة):",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-dawaran_P3",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد (بالدرجة)",
      "expectedAnswer": "60",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ستة أعمدة على دائرة مغلقة تحدّد ستة أقواس متقايسة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الأقواس تملأ دورة كاملة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "نقسم $360^\\circ$ على عدد الأعمدة."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{360^\\circ}{6} = 60^\\circ$ .",
