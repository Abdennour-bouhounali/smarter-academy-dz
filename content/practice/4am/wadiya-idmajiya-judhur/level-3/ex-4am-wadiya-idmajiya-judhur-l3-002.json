          "id": "MISC-JIDHR-FI-JIDHR"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sqrt{2} \\times \\sqrt{2} = 2$ ، ثم اقسم على المقام."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{2}{2} = 1$ ، إذن $b = 1$ .",
        "incorrect": "الحد الثابت في البسط هو $\\sqrt{2} \\times \\sqrt{2}$ : لا تنس القسمة على المقام."
      },
      "solution": {
        "lines": [
          "$B = \\dfrac{2 + \\sqrt{2}}{\\sqrt{2}} = \\dfrac{(2 + \\sqrt{2}) \\times \\sqrt{2}}{\\sqrt{2} \\times \\sqrt{2}}$",
          "$= \\dfrac{2\\sqrt{2} + \\sqrt{4}}{\\sqrt{4}} = \\dfrac{2\\sqrt{2} + 2}{2}$"
        ],
        "result": "B = \\sqrt{2} + 1"
      },
