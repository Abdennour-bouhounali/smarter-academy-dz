        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $A$ بنتيجة السؤال 01."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$\\sqrt{2} \\times \\sqrt{2} = 2$ ."
        }
      ],
      "feedback": {
        "correct": "$8\\sqrt{2} \\times \\dfrac{\\sqrt{2}}{4} = \\dfrac{8 \\times 2}{4} = 4$",
        "incorrect": "اضرب المعاملين، ثم استعمل $\\sqrt{2} \\times \\sqrt{2} = 2$ ، ثم اقسم على 4."
      },
      "solution": {
        "lines": [
          "$A \\times \\dfrac{\\sqrt{2}}{4} = 8\\sqrt{2} \\times \\dfrac{\\sqrt{2}}{4}$",
          "$= \\dfrac{8 \\times (\\sqrt{2})^2}{4} = \\dfrac{8 \\times 2}{4}$"
        ],
        "result": "A \\times \\dfrac{\\sqrt{2}}{4} = 4"
      },
