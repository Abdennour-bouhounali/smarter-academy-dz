      "feedback": {
        "correct": "$3x = 4 \\times 1{,}5 = 6$ ومنه $x = 2$ .",
        "incorrect": "اكتب الجداء المتصالب (البسط الأول في المقام الثاني) ثم اقسم على معامل $x$ ."
