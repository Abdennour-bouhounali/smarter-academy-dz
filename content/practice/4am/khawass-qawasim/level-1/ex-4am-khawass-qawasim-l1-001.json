  "statement": {
    "content": "نعتبر الأعداد الطبيعية $a = 18$ ، $b = 12$ و $n = 3$ ، حيث $n$ يقسم كلا من $a$ و $b$: $18 = 3 \\times 6$ و $12 = 3 \\times 4$."
  },
  "questions": [
