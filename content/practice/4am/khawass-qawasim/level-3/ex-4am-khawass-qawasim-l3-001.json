    "content": "نعلم أن العدد 5 يقسم كلا من العددين 90 و 25."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "أجرِ القسمة الإقليدية للعدد 90 على 25.",
      "learningPoints": [
        {
          "code": "4am_khawass-qawasim_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب الباقي فقط (عدد طبيعي)",
      "expectedAnswer": "15",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ابحث عن أكبر مضاعف للعدد 25 لا يتجاوز 90."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الباقي هو الفرق بين 90 وهذا المضاعف، ويجب أن يكون أصغر تمامًا من 25."
        }
      ],
      "feedback": {
        "correct": "$90 = 25 \\times 3 + 15$ مع $15 < 25$.",
        "incorrect": "في القسمة الإقليدية $90 = 25 \\times q + r$ يكون الباقي $r$ أصغر تمامًا من 25."
      },
      "solution": {
        "lines": [
          "$25 \\times 3 = 75$ و $25 \\times 4 = 100 > 90$",
          "$90 - 75 = 15$",
          "إذن $90 = 25 \\times 3 + 15$ مع $15 < 25$."
        ],
        "result": "90 = 25 \\times 3 + 15"
      },
      "work": "optional",
      "timeSeconds": 120
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "برّر، باستعمال المساواة $15 = 90 - 25 \\times 3$ ، أن 5 يقسم 15 دون إجراء القسمة على 5.",
      "learningPoints": [
        {
          "code": "4am_khawass-qawasim_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "5 يقسم 25. ماذا تستنتج بالنسبة إلى $25 \\times 3$ ؟"
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "5 يقسم 90 و $25 \\times 3$: ماذا يقسم أيضًا؟"
        }
      ],
      "feedback": {
        "correct": "برهانك مطابق للحل النموذجي.",
        "incorrect": "قارن برهانك سطرًا بسطر بالحل النموذجي، وانتبه إلى كل مرحلة من مراحل الاستدلال."
      },
      "solution": {
        "lines": [
          "5 يقسم 25، فهو يقسم كل مضاعف له، ومنه 5 يقسم $25 \\times 3 = 75$.",
          "5 يقسم كلا من 90 و 75، فهو يقسم فرقهما $90 - 75 = 15$ (الخاصية 1).",
          "إذن 5 يقسم باقي القسمة الإقليدية للعدد 90 على 25 (الخاصية 2)."
        ]
      },
      "timeSeconds": 210
    }
  ]
