  "statement": {
    "content": "من الكتاب (ص 11): $n$ ، $a$ و $b$ أعداد طبيعية حيث $n \\neq 0$. برهن أنه إذا كان $n$ يقسم كلا من $a$ و $b$ فإنّ $n$ يقسم $a + b$."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "لإثبات أن $n$ يقسم $a + b$ يكفي …",
      "learningPoints": [
        {
          "code": "4am_khawass-qawasim_P4",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "إيجاد عدد طبيعي k حيث a + b = n × k",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "التحقّق من أن a + b أكبر من n",
          "isCorrect": false
        },
        {
          "id": "C",
          "content": "إيجاد عدد طبيعي k حيث n = (a + b) × k",
          "isCorrect": false,
