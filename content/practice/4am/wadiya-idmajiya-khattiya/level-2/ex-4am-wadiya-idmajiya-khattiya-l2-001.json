      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب معامل $x^2$ فقط (عدد صحيح)",
      "expectedAnswer": "-8",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$x\\sqrt{8} \\times x\\sqrt{2} = x^2\\sqrt{16}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "انشر $\\left(\\dfrac{x}{2} - \\sqrt{2}\\right)^2$ بالمتطابقة $(a - b)^2 = a^2 - 2ab + b^2$ ثم اضرب في $-16$ ."
        }
      ],
      "feedback": {
        "correct": "$g(x) = -8x^2 + 17\\sqrt{2}x - 24$ .",
        "incorrect": "أعد النشر حدًّا حدًّا: $\\sqrt{8} = 2\\sqrt{2}$ و $\\sqrt{8} \\times \\sqrt{2} = 4$ ."
      },
      "solution": {
        "lines": [
          "$x\\sqrt{8}\\left(\\dfrac{1}{2} - x\\sqrt{2}\\right) = \\dfrac{2\\sqrt{2}}{2}x - 4x^2 = \\sqrt{2}x - 4x^2$",
          "$\\left(\\dfrac{x}{2} - \\sqrt{2}\\right)^2 = \\dfrac{x^2}{4} - \\sqrt{2}x + 2$",
          "$-16\\left(\\dfrac{x^2}{4} - \\sqrt{2}x + 2\\right) = -4x^2 + 16\\sqrt{2}x - 32$",
          "$g(x) = \\sqrt{2}x - 4x^2 + 8 - 4x^2 + 16\\sqrt{2}x - 32$"
        ],
        "result": "g(x) = -8x^2 + 17\\sqrt{2}x - 24"
      },
