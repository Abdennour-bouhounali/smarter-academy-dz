  "statement": {
    "content": "يخفّض محل للأجهزة الكهرومنزلية كل أسعاره بـ 10%. نسمّي $x$ سعر جهاز قبل التخفيض (بـ DA) و $f(x)$ سعره بعد التخفيض."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "عبّر عن $f(x)$ بدلالة $x$ .",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-khattiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب المعامل $a$ فقط في $f(x) = ax$ (عشري بالفاصلة)",
      "expectedAnswer": "0,9",
      "misconceptionSignatures": [
        {
          "value": "0.1",
          "id": "MISC-TAKHFID-NISBA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "بعد التخفيض يدفع الزبون $(100 - 10)\\%$ من السعر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "خفض مقدار بـ $t\\%$ هو ضربه في $1 - \\dfrac{t}{100}$ ."
        }
      ],
      "feedback": {
        "correct": "$f(x) = x - 0{,}1x = 0{,}9x$ .",
        "incorrect": "المعامل هو النسبة المدفوعة بعد التخفيض، لا نسبة التخفيض."
      },
      "solution": {
        "lines": [
          "$f(x) = x - \\dfrac{10}{100}x = (1 - 0{,}1)x = 0{,}9x$"
        ],
        "result": "f(x) = 0{,}9x"
      },
