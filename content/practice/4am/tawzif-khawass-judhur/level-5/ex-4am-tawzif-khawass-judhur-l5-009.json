          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اجمع الحدود التي فيها $\\sqrt{2}$ من جهة، والأعداد من جهة أخرى."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الحدّان $1$ و $-1$ متعاكسان."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$\\sqrt{2} + \\sqrt{2} = (1 + 1)\\sqrt{2}$."
        }
      ],
      "feedback": {
        "correct": "$x + y = \\sqrt{2} + \\sqrt{2} + 1 - 1$.",
        "incorrect": "اجمع الحدود المتشابهة بالخاصية التوزيعية."
      }
    },
    {
