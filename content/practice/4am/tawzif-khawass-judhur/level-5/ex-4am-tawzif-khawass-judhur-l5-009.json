  "questions": [
    {
      "id": "q1",
      "statement": "نعتبر $x = \\sqrt{2} + 1$ و $y = \\sqrt{2} - 1$. نكتب $x + y = k\\sqrt{2}$. ما قيمة $k$؟",
      "learningPoints": [
