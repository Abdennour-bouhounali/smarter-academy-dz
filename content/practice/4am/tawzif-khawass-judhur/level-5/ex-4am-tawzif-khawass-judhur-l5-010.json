    {
      "id": "q3",
      "step": "03",
      "statement": "اكتب نسبة الطول إلى العرض $\\dfrac{\\sqrt{5} + 1}{\\sqrt{5} - 1}$ على شكل نسبة مقامها عدد ناطق.",
      "learningPoints": [
        {
          "code": "4am_tawzif-khawass-judhur_P3",
          "role": "primary"
        },
        {
          "code": "4am_tawzif-khawass-judhur_P2",
