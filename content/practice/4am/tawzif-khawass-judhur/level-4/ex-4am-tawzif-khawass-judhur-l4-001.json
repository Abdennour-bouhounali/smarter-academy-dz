    {
      "id": "q3",
      "step": "02",
      "statement": "تبيان أن $\\dfrac{A^2}{33} - 3B = \\dfrac{1}{3}$ :",
      "learningPoints": [
        {
          "code": "4am_tawzif-khawass-judhur_P2",
          "role": "primary"
