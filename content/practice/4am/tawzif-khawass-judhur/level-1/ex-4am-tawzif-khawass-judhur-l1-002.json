  "questions": [
    {
      "id": "q1",
      "statement": "اكتب $4\\sqrt{3}$ على الشكل $\\sqrt{n}$. ما هو $n$؟",
      "learningPoints": [
        {
          "code": "4am_tawzif-khawass-judhur_P1",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد طبيعي",
      "expectedAnswer": "48",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اكتب المعامل 4 على شكل جذر: $4 = \\sqrt{16}$."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$\\sqrt{16} \\times \\sqrt{3} = \\sqrt{16 \\times 3}$."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب الجداء تحت الجذر."
        }
      ],
      "feedback": {
        "correct": "$4\\sqrt{3} = \\sqrt{4^2 \\times 3} = \\sqrt{16 \\times 3}$.",
        "incorrect": "ندخل المعامل تحت الجذر بتربيعه."
      }
    },
    {
