  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "اكتب العدد A على الشكل $a\\sqrt{3}$ حيث $a$ عدد طبيعي.",
      "learningPoints": [
        {
          "code": "4am_tawzif-khawass-judhur_P2",
          "role": "primary"
        },
        {
          "code": "4am_tawzif-khawass-judhur_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد طبيعي)",
      "expectedAnswer": "4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اكتب كل جذر على الشكل $x\\sqrt{3}$: ابحث عن أكبر مربع تامّ يقسم العدد الذي تحت الجذر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "استعمل $\\sqrt{m \\times 3} = \\sqrt{m} \\times \\sqrt{3}$ ثم احسب جذر المربع التامّ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع المعاملات بإشاراتها بالخاصية التوزيعية: $x\\sqrt{3} + y\\sqrt{3} = (x + y)\\sqrt{3}$."
        }
      ],
      "feedback": {
        "correct": "$A = 6\\sqrt{3} - 2\\sqrt{3} = 4\\sqrt{3}$.",
        "incorrect": "الجذر لا يتوزّع على الطرح: بسّط كل جذر على حدة ثم اطرح المعاملين."
      },
      "solution": {
        "lines": [
          "$A = \\sqrt{108} - \\sqrt{12}$",
          "$A = \\sqrt{36} \\times \\sqrt{3} - \\sqrt{4} \\times \\sqrt{3}$",
          "$A = 6\\sqrt{3} - 2\\sqrt{3}$",
          "$A = (6 - 2)\\sqrt{3}$"
        ],
        "result": "A = 4\\sqrt{3}"
      },
      "work": "optional",
      "timeSeconds": 180
    },
    {
