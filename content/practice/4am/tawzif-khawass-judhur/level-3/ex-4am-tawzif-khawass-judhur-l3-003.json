      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض A و B بالكتابتين اللتين وجدتهما في السؤالين 01 و 02."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب $8B$ أولًا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "استعمل المتطابقة $(x + y)(x - y) = x^2 - y^2$."
        }
      ],
      "feedback": {
        "correct": "$C = (4\\sqrt{3} + 1)(4\\sqrt{3} - 1) = 48 - 1 = 47$: عدد طبيعي.",
        "incorrect": "بعد التعويض يظهر جداء من الشكل $(x + y)(x - y)$، وتذكّر أن $(4\\sqrt{3})^2 = 16 \\times 3$."
      },
      "solution": {
        "lines": [
          "$C = (A + 1)(8B - 1)$",
          "$= (4\\sqrt{3} + 1)\\left(8 \\times \\dfrac{\\sqrt{3}}{2} - 1\\right)$",
          "$= (4\\sqrt{3} + 1)(4\\sqrt{3} - 1)$",
          "$= (4\\sqrt{3})^2 - 1^2$",
          "$= 16 \\times 3 - 1$"
        ],
        "result": "C = 47"
      },
