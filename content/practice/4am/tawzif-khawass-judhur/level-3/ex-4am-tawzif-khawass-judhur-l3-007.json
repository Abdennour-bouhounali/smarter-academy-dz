      "solution": {
        "lines": [
          "$A = 2\\sqrt{12} - 4\\sqrt{3} + \\sqrt{75} - \\sqrt{147}$",
          "$A = 2\\sqrt{4} \\times \\sqrt{3} - 4\\sqrt{3} + \\sqrt{25} \\times \\sqrt{3} - \\sqrt{49} \\times \\sqrt{3}$",
          "$A = 2 \\times 2\\sqrt{3} - 4\\sqrt{3} + 5\\sqrt{3} - 7\\sqrt{3}$",
          "$A = (4 - 4 + 5 - 7)\\sqrt{3}$"
        ],
        "result": "A = -2\\sqrt{3}"
      },
