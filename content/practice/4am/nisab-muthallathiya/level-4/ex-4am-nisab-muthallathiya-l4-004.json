      "solution": {
        "lines": [
          "لدينا:",
          "$CI^2 = 13^2 = 169$",
          "$TC^2 = 12^2 = 144$",
          "$TI^2 = 5^2 = 25$",
          "نلاحظ أنّ $CI^2 = TC^2 + TI^2$ .",
          "إذا المثلث $TIC$ قائم في $T$ حسب خاصية فيثاغورس العكسية."
        ]
      },
      "timeSeconds": 240
    },
