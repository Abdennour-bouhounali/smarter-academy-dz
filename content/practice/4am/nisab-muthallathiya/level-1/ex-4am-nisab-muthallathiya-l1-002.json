      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الوتر هو الضلع المقابل للزاوية القائمة في $A$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بالنسبة إلى الزاوية $\\widehat{ACB}$ : الضلع المجاور لها يمرّ برأسها $C$ ، والضلع المقابل لها لا يمرّ به."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "جيب تمام زاوية حادة = طول الضلع المجاور لها على طول الوتر."
        }
      ],
      "feedback": {
        "correct": "الوتر $[BC]$ ، المجاور للزاوية $[AC]$ والمقابل لها $[AB]$ ، إذن $\\cos\\widehat{ACB} = \\dfrac{AC}{BC}$ .",
        "incorrect": "عيّن أولا الوتر (مقابل الزاوية القائمة)، ثم المجاور (يمرّ بالرأس $C$) والمقابل؛ جيب تمام زاوية حادة = طول الضلع المجاور لها على طول الوتر."
      },
      "solution": {
        "lines": [
          "في المثلث $ABC$ القائم في $A$ : الوتر هو $[BC]$ ،",
          "الضلع المجاور للزاوية $\\widehat{ACB}$ هو $[AC]$ والضلع المقابل لها هو $[AB]$ .",
          "جيب تمام الزاوية = طول الضلع المجاور لها على طول الوتر."
        ],
        "result": "\\cos\\widehat{ACB} = \\dfrac{AC}{BC}"
