  "statement": {
    "content": "في وضعية الأسطوانة المحاطة بالمخروط (ارتفاعه $18\\,\\mathrm{cm}$ ونصف قطر قاعدته $6\\,\\mathrm{cm}$ )، تعطي خاصية طالس في نصف المقطع المحوري المساواة:",
    "formulas": [
      "\\dfrac{r}{6} = \\dfrac{18 - h}{18}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب $r$ في الحالة $h = 12\\,\\mathrm{cm}$ .",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-talis_P2",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد: الطول بـ cm",
      "expectedAnswer": "2",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $h$ بـ $12$ في المساواة."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{r}{6} = \\dfrac{6}{18}$ ومنه $r = 2\\,\\mathrm{cm}$ .",
        "incorrect": "عوّض $h$ ثم احسب $18 - h$ قبل ضرب الطرفين في $6$ ."
      },
      "solution": {
        "lines": [
          "$\\dfrac{r}{6} = \\dfrac{18 - 12}{18} = \\dfrac{6}{18}$",
          "$r = \\dfrac{6 \\times 6}{18}$"
