  "statement": {
    "content": "أسطوانة دوران ارتفاعها $h$ ونصف قطر قاعدتها $r$ ، مرسومة داخل مخروط دوران ارتفاعه $18\\,\\mathrm{cm}$ ونصف قطر قاعدته $6\\,\\mathrm{cm}$ ، في الحالة $h = r$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "ما قيمة $r$ (بالسنتيمتر)؟",
      "learningPoints": [
        {
          "code": "4am_wadiya-idmajiya-talis_P2",
          "role": "primary"
        }
      ],
      "answerType": "rational",
      "answerFormat": "عدد (صحيح أو عشري بالفاصلة، أو كسر)",
      "expectedAnswer": "4.5",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "في المقطع المحوري: $\\dfrac{r}{6} = \\dfrac{18 - h}{18}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عوّض h بـ r."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "حلّ المعادلة من الدرجة الأولى."
        }
      ],
      "feedback": {
        "correct": "$18r = 108 - 6r$ أي $24r = 108$ ومنه $r = 4{,}5\\,\\mathrm{cm}$ .",
        "incorrect": "نكتب مساواة طالس ثم نعوّض h بـ r."
      },
      "cognitiveDemand": "apply",
