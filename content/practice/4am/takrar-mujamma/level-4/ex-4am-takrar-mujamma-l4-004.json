  "statement": {
    "content": "علامات فرض في قسم من 25 تلميذا، منظّمة في فئات: $0 \\le n < 5$ : 2 ، $5 \\le n < 10$ : 8 ، $10 \\le n < 15$ : 10 ، $15 \\le n \\le 20$ : 5."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "التواتر المجمع الصاعد للفئة $10 \\le n < 15$ :",
      "learningPoints": [
        {
          "code": "4am_takrar-mujamma_P2",
          "role": "primary"
        }
      ],
      "difficulty": 3,
      "answerType": "rational",
      "answerFormat": "عدد عشري بالفاصلة أو كسر",
      "expectedAnswer": "0,8",
      "misconceptionSignatures": [
        {
          "id": "MISC-IHSA-TAWATUR-BILA-QISMA",
          "value": "20"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب أولا التكرار الكلي: مجموع كل التكرارات."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "التواتر المجمع هو التكرار المجمع مقسوما على التكرار الكلي."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اجمع التكرارات المعنية ثم اقسم المجموع على التكرار الكلي، واختزل الكسر إن أمكن."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{2 + 8 + 10}{25} = 0{,}8$",
        "incorrect": "راجع أي القيم تدخل في المجموع، ثم أعد الجمع (والقسمة على التكرار الكلي إن طُلب تواتر)."
      }
    }
  ]
