  "statement": {
    "content": "نعلم أن $\\cos 60^{\\circ} = \\dfrac{1}{2}$ و $\\sin 60^{\\circ} = \\dfrac{\\sqrt{3}}{2}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب القيمة المضبوطة لـ $\\tan 60^{\\circ}$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
