        {
          "id": "C",
          "content": "$\\dfrac{\\sqrt{3}}{4}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-DARB-BADAL-QISMA"
        },
        {
          "id": "D",
          "content": "$1{,}73$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-QIMA-MUQARRABA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الظل هو حاصل قسمة الجيب على جيب التمام: $\\tan 60^{\\circ} = \\dfrac{\\sin 60^{\\circ}}{\\cos 60^{\\circ}}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "القسمة على كسر هي الضرب في مقلوبه، ثم اختزل."
        }
      ],
      "feedback": {
        "correct": "$\\tan 60^{\\circ} = \\dfrac{\\frac{\\sqrt{3}}{2}}{\\frac{1}{2}} = \\dfrac{\\sqrt{3}}{2} \\times 2 = \\sqrt{3}$ .",
        "incorrect": "اقسم الجيب على جيب التمام (لا تضرب)، والقيمة المضبوطة لا تُدوَّر."
      },
      "solution": {
        "lines": [
          "$\\tan 60^{\\circ} = \\dfrac{\\sin 60^{\\circ}}{\\cos 60^{\\circ}} = \\dfrac{\\sqrt{3}}{2} \\div \\dfrac{1}{2} = \\dfrac{\\sqrt{3}}{2} \\times 2$",
          "$1{,}73$ قيمة مقربة فقط."
        ],
        "result": "\\tan 60^{\\circ} = \\sqrt{3}"
      },
      "timeSeconds": 120
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "تحقّق أن $(\\cos 60^{\\circ})^2 + (\\sin 60^{\\circ})^2 = 1$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "ربّع كل كسر: مربع البسط على مربع المقام."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$(\\sqrt{3})^2 = 3$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{1}{4} + \\dfrac{3}{4} = 1$ .",
        "incorrect": "قارن برهانك بالحل النموذجي سطرا سطرا، ثم قيّم إجابتك."
      },
      "solution": {
        "lines": [
          "$(\\cos 60^{\\circ})^2 + (\\sin 60^{\\circ})^2 = \\left(\\dfrac{1}{2}\\right)^2 + \\left(\\dfrac{\\sqrt{3}}{2}\\right)^2$",
          "$= \\dfrac{1}{4} + \\dfrac{3}{4}$",
          "$= 1$"
        ]
      },
      "timeSeconds": 120
    }
  ]
