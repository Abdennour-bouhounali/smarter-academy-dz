        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\dfrac{\\sqrt{3}}{3}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-TAN-QISMA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$\\sqrt{3}$",
