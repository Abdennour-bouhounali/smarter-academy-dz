        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "1/2",
      "misconceptionSignatures": [
        {
