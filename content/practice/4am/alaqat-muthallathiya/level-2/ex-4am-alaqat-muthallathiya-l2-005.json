  "statement": {
    "content": "$x$ هو قيس زاوية حادة حيث $\\sin x = \\dfrac{\\sqrt{3}}{2}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "بدون استعمال حاسبة، عيّن القيمة المضبوطة للعدد $\\cos x$ .",
      "learningPoints": [
