          "id": "MISC-MUTH-JADHR-NASI"
        },
        {
          "value": "-1/2",
          "id": "MISC-MUTH-AKBAR-MIN-WAHID"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العلاقة التي تربط جيب الزاوية وجيب تمامها هي $\\cos^2 x + \\sin^2 x = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اعزل $\\cos^2 x$ ثم عوّض الجيب بقيمته، ولا تنس تربيع البسط والمقام معا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$\\cos x$ عدد موجب تماما: خذ الجذر التربيعي الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\cos^2 x = 1 - \\dfrac{3}{4} = \\dfrac{1}{4}$ ، إذن $\\cos x = \\dfrac{1}{2}$ .",
        "incorrect": "بعد حساب $\\cos^2 x$ خذ الجذر الموجب."
      },
      "solution": {
        "lines": [
          "$\\cos^2 x = 1 - \\sin^2 x = 1 - \\left(\\dfrac{\\sqrt{3}}{2}\\right)^2 = 1 - \\dfrac{3}{4} = \\dfrac{1}{4}$",
          "$\\cos x > 0$ ، إذن $\\cos x = \\sqrt{\\dfrac{1}{4}}$"
        ],
        "result": "\\cos x = \\dfrac{1}{2}"
      },
      "work": "optional",
      "timeSeconds": 120
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "استنتج قيمة مقربة للعدد $\\tan x$ ، تدوّر النتيجة إلى الجزء من 100.",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "عدد عشري مدوّر إلى 0,01",
      "expectedAnswer": "1.73",
      "misconceptionSignatures": [
