          "value": "0.58",
          "id": "MISC-MUTH-TAN-QISMA-MAQLUBA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "احسب أولا القيمة المضبوطة $\\tan x = \\dfrac{\\sin x}{\\cos x}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ثم استعمل الحاسبة ودوّر."
        }
      ],
      "feedback": {
        "correct": "$\\tan x = \\dfrac{\\sqrt{3}}{2} \\times 2 = \\sqrt{3} \\simeq 1{,}732$ ، إذن $\\tan x \\approx 1{,}73$ .",
        "incorrect": "الجيب في البسط وجيب التمام في المقام، ثم دوّر."
      },
      "solution": {
        "lines": [
          "$\\tan x = \\dfrac{\\sin x}{\\cos x} = \\dfrac{\\sqrt{3}}{2} \\div \\dfrac{1}{2} = \\sqrt{3}$",
          "بالحاسبة: $\\sqrt{3} \\simeq 1{,}7320508$"
        ],
        "result": "\\tan x \\approx 1{,}73"
      },
