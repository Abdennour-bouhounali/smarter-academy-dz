  "statement": {
    "content": "$x$ هو قيس زاوية حادة حيث $\\cos x = \\dfrac{\\sqrt{2}}{2}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب، بدون استعمال حاسبة، القيمة المضبوطة للعدد $\\sin x$ .",
      "learningPoints": [
