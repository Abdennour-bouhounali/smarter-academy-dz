  "statement": {
    "content": "من الكتاب: x هو قيس زاوية حادة حيث $\\cos x = 0{,}6$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "احسب القيمة المضبوطة للعدد $\\sin x$ :",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "answerType": "rational",
      "answerFormat": "عدد عشري بالفاصلة (مثل 2,5)",
      "expectedAnswer": "0.8",
      "misconceptionSignatures": [
        {
          "id": "MISC-MUTH-JADHR-NASI",
          "value": "0.4"
        },
        {
          "id": "MISC-MUTH-JADHR-NASI",
          "value": "0.64"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sin^2 x = 1 - \\cos^2 x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$\\sin x$ عدد موجب: الجذر الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\sin^2 x = 1 - 0{,}36 = 0{,}64$ فـ $\\sin x = 0{,}8$ .",
        "incorrect": "لا تطرح 0,6 من 1: العلاقة بين المربعين."
      }
    },
    {
      "id": "q2",
      "statement": "استنتج القيمة المضبوطة للعدد $\\tan x$ (كسر):",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "answerType": "rational",
      "answerFormat": "عدد (كسر مثل 5/7 أو عشري بالفاصلة)",
      "expectedAnswer": "4/3",
      "misconceptionSignatures": [
        {
          "id": "MISC-MUTH-TAN-QISMA-MAQLUBA",
          "value": "3/4"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\tan x = \\dfrac{\\sin x}{\\cos x}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب $\\sin x$ أولا من $\\cos x = 0{,}6$ ."
        }
      ],
      "feedback": {
        "correct": "$\\tan x = \\dfrac{0{,}8}{0{,}6} = \\dfrac{4}{3}$ .",
        "incorrect": "الجيب في البسط: $\\dfrac{0{,}8}{0{,}6}$ ."
      }
    }
  ]
