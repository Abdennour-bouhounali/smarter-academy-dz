      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "من $\\tan x = \\dfrac{\\sin x}{\\cos x}$ نستنتج $\\sin x = \\tan x \\times \\cos x$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب الكسرين ثم اختزل."
        }
      ],
      "feedback": {
        "correct": "$\\sin\\widehat{FEG} = \\dfrac{8}{15} \\times \\dfrac{15}{17} = \\dfrac{8}{17}$ .",
        "incorrect": "الجيب = الظل × جيب التمام (ضرب لا قسمة)."
      },
      "solution": {
        "lines": [
          "$\\tan\\widehat{FEG} = \\dfrac{\\sin\\widehat{FEG}}{\\cos\\widehat{FEG}}$ ، إذن $\\sin\\widehat{FEG} = \\tan\\widehat{FEG} \\times \\cos\\widehat{FEG}$",
          "$\\sin\\widehat{FEG} = \\dfrac{8}{15} \\times \\dfrac{15}{17}$"
        ],
        "result": "\\sin\\widehat{FEG} = \\dfrac{8}{17}"
      },
      "work": "optional",
      "timeSeconds": 150
    },
    {
      "id": "q2",
      "step": "02",
      "lead": "احسب الطولين $FG$ و $EG$ .",
      "statement": "الطول $FG$ :",
