      "step": "01",
      "statement": "باستعمال العلاقة $\\tan x = \\dfrac{\\sin x}{\\cos x}$ ، استنتج $\\sin\\widehat{FEG}$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال أو عدد عشري (قيمة مضبوطة)",
