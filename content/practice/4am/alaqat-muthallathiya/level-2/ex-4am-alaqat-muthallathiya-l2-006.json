          "id": "h1",
          "type": "look",
          "content": "بالنسبة إلى الزاوية $\\widehat{FEG}$ : $[FG]$ مقابل و $[EF]$ مجاور."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الظل يربط المقابل بالمجاور."
        }
      ],
      "feedback": {
        "correct": "$FG = EF \\times \\tan\\widehat{FEG} = 7{,}5 \\times \\dfrac{8}{15} = 4\\,\\mathrm{cm}$ .",
