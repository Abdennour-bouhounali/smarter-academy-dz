      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العلاقة التي تربط جيب الزاوية وجيب تمامها هي $\\cos^2 x + \\sin^2 x = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اعزل $\\sin^2 x$ ثم عوّض جيب التمام بقيمته، ولا تنس تربيع البسط والمقام معا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$\\sin x$ عدد موجب تماما: خذ الجذر التربيعي الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\sin^2 x = 1 - 0{,}16 = 0{,}84 = \\dfrac{21}{25}$ ، إذن $\\sin x = \\dfrac{\\sqrt{21}}{5}$ .",
        "incorrect": "احسب $\\sin^2 x$ بالعلاقة بين المربعين، اكتبه كسرا مقامه 25، ثم خذ الجذر."
      },
      "solution": {
        "lines": [
          "$\\sin^2 x = 1 - \\cos^2 x = 1 - 0{,}16 = 0{,}84 = \\dfrac{21}{25}$",
          "$\\sin x > 0$ ، إذن $\\sin x = \\dfrac{\\sqrt{21}}{5}$"
        ],
        "result": "\\sin x = \\dfrac{\\sqrt{21}}{5}"
      },
      "work": "optional",
