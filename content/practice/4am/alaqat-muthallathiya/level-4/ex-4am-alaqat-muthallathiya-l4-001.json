  "statement": {
    "content": "$x$ قيس بالدرجات لزاوية حادة. بدون حساب قيمة $x$ ، نريد أن نتمم، إن أمكن، الجدول الآتي:",
    "table": {
      "head": [
        "",
        "(1)",
        "(2)",
        "(3)"
      ],
      "rows": [
        [
          "$\\cos x$",
          "$0{,}4$",
          "…",
          "…"
        ],
        [
          "$\\sin x$",
          "…",
          "$\\dfrac{3}{2}$",
          "$\\dfrac{\\sqrt{5}}{2}$"
        ],
        [
          "$\\tan x$",
          "…",
          "…",
          "…"
        ]
      ]
    }
  },
