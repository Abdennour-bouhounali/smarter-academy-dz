  "statement": {
    "content": "كابل تليفريك قسنطينة يصنع مع الأفق زاوية حادة x ، وقرأ مهندس على مخططه أن $\\sin x = 0{,}28$ بالضبط."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "احسب القيمة المضبوطة للعدد $\\cos x$ :",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 4,
      "answerType": "rational",
      "answerFormat": "عدد عشري بالفاصلة (مثل 2,5)",
      "expectedAnswer": "0.96",
      "misconceptionSignatures": [
        {
          "id": "MISC-MUTH-JADHR-NASI",
          "value": "0.72"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\cos^2 x = 1 - 0{,}28^2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ابحث عن عدد موجب مربعه $0{,}9216$ ."
        }
      ],
      "feedback": {
        "correct": "$\\cos^2 x = 1 - 0{,}0784 = 0{,}9216$ ، فـ $\\cos x = 0{,}96$ .",
        "incorrect": "لا تطرح 0,28 من 1: العلاقة بين المربعين."
      }
    },
    {
      "id": "q2",
      "statement": "احسب القيمة المضبوطة للعدد $\\tan x$ (كسر):",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P2",
          "role": "primary"
        }
      ],
      "difficulty": 5,
      "answerType": "rational",
      "answerFormat": "عدد (كسر مثل 5/7 أو عشري بالفاصلة)",
      "expectedAnswer": "7/24",
      "misconceptionSignatures": [
        {
          "id": "MISC-MUTH-TAN-QISMA-MAQLUBA",
          "value": "24/7"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\tan x = \\dfrac{\\sin x}{\\cos x}$ و $\\cos x = 0{,}96$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اختزل $\\dfrac{28}{96}$ ."
        }
      ],
      "feedback": {
        "correct": "$\\tan x = \\dfrac{0{,}28}{0{,}96} = \\dfrac{28}{96} = \\dfrac{7}{24}$ .",
        "incorrect": "الجيب في البسط."
      }
    }
  ]
