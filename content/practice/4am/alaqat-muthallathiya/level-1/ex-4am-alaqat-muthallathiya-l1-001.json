  "statement": {
    "content": "من الكتاب: من أجل كل قيس زاوية حادة x في مثلث قائم، لدينا:"
  },
  "questions": [
    {
      "id": "q1",
      "statement": "اختر الكتابة الصحيحة:",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\cos^2 x = \\sin^2 x - 1$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-ISHARA-ALAQA"
        },
        {
          "id": "B",
          "content": "$\\cos x = 1 - \\sin x$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-JAMA-NISAB"
        },
        {
          "id": "C",
          "content": "$\\cos^2 x = 1 - \\sin^2 x$",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "انطلق من $\\cos^2 x + \\sin^2 x = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اطرح $\\sin^2 x$ من الطرفين."
        }
      ],
      "feedback": {
        "correct": "من $\\cos^2 x + \\sin^2 x = 1$ نطرح $\\sin^2 x$ : $\\cos^2 x = 1 - \\sin^2 x$ .",
        "incorrect": "جرّب على $x = 60^{\\circ}$ : $\\cos^2 60^{\\circ} = \\dfrac{1}{4}$ و $1 - \\sin^2 60^{\\circ} = 1 - \\dfrac{3}{4} = \\dfrac{1}{4}$ ."
      }
    }
  ]
