  "statement": {
    "content": "الكتابة $\\sin^2 x$ تعني $(\\sin x)^2$ . نعلم أن $\\sin 30^{\\circ} = \\dfrac{1}{2}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "احسب $\\sin^2 30^{\\circ}$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "cognitiveDemand": "recall",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "1/4",
      "misconceptionSignatures": [
        {
          "value": "1/2",
          "id": "MISC-MUTH-TARBI-BASTI"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sin^2 30^{\\circ}$ هو مربع العدد $\\sin 30^{\\circ}$ ، وليس جيب $30^2$ ولا ضعف الجيب."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ربّع البسط والمقام."
        }
      ],
      "feedback": {
        "correct": "$\\sin^2 30^{\\circ} = \\left(\\dfrac{1}{2}\\right)^2 = \\dfrac{1}{4}$ .",
        "incorrect": "الكتابة $\\sin^2 30^{\\circ}$ تعني $(\\sin 30^{\\circ})^2$ : ربّع الكسر كله."
      },
      "solution": {
        "lines": [
          "$\\sin^2 30^{\\circ} = (\\sin 30^{\\circ})^2 = \\left(\\dfrac{1}{2}\\right)^2$"
        ],
        "result": "\\sin^2 30^{\\circ} = \\dfrac{1}{4}"
      },
      "timeSeconds": 60
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "استنتج $\\cos^2 30^{\\circ}$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال أو عدد عشري (قيمة مضبوطة)",
      "expectedAnswer": "3/4",
      "misconceptionSignatures": [
        {
          "value": "1/2",
          "id": "MISC-MUTH-JAMA-NISAB"
        },
        {
          "value": "-3/4",
          "id": "MISC-MUTH-ISHARA-ALAQA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "استعمل العلاقة $\\cos^2 x + \\sin^2 x = 1$ من أجل $x = 30^{\\circ}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اعزل $\\cos^2 30^{\\circ}$ ثم عوّض."
        }
      ],
      "feedback": {
        "correct": "$\\cos^2 30^{\\circ} = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$ .",
        "incorrect": "اعزل مربع جيب التمام في العلاقة: $\\cos^2 x = 1 - \\sin^2 x$ ، واستعمل نتيجة السؤال 01."
      },
      "solution": {
        "lines": [
          "$\\cos^2 30^{\\circ} + \\sin^2 30^{\\circ} = 1$ ، إذن $\\cos^2 30^{\\circ} = 1 - \\sin^2 30^{\\circ}$",
          "$\\cos^2 30^{\\circ} = 1 - \\dfrac{1}{4}$"
        ],
        "result": "\\cos^2 30^{\\circ} = \\dfrac{3}{4}"
      },
