          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-JADHR-NASI"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\sin^2 60^{\\circ} = 1 - \\cos^2 60^{\\circ}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "ثم الجذر الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\sin^2 60^{\\circ} = 1 - \\dfrac{1}{4} = \\dfrac{3}{4}$ ، فـ $\\sin 60^{\\circ} = \\dfrac{\\sqrt{3}}{2}$ .",
        "incorrect": "$\\dfrac{3}{4}$ هو المربع، و $1 - \\dfrac{1}{2}$ طرح النسبة دون تربيع."
