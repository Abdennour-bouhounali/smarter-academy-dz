      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العلاقة التي تربط جيب الزاوية وجيب تمامها هي $\\cos^2 x + \\sin^2 x = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اعزل $\\sin^2 x$ ثم عوّض جيب التمام بقيمته، ولا تنس تربيع البسط والمقام معا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$\\sin x$ عدد موجب تماما: خذ الجذر التربيعي الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\sin^2 x = 1 - \\dfrac{9}{16} = \\dfrac{7}{16}$ ، إذن $\\sin x = \\dfrac{\\sqrt{7}}{4}$ .",
        "incorrect": "احسب $\\sin^2 x$ بالعلاقة بين المربعين، ثم خذ الجذر الموجب للبسط وللمقام."
      },
      "solution": {
        "lines": [
          "$\\sin^2 x = 1 - \\cos^2 x = 1 - \\dfrac{9}{16} = \\dfrac{7}{16}$",
          "$\\sin x > 0$ ، إذن $\\sin x = \\dfrac{\\sqrt{7}}{\\sqrt{16}}$"
        ],
        "result": "\\sin x = \\dfrac{\\sqrt{7}}{4}"
      },
      "timeSeconds": 150
    },
