      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "العلاقة التي تربط جيب الزاوية وجيب تمامها هي $\\cos^2 \\widehat{ABC} + \\sin^2 \\widehat{ABC} = 1$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اعزل $\\cos^2 \\widehat{ABC}$ ثم عوّض الجيب بقيمته، ولا تنس تربيع البسط والمقام معا."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "$\\cos \\widehat{ABC}$ عدد موجب تماما: خذ الجذر التربيعي الموجب."
        }
      ],
      "feedback": {
        "correct": "$\\cos^2\\widehat{ABC} = 1 - \\dfrac{9}{25} = \\dfrac{16}{25}$ ، إذن $\\cos\\widehat{ABC} = \\dfrac{4}{5}$ .",
        "incorrect": "استعمل العلاقة بين المربعين ثم الجذر الموجب."
      },
      "solution": {
        "lines": [
          "$\\cos^2\\widehat{ABC} = 1 - \\sin^2\\widehat{ABC} = 1 - \\dfrac{9}{25} = \\dfrac{16}{25}$",
          "$\\cos\\widehat{ABC} > 0$ ، إذن $\\cos\\widehat{ABC} = \\sqrt{\\dfrac{16}{25}}$"
        ],
        "result": "\\cos\\widehat{ABC} = \\dfrac{4}{5}"
      },
      "work": "optional",
      "timeSeconds": 150
    },
    {
