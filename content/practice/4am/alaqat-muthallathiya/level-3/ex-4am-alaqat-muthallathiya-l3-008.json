      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\tan x = \\dfrac{\\sin x}{\\cos x}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "بعد الاختزال اضرب البسط والمقام في $\\sqrt{5}$ ."
        }
      ],
      "feedback": {
        "correct": "$\\tan x = \\dfrac{2}{3} \\times \\dfrac{3}{\\sqrt{5}} = \\dfrac{2}{\\sqrt{5}} = \\dfrac{2\\sqrt{5}}{5}$ .",
        "incorrect": "اقسم الجيب على جيب التمام، ثم اجعل المقام عددا ناطقا."
      },
      "solution": {
        "lines": [
          "$\\tan x = \\dfrac{\\sin x}{\\cos x} = \\dfrac{2}{3} \\div \\dfrac{\\sqrt{5}}{3} = \\dfrac{2}{\\sqrt{5}}$",
          "$\\tan x = \\dfrac{2 \\times \\sqrt{5}}{\\sqrt{5} \\times \\sqrt{5}}$"
        ],
        "result": "\\tan x = \\dfrac{2\\sqrt{5}}{5}"
      },
