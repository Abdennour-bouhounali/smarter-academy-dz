      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الظل هو حاصل قسمة الجيب على جيب التمام: $\\tan 45^{\\circ} = \\dfrac{\\sin 45^{\\circ}}{\\cos 45^{\\circ}}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "القسمة على كسر هي الضرب في مقلوبه، ثم اختزل."
        }
      ],
      "feedback": {
        "correct": "$\\tan 45^{\\circ} = \\dfrac{BC}{AB} = 1$ .",
        "incorrect": "اقسم الجيب على جيب التمام، أو المقابل على المجاور."
      },
      "solution": {
        "lines": [
          "$\\tan 45^{\\circ} = \\dfrac{\\sin 45^{\\circ}}{\\cos 45^{\\circ}} = \\dfrac{BC}{AB} = \\dfrac{1}{1}$"
