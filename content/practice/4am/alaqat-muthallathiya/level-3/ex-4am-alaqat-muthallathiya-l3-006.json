  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "برّر صحة المساواة $AC = \\sqrt{2}$ .",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "المثلث $ABC$ قائم في $B$ ، ووتره $[AC]$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "طبّق خاصية فيثاغورس."
        }
      ],
      "feedback": {
        "correct": "$AC^2 = 1^2 + 1^2 = 2$ ، إذن $AC = \\sqrt{2}$ .",
        "incorrect": "قارن برهانك بالحل النموذجي سطرا سطرا، ثم قيّم إجابتك."
      },
      "solution": {
        "lines": [
          "المثلث $ABC$ قائم في $B$ (زاوية المربع).",
          "بتطبيق خاصية فيثاغورس: $AC^2 = AB^2 + BC^2 = 1 + 1 = 2$",
          "إذن $AC = \\sqrt{2}$ ."
        ]
      },
      "timeSeconds": 120
    },
    {
      "id": "q2",
      "step": "02",
      "lead": "استنتج القيم المضبوطة لكل من $\\cos 45^{\\circ}$ ، $\\sin 45^{\\circ}$ و $\\tan 45^{\\circ}$ .",
      "statement": "القيمة المضبوطة لـ $\\cos 45^{\\circ}$ :",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\sqrt{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-NISBA-MAQLUBA"
        },
        {
          "id": "B",
          "content": "$\\dfrac{\\sqrt{2}}{2}$",
          "isCorrect": true
        },
        {
          "id": "C",
          "content": "$\\dfrac{1}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-JADHR-NASI"
        },
        {
          "id": "D",
          "content": "$0{,}71$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-QIMA-MUQARRABA"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "في المثلث $ABC$ القائم في $B$ : جيب تمام الزاوية $\\widehat{BAC}$ هو المجاور على الوتر."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اجعل المقام عددا ناطقا."
        }
      ],
      "feedback": {
        "correct": "$\\cos 45^{\\circ} = \\dfrac{AB}{AC} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{\\sqrt{2}}{2}$ .",
        "incorrect": "الوتر في المقام دائما، والقيمة المضبوطة لا تُدوَّر."
      },
      "solution": {
        "lines": [
          "$\\cos 45^{\\circ} = \\cos\\widehat{BAC} = \\dfrac{AB}{AC} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{1 \\times \\sqrt{2}}{\\sqrt{2} \\times \\sqrt{2}}$"
        ],
        "result": "\\cos 45^{\\circ} = \\dfrac{\\sqrt{2}}{2}"
      },
      "timeSeconds": 120
    },
    {
      "id": "q3",
      "step": "02",
      "statement": "اكتب $\\sin 45^{\\circ}$ على الشكل $\\dfrac{\\sqrt{a}}{2}$ حيث $a$ عدد طبيعي.",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 2,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $a$ فقط (عدد طبيعي)",
      "expectedAnswer": "2",
      "misconceptionSignatures": [
        {
          "value": "1",
          "id": "MISC-MUTH-JADHR-NASI"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$[BC]$ مقابل للزاوية $\\widehat{BAC}$ ، أو استعمل العلاقة $\\cos^2 x + \\sin^2 x = 1$ ."
        }
      ],
      "feedback": {
        "correct": "$\\sin 45^{\\circ} = \\dfrac{BC}{AC} = \\dfrac{1}{\\sqrt{2}} = \\dfrac{\\sqrt{2}}{2}$ .",
        "incorrect": "الجيب = المقابل على الوتر، ثم اجعل المقام عددا ناطقا."
      },
      "solution": {
        "lines": [
          "$\\sin 45^{\\circ} = \\dfrac{BC}{AC} = \\dfrac{1}{\\sqrt{2}}$",
          "أو: $\\sin^2 45^{\\circ} = 1 - \\dfrac{2}{4} = \\dfrac{1}{2}$"
        ],
        "result": "\\sin 45^{\\circ} = \\dfrac{\\sqrt{2}}{2}"
      },
      "timeSeconds": 90
    },
    {
      "id": "q4",
      "step": "02",
      "statement": "$\\tan 45^{\\circ}$ :",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "كسر غير قابل للاختزال أو عدد عشري (قيمة مضبوطة)",
