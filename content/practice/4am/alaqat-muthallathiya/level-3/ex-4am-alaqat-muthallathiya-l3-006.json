  "questions": [
    {
      "id": "q1",
      "statement": "القيمة المضبوطة للعدد $\\cos 45^{\\circ}$ :",
      "learningPoints": [
        {
          "code": "4am_alaqat-muthallathiya_P1",
          "role": "primary"
        }
      ],
      "difficulty": 3,
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$\\dfrac{\\sqrt{2}}{2}$",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "$\\sqrt{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-NISBA-MAQLUBA"
        },
        {
          "id": "C",
          "content": "$\\dfrac{1}{2}$",
          "isCorrect": false,
          "misconceptionId": "MISC-MUTH-JADHR-NASI"
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$\\cos 45^{\\circ} = \\dfrac{AB}{AC}$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اضرب البسط والمقام في $\\sqrt{2}$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{1}{\\sqrt{2}} = \\dfrac{\\sqrt{2}}{2}$ ، و $\\cos^2 45^{\\circ} + \\sin^2 45^{\\circ} = \\dfrac{1}{2} + \\dfrac{1}{2} = 1$ .",
        "incorrect": "$\\sqrt{2} = \\dfrac{AC}{AB}$ مقلوبة وأكبر من 1، و $\\dfrac{1}{2}$ هو $\\cos^2 45^{\\circ}$ ."
      }
    }
  ]
