    {
      "id": "q1",
      "step": "01",
      "statement": "ارسم المثلث $ABC$ القائم في $A$ حيث: $BC = 7{,}5\\,\\mathrm{cm}$ ، $AB = 4{,}5\\,\\mathrm{cm}$ .",
      "learningPoints": [
        {
          "code": "4am_aksiya-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 1,
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "صف إنشاءك هنا (وارسمه على ورقتك)، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "الزاوية القائمة في $A$ : ابدأ بالضلع $[AB]$ والعمودي عليه في $A$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "النقطة $C$ على العمودي، وعلى بعد $7{,}5\\,\\mathrm{cm}$ من $B$ (المدور)."
        }
      ],
      "feedback": {
        "correct": "مثلث قائم في $A$ ، $AB = 4{,}5\\,\\mathrm{cm}$ و $BC = 7{,}5\\,\\mathrm{cm}$ .",
        "incorrect": "قارن برهانك بالحل النموذجي: الاستقامية، الترتيب نفسه، تساوي النسبتين، ثم ذكر الخاصية العكسية لخاصية طالس."
      },
      "solution": {
        "lines": [
          "نرسم القطعة $[AB]$ طولها $4{,}5\\,\\mathrm{cm}$ ، ثم نصف المستقيم العمودي على $(AB)$ في $A$ ،",
          "ثم الدائرة التي مركزها $B$ ونصف قطرها $7{,}5\\,\\mathrm{cm}$ : تقطع نصف المستقيم في النقطة $C$ ."
        ]
      },
      "timeSeconds": 180
    },
    {
