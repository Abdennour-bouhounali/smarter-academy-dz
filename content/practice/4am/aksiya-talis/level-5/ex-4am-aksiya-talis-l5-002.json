      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "تحقّق أولا من ترتيب النقط على المستقيمين المتقاطعين."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "احسب النسبتين وقارنهما بالجداء المتصالب، لا بقيم مقرّبة."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "نسبتان متساويتان مع نفس الترتيب: الخاصية العكسية. نسبتان مختلفتان: نستدل بالخلف بخاصية طالس."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{DE}{DC} = \\dfrac{DF}{DB}$ و $DB = DC$ (D منتصف [BC]) إذن $DE = DF$ .",
