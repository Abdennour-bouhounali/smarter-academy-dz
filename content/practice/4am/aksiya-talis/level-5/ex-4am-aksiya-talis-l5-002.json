      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "حدّد النقطة المشتركة بين المستقيمين، ثم الطولين المعنيين على المستقيم نفسه."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "النسبة: طول يبدأ من النقطة المشتركة مقسوما على الطول الموافق له على المستقيم نفسه."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "اكتب الكسر ثم اختزله (أو احسب قيمته المضبوطة)."
        }
      ],
      "feedback": {
        "correct": "خاصية طالس في المثلث DAC: $\\dfrac{DE}{DC} = \\dfrac{DM}{DA}$ .",
        "incorrect": "راجع: من أي نقطة يبدأ كل طول؟ وهل اختزلت الكسر؟"
      }
    },
    {
      "id": "q2",
      "statement": "ومنه، لأن $\\dfrac{DF}{DB} = \\dfrac{DM}{DA}$ أيضا:",
      "learningPoints": [
        {
          "code": "4am_aksiya-talis_P1",
          "role": "primary"
        }
      ],
      "difficulty": 5,
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "$DE = DF$ لأن $DB = DC$ ، و D منتصف [EF]",
          "isCorrect": true
        },
