  "statement": {
    "content": "من الكتاب (ص 60): عيّن ذهنيا الثنائية حل الجملة $\\begin{cases} x = \\dfrac{1}{3} \\\\ 3x - y = 4 \\end{cases}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "ما هي الثنائية $(x ; y)$ حل الجملة؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P2",
          "role": "primary"
        }
      ],
      "answerType": "point",
      "answerFormat": "الثنائية $(x ; y)$ : العدد الأول ثم الثاني (عدد صحيح أو كسر مثل 2/5)",
      "expectedAnswer": {
        "x": "1/3",
        "y": "-3"
      },
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "قيمة $x$ معطاة في المعادلة الأولى."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عوّض $x = \\dfrac{1}{3}$ في $3x - y = 4$ : $1 - y = 4$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "احسب $y$ ثم اكتب الثنائية."
        }
      ],
      "feedback": {
        "correct": "$x = \\dfrac{1}{3}$ و $1 - y = 4$ أي $y = -3$ : $\\left(\\dfrac{1}{3} ; -3\\right)$ .",
