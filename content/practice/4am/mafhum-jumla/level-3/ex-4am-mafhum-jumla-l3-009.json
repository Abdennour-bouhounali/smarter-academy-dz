  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "هل الثنائية $(1 ; 2)$ حل لهذه الجملة؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "نعم",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-MUADALA-WAHIDA"
        },
        {
          "id": "B",
          "content": "لا",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ $1$ و $y$ بـ $2$ في كل معادلة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الثنائية حل للجملة إذا حققت المعادلتين في آن واحد."
        }
      ],
      "feedback": {
        "correct": "$2 \\times 1 - 2 = 0$ ؛ $-1 + \\dfrac{1}{2} \\times 2 = 0 \\neq -2$ : الثنائية ليست حلا للجملة.",
        "incorrect": "العدد الأول في الثنائية قيمة $x$ والثاني قيمة $y$ ؛ عوّض في المعادلتين معا وقارن كل نتيجة بالطرف الثاني."
      },
      "solution": {
        "lines": [
          "نعوّض $x$ بـ $1$ و $y$ بـ $2$ :",
          "$2 \\times 1 - 2 = 0$",
          "$-1 + \\dfrac{1}{2} \\times 2 = 0 \\neq -2$",
          "ومنه الثنائية $(1 ; 2)$ ليست حلا للجملة (لا تحقق المعادلتين معا)."
        ]
      },
      "timeSeconds": 90
    },
    {
      "id": "q2",
      "step": "02",
      "statement": "اضرب طرفي المعادلة الثانية في $-2$ ، ثم اكتب المعادلة الناتجة على الشكل $2x - y = c$ . أعط العدد $c$ .",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P4",
          "role": "primary"
        },
        {
          "code": "4am_mafhum-jumla_P1",
          "role": "secondary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $c$ فقط",
      "expectedAnswer": "4",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "اضرب كل حد من الطرفين في $-2$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$-2 \\times \\dfrac{y}{2} = -y$ ."
        }
      ],
      "feedback": {
        "correct": "$2x - y = 4$ .",
        "incorrect": "اضرب كل الحدود، في الطرفين، في $-2$ ."
      },
      "solution": {
        "lines": [
          "$-2 \\times \\left(-x + \\dfrac{y}{2}\\right) = -2 \\times (-2)$",
          "$2x - y = 4$"
        ],
        "result": "2x - y = 4"
      },
      "timeSeconds": 120
    },
    {
