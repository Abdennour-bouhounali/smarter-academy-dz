  "statement": {
    "content": "نعتبر الجملة التالية، وهي من الشكل $\\begin{cases} ax + by = c \\\\ a'x + b'y = c' \\end{cases}$ :",
    "formulas": [
      "\\begin{cases} x - y = 2 \\\\ 2x - 5y = 4 \\end{cases}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "sub": "ا",
      "lead": "عيّن معاملات الجملة:",
      "statement": "المعامل $b$ :",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $b$ فقط (عدد صحيح)",
      "expectedAnswer": "-1",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$b$ هو معامل $y$ في المعادلة الأولى."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الحدّ $-y$ يُكتب $(-1) \\times y$ ."
        }
      ],
      "feedback": {
        "correct": "$x - y = 1x + (-1)y$ : $b = -1$ .",
        "incorrect": "المعامل يُقرأ مع إشارته: معامل $y$ في $x - y$ ليس 1."
      },
      "solution": {
        "lines": [
          "$x - y = 2$ تُكتب $1x + (-1)y = 2$"
        ],
        "result": "b = -1"
      },
      "timeSeconds": 60
    },
    {
      "id": "q2",
      "step": "01",
      "sub": "ب",
      "statement": "المعامل $b'$ :",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "rational",
      "answerFormat": "اكتب العدد $b'$ فقط (عدد صحيح)",
      "expectedAnswer": "-5",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "$b'$ هو معامل $y$ في المعادلة الثانية."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "المعامل يُقرأ مع إشارته."
        }
      ],
      "feedback": {
        "correct": "$b' = -5$ .",
        "incorrect": "المعامل يُقرأ مع إشارته."
      },
      "solution": {
        "lines": [
          "$2x - 5y = 4$ تُكتب $2x + (-5)y = 4$"
        ],
        "result": "b' = -5"
      },
      "timeSeconds": 60
    },
    {
      "id": "q3",
      "step": "02",
      "statement": "هل الثنائية $(4 ; 2)$ حل لهذه الجملة؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "نعم",
          "isCorrect": false,
          "misconceptionId": "MISC-JUMLA-MUADALA-WAHIDA"
        },
        {
          "id": "B",
          "content": "لا",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ $4$ و $y$ بـ $2$ في كل معادلة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الثنائية حل للجملة إذا حققت المعادلتين في آن واحد."
        }
      ],
      "feedback": {
        "correct": "$4 - 2 = 2$ ؛ $2 \\times 4 - 5 \\times 2 = -2 \\neq 4$ : الثنائية ليست حلا للجملة.",
        "incorrect": "العدد الأول في الثنائية قيمة $x$ والثاني قيمة $y$ ؛ عوّض في المعادلتين معا وقارن كل نتيجة بالطرف الثاني."
      },
      "solution": {
        "lines": [
          "نعوّض $x$ بـ $4$ و $y$ بـ $2$ :",
          "$4 - 2 = 2$",
          "$2 \\times 4 - 5 \\times 2 = -2 \\neq 4$",
          "ومنه الثنائية $(4 ; 2)$ ليست حلا للجملة (لا تحقق المعادلتين معا)."
        ]
      },
      "timeSeconds": 90
    }
