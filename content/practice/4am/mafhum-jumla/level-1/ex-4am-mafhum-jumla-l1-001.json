          "content": "نعم",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "لا",
          "isCorrect": false
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "في $(7 ; 0)$ : $x = 7$ و $y = 0$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "عوّض في الطرف الأول $x - 2y$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "قارن النتيجة بالعدد 7."
        }
      ],
      "feedback": {
        "correct": "$7 - 2 \\times 0 = 7$ : المساواة محقّقة.",
        "incorrect": "احسب $7 - 2 \\times 0$ ."
      }
    },
    {
      "id": "q2",
      "statement": "هل الثنائية $(0 ; 1)$ حل للمعادلة $x - 2y = 7$ ؟",
