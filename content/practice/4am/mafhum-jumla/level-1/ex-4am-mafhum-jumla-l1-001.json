  "statement": {
    "content": "من الكتاب (ص 60): نعتبر المعادلة من الدرجة الأولى بمجهولين $x - 2y = 7$ . نريد أن نعرف إن كانت كل ثنائية حلا لها."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "هل الثنائية $(7 ; 0)$ حل للمعادلة $x - 2y = 7$ ؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
