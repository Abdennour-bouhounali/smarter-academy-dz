  "statement": {
    "content": "نعتبر الجملة ذات المجهولين $a$ و $b$ التالية:",
    "formulas": [
      "\\begin{cases} 2a - b = 3 \\\\ a - 2b = -3 \\end{cases}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "هل الثنائية $(3 ; 3)$ حل لهذه الجملة؟",
