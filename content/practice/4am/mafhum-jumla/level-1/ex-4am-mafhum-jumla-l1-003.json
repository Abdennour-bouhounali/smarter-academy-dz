      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $a$ بـ $3$ و $b$ بـ $3$ في كل معادلة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الثنائية حل للجملة إذا حققت المعادلتين في آن واحد."
        }
      ],
      "feedback": {
        "correct": "$2 \\times 3 - 3 = 3$ ؛ $3 - 2 \\times 3 = -3$ : الثنائية حل للجملة.",
        "incorrect": "العدد الأول في الثنائية قيمة $a$ والثاني قيمة $b$ ؛ عوّض في المعادلتين معا وقارن كل نتيجة بالطرف الثاني."
      },
      "solution": {
        "lines": [
          "نعوّض $a$ بـ $3$ و $b$ بـ $3$ :",
          "$2 \\times 3 - 3 = 3$",
          "$3 - 2 \\times 3 = -3$",
          "ومنه الثنائية $(3 ; 3)$ حل للجملة."
        ]
      },
      "timeSeconds": 90
