        },
        {
          "id": "B",
          "content": "لا",
          "isCorrect": true
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x$ بـ $24$ و $y$ بـ $8$ في كل معادلة."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "الثنائية حل للجملة إذا حققت المعادلتين في آن واحد."
        }
      ],
      "feedback": {
        "correct": "$24 + 8 = 32$ ؛ $2 \\times 24 - 8 = 40 \\neq 7$ : الثنائية ليست حلا للجملة.",
        "incorrect": "العدد الأول في الثنائية قيمة $x$ والثاني قيمة $y$ ؛ عوّض في المعادلتين معا وقارن كل نتيجة بالطرف الثاني."
      },
      "solution": {
        "lines": [
          "نعوّض $x$ بـ $24$ و $y$ بـ $8$ :",
          "$24 + 8 = 32$",
          "$2 \\times 24 - 8 = 40 \\neq 7$",
          "ومنه الثنائية $(24 ; 8)$ ليست حلا للجملة (لا تحقق المعادلتين معا)."
        ]
      },
      "timeSeconds": 90
