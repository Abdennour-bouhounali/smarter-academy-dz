  "statement": {
    "content": "يعمل في مصلحة إدارية تخدم المواطنين بإخلاص 32 عاملا، $x$ رجلا و $y$ امرأة. أُحيل 5 رجال و 3 نساء على التقاعد ولم يُعوَّضوا، فأصبح عدد النساء بالمصلحة ضعف عدد الرجال. تُرجمت هذه الوضعية بالجملة:",
    "formulas": [
      "\\begin{cases} x + y = 32 \\\\ 2x - y = 7 \\end{cases}"
    ]
  },
  "questions": [
    {
      "id": "q1",
      "step": "01",
      "statement": "هل الثنائية $(24 ; 8)$ حل لهذه الجملة؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P3",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "apply",
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "نعم",
