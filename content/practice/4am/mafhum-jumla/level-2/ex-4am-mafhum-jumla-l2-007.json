      "step": "01",
      "statement": "بيّن أن $x$ و $y$ يحققان الجملة: $\\begin{cases} x + y = 37 \\\\ 20x + 10y = 610 \\end{cases}$",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P1",
          "role": "primary"
        }
      ],
      "cognitiveDemand": "reason",
      "answerType": "selfCheck",
      "answerFormat": "اكتب برهانك هنا، ثم اضغط «سجّل إجابتي» لتطّلع على الحل النموذجي.",
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "معلومة أولى عن عدد القطع، ومعلومة ثانية عن المبلغ."
