  "statement": {
    "content": "من الكتاب (ص 58): نعتبر الجملة $\\begin{cases} x - y = 2 \\\\ 2x - 5y = 4 \\end{cases}$ ."
  },
  "questions": [
    {
      "id": "q1",
      "statement": "هل الثنائية $(2 ; 0)$ حل للجملة؟",
      "learningPoints": [
        {
          "code": "4am_mafhum-jumla_P3",
          "role": "primary"
        }
      ],
      "answerType": "choice",
      "choices": [
        {
          "id": "A",
          "content": "نعم",
          "isCorrect": true
        },
        {
          "id": "B",
          "content": "لا",
          "isCorrect": false
        }
      ],
      "hints": [
        {
          "id": "h1",
          "type": "look",
          "content": "عوّض $x = 2$ و $y = 0$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "$2 - 0$ ثم $2 \\times 2 - 5 \\times 0$ ."
        },
        {
          "id": "h3",
          "type": "strategy",
          "content": "هل تجد 2 ثم 4؟"
        }
      ],
      "feedback": {
        "correct": "$2 - 0 = 2$ و $4 - 0 = 4$ : حل للجملة.",
        "incorrect": "عوّض في المعادلتين."
      }
    },
    {
