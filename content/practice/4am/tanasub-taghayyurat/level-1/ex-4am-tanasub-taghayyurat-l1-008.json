          "content": "احسب أولا الصورتين $f(9)$ و $f(2)$ ."
        },
        {
          "id": "h2",
          "type": "direction",
          "content": "اطرح الصورتين، ثم اقسم الفرق على $9 - 2$ ."
        }
      ],
      "feedback": {
        "correct": "$\\dfrac{-28}{7} = -4$ .",
        "incorrect": "لا تنسَ القسمة على $9 - 2$ بعد طرح الصورتين."
      },
      "solution": {
        "lines": [
          "$f(9) = -4 \\times 9 + 7 = -29$",
          "$f(2) = -4 \\times 2 + 7 = -1$",
