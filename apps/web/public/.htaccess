<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # UN seul hôte : www.smarter-academy.com → smarter-academy.com. Le lot appelle
  # l'API sur https://smarter-academy.com/api/v1, et l'API ne répond pas au CORS
  # de « www » : sur www, toute requête échouait (2026-10-20 : la fiche du livre
  # s'affichait, puis « هذا الكتاب غير موجود »).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteRule ^index\.html$ - [L]
  # Pages de partage des livres : vite-plugin-share-pages.js remplace la ligne
  # suivante, dans dist/.htaccess, par UNE règle explicite par page
  # (`^books/smart-protocol/?$ → share/books/smart-protocol.html`). Les fichiers
  # vivent sous share/ : AUCUN dossier ne porte le chemin public — LiteSpeed
  # (Hostinger) redirige tout dossier existant vers « …/ » AVANT ces règles, et
  # ignore DirectorySlash (constaté le 2026-10-17 : un 301 avant tout affichage).
  # @share-pages
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteRule . /index.html [L]
</IfModule>

# The app shell is never cached without revalidation: it names the hashed
# assets of the CURRENT build, so a deploy must reach visitors on their next
# visit. (The hashed files themselves are cached for a year: assets/.htaccess.)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
