APP_NAME="Smarter Academy DZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrateur initial (php artisan db:seed --class=AdminUserSeeder).
# Le seeder est idempotent et ne repose le mot de passe QU'À LA CRÉATION :
# un mot de passe changé depuis /admin/account n'est jamais réécrit.
# Ne committez pas de vraie valeur ici — surchargez-les dans .env.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# Fournisseur de paiement. Secrets d'ENVIRONNEMENT uniquement — jamais en base,
# jamais dans une reponse d'API, jamais dans un journal. Absents, tous les
# webhooks sont refuses (le defaut ferme).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Offres achetables. La cle INTERNE ('annual') vit dans config/billing.php ;
# seul l'identifiant de tarif Stripe est ici, car il differe entre test et
# production. Le navigateur n'envoie jamais qu'une cle interne.
STRIPE_PRICE_ANNUAL=
# 'test' | 'live'. Encaisser pour de vrai doit etre une decision explicite.
BILLING_MODE=test
BILLING_PROVIDER=stripe
# Ou le fournisseur renvoie l'eleve. Ces pages ne prouvent AUCUN paiement.
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────
# Où vit le navigateur de l'élève. Toute redirection vers le site part d'ici
# (vérification d'e-mail, retour de Google) : une URL fournie par le client
# ferait de ces routes une redirection ouverte.
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# Documents légaux
# ─────────────────────────────────────────────────────────────────────────
# La version ACCEPTÉE est écrite par le serveur d'après ces valeurs — jamais
# d'après ce que le navigateur annonce. Toute modification de fond des pages
# /cgu ou /confidentialite doit s'accompagner d'une nouvelle date ici, sans
# quoi on change ce que les élèves sont réputés avoir accepté.
LEGAL_TERMS_VERSION=2026-09-12
LEGAL_PRIVACY_VERSION=2026-09-12

# ─────────────────────────────────────────────────────────────────────────
# Google — « Continuer avec Google »
# ─────────────────────────────────────────────────────────────────────────
# STRICTEMENT côté serveur. Il ne doit exister AUCUNE variable VITE_GOOGLE_*
# correspondante : le secret ne doit jamais atteindre le navigateur.
#
# GOOGLE_REDIRECT_URI doit correspondre EXACTEMENT à l'URI autorisée dans la
# console Google (schéma, hôte, port, chemin), sinon Google refuse l'échange.
# En production : https://smarter-academy.fr/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Les origines autorisées à appeler l'API (séparées par des virgules).
# En production : le domaine algérien, et lui seul. Ne JAMAIS y remettre un
# domaine français — les deux produits sont indépendants (master spec §2).
# Défaut local : les ports Vite (5173 dev, 4173 aperçu de production / QA).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
