{
  "name": "smarter-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:all": "concurrently \"npm run dev\" \"cd apps/api && php artisan serve --port=8000\"",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "test": "npm run test --workspace=packages/core && npm run test --workspace=apps/web && npm run test:scripts",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "validate:exercises": "node scripts/validate-exercises.mjs",
    "validate:thinking-lab": "node scripts/validate-thinking-lab.mjs",
    "build:thinking-lab-index": "node scripts/build-thinking-lab-index.mjs",
    "audit:knowledge": "node scripts/audit-knowledge-dependencies.mjs --report",
    "audit:knowledge:gate": "node scripts/audit-knowledge-dependencies.mjs --gate",
    "audit:predict": "node scripts/audit-predict-prompts.mjs",
    "check:katex": "node scripts/check-katex.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:lesson-index": "node scripts/generate-lesson-index.mjs --check",
    "generate:lesson-index": "node scripts/generate-lesson-index.mjs",
    "check:entry-budget": "node scripts/analyze-entry-bundle.mjs --budget 245",
    "check:non-blocking": "node scripts/check-non-blocking.mjs",
    "check:dormant-isolation": "node scripts/check-dormant-isolation.mjs",
    "audit:collisions": "node scripts/audit-svg-collisions.mjs",
    "check:lessons": "npm run validate:lessons -- --strict && node scripts/audit-predict-prompts.mjs --strict && npm run validate:exercises -- --strict && npm run validate:thinking-lab -- --strict && npm run audit:knowledge:gate && npm run check:katex && npm run check:lesson-index && npm run check:routes && npm run check:non-blocking && npm run check:dormant-isolation && npm run check:textbook && npm run check:activation-drift && npm run check:learning-net && npm run check:year-calendar && npm run check:compass-index && npm run check:entry-budget",
    "test:scripts": "vitest run --dir scripts",
    "check:activation-drift": "node scripts/check-activation-drift.mjs",
    "check:learning-net": "node scripts/generate-learning-net-map.mjs --check && node scripts/learning-net-queue.mjs --check",
    "generate:learning-net": "node scripts/generate-learning-net-map.mjs && node scripts/learning-net-queue.mjs",
    "check:textbook": "node scripts/check-textbook-coverage.mjs",
    "check:year-calendar": "node scripts/check-year-calendar.mjs",
    "generate:compass-index": "node scripts/generate-compass-index.mjs",
    "check:compass-index": "node scripts/generate-compass-index.mjs --check",
    "check:explorer-levels": "node scripts/games/build-explorer-levels.mjs --check"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.28.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4",
    "vitest": "^4.1.10"
  }
}
